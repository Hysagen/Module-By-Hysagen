                TweenService:Create(ToggleBindBtn, TweenInfo.new(0.2), {BackgroundColor3 = color}):Play()
                ToggleBindBtn.Text = BindEnabled and "ON" or "OFF"
            end
            
            local toggleBindClick = ToggleBindBtn.MouseButton1Click:Connect(function()
                playSound("9120337183")
                SetBindEnabled(not BindEnabled)
            end)
            table.insert(Library.Connections, toggleBindClick)
            
            local bindClick = BindBtn.MouseButton1Click:Connect(function()
                Binding = true
                playSound("9120332383")
                BindBtn.Text = "..."
                TweenService:Create(BindBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 80, 80)}):Play()
                
                local conn
                conn = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        Binding = false
                        CurrentKey = input.KeyCode
                        BindBtn.Text = CurrentKey.Name
                        TweenService:Create(BindBtn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.Accent}):Play()
                        if conn then conn:Disconnect() end
                        UI_Module:Notify("Keybind Set", text .. " → " .. CurrentKey.Name, "success", 1.5)
                    end
                end)
                table.insert(Library.Connections, conn)
                
                task.wait(5)
                if Binding then
                    Binding = false
                    BindBtn.Text = CurrentKey.Name
                    TweenService:Create(BindBtn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.Accent}):Play()
                    if conn then conn:Disconnect() end
                end
            end)
            table.insert(Library.Connections, bindClick)
            
            local bindGlobal = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if Binding then return end
                if not BindEnabled then return end
                if UserInputService:GetFocusedTextBox() then return end
                if input.KeyCode == CurrentKey then 
                    if callback then callback() end
                end
            end)
            table.insert(Library.Connections, bindGlobal)
            
            table.insert(self.Elements, Row)
            return Row
        end
        
