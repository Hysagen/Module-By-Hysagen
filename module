-- Вспомогательные функции для UI
local function CreateShadow(properties)
    local shadow = Instance.new("ImageLabel")
    shadow.Image = "rbxassetid://1316043044"
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.5
    shadow.BackgroundTransparency = 1
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(5, 5, 5, 5)
    shadow.Size = UDim2.fromScale(1, 1)
    shadow.Position = UDim2.fromOffset(5, 5)
    return shadow
end

local function ApplyTheme(gui, theme)
    local themeData = Themes[theme]
    if not themeData then return end
    
    for _, element in pairs(gui:GetDescendants()) do
        if element:IsA("Frame") or element:IsA("ScrollingFrame") then
            if element.Name == "MainFrame" or element.Name == "TabFrame" then
                element.BackgroundColor3 = themeData.Background
            elseif element.Name == "TabButton" then
                element.BackgroundColor3 = themeData.BackgroundSecondary
                element.TextColor3 = themeData.TextSecondary
            elseif element.Name == "TabButtonActive" then
                element.BackgroundColor3 = themeData.Accent
                element.TextColor3 = themeData.Text
            elseif element.Name == "Button" then
                element.BackgroundColor3 = themeData.Accent
                element.TextColor3 = themeData.Text
            elseif element.Name == "ButtonHover" then
                element.BackgroundColor3 = themeData.AccentHover
            elseif element.Name == "Slider" or element.Name == "SliderBackground" then
                element.BackgroundColor3 = themeData.BackgroundTertiary
            elseif element.Name == "SliderFill" then
                element.BackgroundColor3 = themeData.Accent
            elseif element.Name == "Dropdown" then
                element.BackgroundColor3 = themeData.BackgroundSecondary
                element.TextColor3 = themeData.Text
            elseif element.Name == "DropdownItem" then
                element.BackgroundColor3 = themeData.BackgroundSecondary
                element.TextColor3 = themeData.TextSecondary
            elseif element.Name == "DropdownItemSelected" then
                element.BackgroundColor3 = themeData.Accent
                element.TextColor3 = themeData.Text
            elseif element.Name == "SettingsPanel" then
                element.BackgroundColor3 = themeData.BackgroundSecondary
            elseif element.Name == "Title" or element.Name == "TabTitle" then
                element.TextColor3 = themeData.Text
            elseif element.Name == "Label" then
                element.TextColor3 = themeData.TextSecondary
            elseif element.Name == "ValueLabel" then
                element.TextColor3 = themeData.Text
            elseif element.Name == "ToggleButton" then
                element.BackgroundColor3 = themeData.BackgroundTertiary
                element.TextColor3 = themeData.Text
            elseif element.Name == "ToggleActive" then
                element.BackgroundColor3 = themeData.Accent
                element.TextColor3 = themeData.Text
            elseif element.Name == "ScrollBar" then
                element.BackgroundColor3 = themeData.Accent
            end
        elseif element:IsA("TextLabel") and element.Name ~= "Title" and element.Name ~= "TabTitle" and element.Name ~= "Label" and element.Name ~= "ValueLabel" then
            element.TextColor3 = themeData.Text
        elseif element:IsA("ImageButton") then
            if element.Name == "CloseButton" then
                element.ImageColor3 = themeData.Text
            end
        end
    end
end

-- Создание главного GUI
function ModernUI:CreateUI(title, scale)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ModernUI"
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ResetOnSpawn = false
    
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.BackgroundColor3 = Themes.Dark.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui
    MainFrame.Visible = false
    
    local scaleRatio = scale or Vector2.new(3, 4)
    local aspectRatio = scaleRatio.X / scaleRatio.Y
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local sizeX = math.min(viewportSize.X * 0.75, 800)
    local sizeY = sizeX / aspectRatio
    local maxSizeY = viewportSize.Y * 0.8
    
    if sizeY > maxSizeY then
        sizeY = maxSizeY
        sizeX = sizeY * aspectRatio
    end
    
    MainFrame.Size = UDim2.new(0, sizeX, 0, sizeY)
    MainFrame.Position = UDim2.new(0.5, -sizeX/2, 0.5, -sizeY/2)
    
    local Shadow = CreateShadow()
