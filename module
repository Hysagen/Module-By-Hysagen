-- Функция для создания вкладки
function ModernUI:CreateTab(name, id)
    local tabId = id or name:lower():gsub("%s+", "_")
    
    local TabButton = Instance.new("TextButton")
    TabButton.Name = "TabButton"
    TabButton.Size = UDim2.new(1, -10, 0, 35)
    TabButton.Position = UDim2.new(0, 5, 0, #UIStore.Tabs * 40 + 5)
    TabButton.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    TabButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    TabButton.Text = name
    TabButton.TextSize = 14
    TabButton.Font = Enum.Font.Gotham
    TabButton.BorderSizePixel = 0
    TabButton.Parent = UIStore.TabContainer
    TabButton.AutoButtonColor = false
    
    TabButton.MouseEnter:Connect(function()
        if TabButton.Name ~= "TabButtonActive" then
            TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
        end
    end)
    
    TabButton.MouseLeave:Connect(function()
        if TabButton.Name ~= "TabButtonActive" then
            TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 45)}):Play()
        end
    end)
    
    local TabContent = Instance.new("ScrollingFrame")
    TabContent.Name = "TabContent_" .. tabId
    TabContent.Size = UDim2.new(1, -20, 1, -10)
    TabContent.Position = UDim2.new(0, 10, 0, 5)
    TabContent.BackgroundTransparency = 1
    TabContent.BorderSizePixel = 0
    TabContent.ScrollBarThickness = 3
    TabContent.ScrollBarImageColor3 = Color3.fromRGB(64, 128, 255)
    TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabContent.Parent = UIStore.ContentContainer
    TabContent.Visible = false
    
    local function updateCanvas()
        local maxY = 0
        for _, child in pairs(TabContent:GetChildren()) do
            if child:IsA("GuiObject") then
                local posY = child.Position.Y.Offset + child.Size.Y.Offset + 10
                if posY > maxY then
                    maxY = posY
                end
            end
        end
        TabContent.CanvasSize = UDim2.new(0, 0, 0, maxY + 10)
    end
    
    TabContent:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateCanvas)
    
    local tabData = {
        Id = tabId,
        Name = name,
        Button = TabButton,
        Content = TabContent,
        Elements = {},
        UpdateCanvas = updateCanvas
    }
    
    table.insert(UIStore.Tabs, tabData)
    
    local totalHeight = #UIStore.Tabs * 40 + 15
    UIStore.TabContainer.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
    
    if #UIStore.Tabs == 1 then
        self:SelectTab(tabId)
    end
    
    return tabId
end

-- Функция для выбора вкладки
function ModernUI:SelectTab(tabId)
    for _, tab in pairs(UIStore.Tabs) do
        if tab.Id == tabId then
            tab.Button.Name = "TabButtonActive"
            tab.Button.BackgroundColor3 = Themes[UIStore.Settings.Theme].Accent
            tab.Button.TextColor3 = Themes[UIStore.Settings.Theme].Text
            tab.Content.Visible = true
            UIStore.CurrentTab = tabId
        else
            tab.Button.Name = "TabButton"
            tab.Button.BackgroundColor3 = Themes[UIStore.Settings.Theme].BackgroundSecondary
            tab.Button.TextColor3 = Themes[UIStore.Settings.Theme].TextSecondary
            tab.Content.Visible = false
        end
    end
end

-- Функция для добавления кнопки с биндом
function ModernUI:AddToggleWithBind(tabId, name, defaultValue, bindKey, callback)
    local tab = self:FindTab(tabId)
    if not tab then return end
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -20, 0, 60)
    container.Position = UDim2.new(0, 0, 0, self:GetNextPosition(tab))
    container.BackgroundTransparency = 1
    container.Parent = tab.Content
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 16
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.Parent = container
    
    local toggle = Instance.new("TextButton")
    toggle.Name = "ToggleButton"
    toggle.Size = UDim2.new(0, 100, 0, 35)
    toggle.Position = UDim2.new(1, -110, 0.5, -17.5)
    toggle.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggle.Text = "ВЫКЛ"
    toggle.TextSize = 12
    toggle.Font = Enum.Font.GothamBold
    toggle.BorderSizePixel = 0
    toggle.Parent = container
    
    local bindLabel = Instance.new("TextLabel")
    bindLabel.Size = UDim2.new(0, 80, 0, 25)
    bindLabel.Position = UDim2.new(1, -200, 0.5, -12.5)
    bindLabel.BackgroundTransparency = 1
    bindLabel.Text = tostring(bindKey or "None")
    bindLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    bindLabel.TextSize = 12
    bindLabel.TextXAlignment = Enum.TextXAlignment.Right
    bindLabel.Font = Enum.Font.Gotham
    bindLabel.Parent = container
    
    local state = defaultValue or false
    local key = bindKey or Enum.KeyCode.LeftControl
    
    local function updateState(newState)
        state = newState
        if state then
            toggle.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
            toggle.Text = "ВКЛ"
        else
            toggle.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            toggle.Text = "ВЫКЛ"
        end
        if callback then callback(state) end
    end
    
    updateState(state)
    
    toggle.MouseButton1Click:Connect(function()
        updateState(not state)
    end)
    
    local bindConnection
    if key then
        bindConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.KeyCode == key and input.UserInputType == Enum.UserInputType.Keyboard then
                updateState(not state)
            end
        end)
    end
    
    table.insert(tab.Elements, {
        Type = "ToggleWithBind",
        Name = name,
        State = state,
        Toggle = toggle,
        BindConnection = bindConnection,
        Update = updateState,
        GetState = function() return state end
    })
    
    tab.UpdateCanvas()
    return {
        SetState = updateState,
        GetState = function() return state end,
        SetBind = function(newKey)
            if bindConnection then bindConnection:Disconnect() end
            key = newKey
            bindLabel.Text = tostring(key)
            bindConnection = UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if input.KeyCode == key and input.UserInputType == Enum.UserInputType.Keyboard then
                    updateState(not state)
                end
            end)
        end
    }
end

