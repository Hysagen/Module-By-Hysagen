    -- === 3) ПОЛЗУНОК ===
    function UIFramework:CreateSlider(page, label, min, max, default, decimals)
        decimals = decimals or 0
        local container = createElementContainer(page)
        container.Size = UDim2.new(1, 0, 0, 50)
        
        local sliderFrame = Instance.new("Frame")
        sliderFrame.Size = UDim2.new(1, -16, 0, 42)
        sliderFrame.Position = UDim2.new(0, 8, 0, 4)
        sliderFrame.BackgroundColor3 = COLORS.TabInactive
        sliderFrame.BackgroundTransparency = 0
        sliderFrame.BorderSizePixel = 0
        sliderFrame.Parent = container
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = sliderFrame
        
        local labelText = Instance.new("TextLabel")
        labelText.Size = UDim2.new(0.5, 0, 0, 20)
        labelText.Position = UDim2.new(0, 8, 0, 2)
        labelText.BackgroundTransparency = 1
        labelText.Text = label
        labelText.TextColor3 = COLORS.Text
        labelText.TextSize = 13
        labelText.TextXAlignment = Enum.TextXAlignment.Left
        labelText.Font = Enum.Font.GothamSemibold
        labelText.Parent = sliderFrame
        
        local valueLabel = Instance.new("TextLabel")
        valueLabel.Size = UDim2.new(0.3, 0, 0, 20)
        valueLabel.Position = UDim2.new(0.7, 0, 0, 2)
        valueLabel.BackgroundTransparency = 1
        valueLabel.Text = tostring(default or min)
        valueLabel.TextColor3 = COLORS.Accent
        valueLabel.TextSize = 13
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.Font = Enum.Font.GothamBold
        valueLabel.Parent = sliderFrame
        
        local slider = Instance.new("Frame")
        slider.Size = UDim2.new(0.9, 0, 0, 4)
        slider.Position = UDim2.new(0.05, 0, 1, -10)
        slider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        slider.BackgroundTransparency = 0
        slider.BorderSizePixel = 0
        slider.Parent = sliderFrame
        
        local sliderCorner = Instance.new("UICorner")
        sliderCorner.CornerRadius = UDim.new(0, 2)
        sliderCorner.Parent = slider
        
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0.5, 0, 1, 0)
        fill.BackgroundColor3 = COLORS.Accent
        fill.BackgroundTransparency = 0
        fill.BorderSizePixel = 0
        fill.Parent = slider
        
        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 2)
        fillCorner.Parent = fill
        
        local value = default or min
        local function updateSlider(newValue)
            value = math.clamp(newValue, min, max)
            if decimals == 0 then
                value = math.round(value)
            end
            local percentage = (value - min) / (max - min)
            fill.Size = UDim2.new(percentage, 0, 1, 0)
            valueLabel.Text = tostring(value)
        end
        
        updateSlider(value)
        
        local dragging = false
        slider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                local percentage = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
                local newValue = min + (max - min) * percentage
                updateSlider(newValue)
            end
        end)
        
        game:GetService("UserInputService").InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local percentage = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
                local newValue = min + (max - min) * percentage
                updateSlider(newValue)
            end
        end)
        
        game:GetService("UserInputService").InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        return {
            SetValue = updateSlider,
            GetValue = function() return value end
        }
    end
    
    -- === 4) КНОПКА-СПИСОК ===
    function UIFramework:CreateDropdown(page, label, options, defaultOption, multiSelect)
        local container = createElementContainer(page)
        container.Size = UDim2.new(1, 0, 0, 50)
        
        local dropdownFrame = Instance.new("Frame")
        dropdownFrame.Size = UDim2.new(1, -16, 0, 42)
        dropdownFrame.Position = UDim2.new(0, 8, 0, 4)
        dropdownFrame.BackgroundColor3 = COLORS.TabInactive
        dropdownFrame.BackgroundTransparency = 0
        dropdownFrame.BorderSizePixel = 0
        dropdownFrame.Parent = container
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = dropdownFrame
        
        local labelText = Instance.new("TextLabel")
        labelText.Size = UDim2.new(0.4, 0, 0, 20)
        labelText.Position = UDim2.new(0, 8, 0, 2)
        labelText.BackgroundTransparency = 1
        labelText.Text = label
        labelText.TextColor3 = COLORS.Text
        labelText.TextSize = 13
        labelText.TextXAlignment = Enum.TextXAlignment.Left
        labelText.Font = Enum.Font.GothamSemibold
        labelText.Parent = dropdownFrame
        
        local selectedText = Instance.new("TextLabel")
        selectedText.Size = UDim2.new(0.4, 0, 0, 20)
        selectedText.Position = UDim2.new(0.55, 0, 0, 2)
        selectedText.BackgroundTransparency = 1
        selectedText.Text = defaultOption or "Выберите..."
        selectedText.TextColor3 = COLORS.Accent
        selectedText.TextSize = 13
        selectedText.TextXAlignment = Enum.TextXAlignment.Right
        selectedText.Font = Enum.Font.GothamBold
        selectedText.Parent = dropdownFrame
        
        local arrow = Instance.new("TextButton")
        arrow.Size = UDim2.new(0, 30, 0, 30)
        arrow.Position = UDim2.new(1, -36, 0.5, -15)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▼"
        arrow.TextColor3 = COLORS.TextDim
        arrow.TextSize = 14
        arrow.Font = Enum.Font.GothamBold
        arrow.Parent = dropdownFrame
        
        local dropdownList = Instance.new("Frame")
        dropdownList.Size = UDim2.new(1, 0, 0, 0)
        dropdownList.Position = UDim2.new(0, 0, 0, 42)
        dropdownList.BackgroundColor3 = COLORS.TabInactive
        dropdownList.BackgroundTransparency = 0
        dropdownList.BorderSizePixel = 0
        dropdownList.Visible = false
        dropdownList.Parent = dropdownFrame
        
        local listCorner = Instance.new("UICorner")
        listCorner.CornerRadius = UDim.new(0, 4)
        listCorner.Parent = dropdownList
        
        local listLayout = Instance.new("UIListLayout")
        listLayout.Padding = UDim.new(0, 2)
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Parent = dropdownList
        
        local selected = multiSelect and {} or defaultOption
        local dropdownItems = {}
        local isOpen = false
        
        local function updateListSize()
            local count = #dropdownItems
            dropdownList.Size = UDim2.new(1, 0, 0, count * 30 + 4)
            dropdownFrame.Size = UDim2.new(1, -16, 0, 42 + (isOpen and (count * 30 + 4) or 0))
            container.Size = UDim2.new(1, 0, 0, 50 + (isOpen and (count * 30 + 4) or 0))
        end
        
        local function updateSelectedText()
            if multiSelect then
                local count = 0
                for _, val in pairs(selected) do
                    if val then count = count + 1 end
                end
                selectedText.Text = count > 0 and ("Выбрано: " .. count) or "Ничего не выбрано"
            else
                selectedText.Text = selected or "Выберите..."
            end
        end
        
        for _, option in ipairs(options) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -8, 0, 28)
            btn.Position = UDim2.new(0, 4, 0, 0)
            btn.BackgroundColor3 = COLORS.TabInactive
            btn.BackgroundTransparency = 0
            btn.BorderSizePixel = 0
            btn.Text = option
            btn.TextColor3 = COLORS.Text
            btn.TextSize = 13
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.GothamSemibold
            btn.Parent = dropdownList
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 3)
            btnCorner.Parent = btn
            
            local checkMark = Instance.new("TextLabel")
            checkMark.Size = UDim2.new(0, 20, 1, 0)
            checkMark.Position = UDim2.new(1, -24, 0, 0)
            checkMark.BackgroundTransparency = 1
            checkMark.Text = "✓"
            checkMark.TextColor3 = COLORS.Accent
            checkMark.TextSize = 14
            checkMark.TextXAlignment = Enum.TextXAlignment.Center
            checkMark.Font = Enum.Font.GothamBold
            checkMark.Visible = false
            checkMark.Parent = btn
            
            dropdownItems[option] = btn
            
            btn.MouseButton1Click:Connect(function()
                if multiSelect then
                    selected[option] = not selected[option]
                    checkMark.Visible = selected[option]
                    updateSelectedText()
                else
                    selected = option
                    for opt, item in pairs(dropdownItems) do
                        item.BackgroundColor3 = COLORS.TabInactive
                        item.TextColor3 = COLORS.Text
                    end
                    btn.BackgroundColor3 = COLORS.Accent
                    btn.TextColor3 = COLORS.Text
                    updateSelectedText()
                    isOpen = false
                    dropdownList.Visible = false
                    arrow.Text = "▼"
                    updateListSize()
                end
            end)
        end
        
        if not multiSelect then
            for opt, item in pairs(dropdownItems) do
                if opt == defaultOption then
                    item.BackgroundColor3 = COLORS.Accent
                    item.TextColor3 = COLORS.Text
                end
            end
        end
        
        arrow.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            dropdownList.Visible = isOpen
            arrow.Text = isOpen and "▲" or "▼"
            updateListSize()
        end)
        
        updateSelectedText()
        updateListSize()
        
        return {
            GetSelected = function()
                if multiSelect then
                    local result = {}
                    for opt, val in pairs(selected) do
                        if val then table.insert(result, opt) end
                    end
                    return result
                else
                    return selected
                end
            end,
            SetSelected = function(newValue)
                if multiSelect then
                    selected = {}
                    for _, opt in ipairs(newValue) do
                        selected[opt] = true
                    end
                    for opt, item in pairs(dropdownItems) do
                        item.BackgroundColor3 = COLORS.TabInactive
                        item.TextColor3 = COLORS.Text
                    end
                    for opt, item in pairs(dropdownItems) do
                        if selected[opt] then
                            item.BackgroundColor3 = COLORS.Accent
                            item.TextColor3 = COLORS.Text
                        end
                    end
                    updateSelectedText()
                else
                    selected = newValue
                    for opt, item in pairs(dropdownItems) do
                        item.BackgroundColor3 = COLORS.TabInactive
                        item.TextColor3 = COLORS.Text
                    end
                    if dropdownItems[newValue] then
                        dropdownItems[newValue].BackgroundColor3 = COLORS.Accent
                        dropdownItems[newValue].TextColor3 = COLORS.Text
                    end
                    updateSelectedText()
                end
            end
        }
    end
    
    -- === СТРАНИЦЫ ===
    function UIFramework:CreatePage(name)
        local pageFrame = Instance.new("Frame")
        pageFrame.Name = name
        pageFrame.Size = UDim2.new(1, 0, 1, 0)
        pageFrame.BackgroundTransparency = 1
        pageFrame.Visible = false
        pageFrame.Parent = pagesContainer
        
        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 4)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = pageFrame
        
        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = name .. "Tab"
        tabBtn.Size = UDim2.new(0, 140, 0, 36)
        tabBtn.BackgroundColor3 = COLORS.TabInactive
        tabBtn.BackgroundTransparency = 0
        tabBtn.BorderSizePixel = 0
        tabBtn.Text = name
        tabBtn.TextColor3 = COLORS.TextDim
        tabBtn.TextSize = 14
        tabBtn.TextXAlignment = Enum.TextXAlignment.Center
        tabBtn.TextYAlignment = Enum.TextYAlignment.Center
        tabBtn.TextTruncate = Enum.TextTruncate.AtEnd
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.Parent = leftScrolling
        
        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 4)
        tabCorner.Parent = tabBtn
        
        leftScrolling.CanvasSize = UDim2.new(0, 0, 0, leftScrolling.CanvasSize.Y.Offset + 40)
        
        tabBtn.MouseButton1Click:Connect(function()
            UIFramework:SwitchPage(name)
        end)
        
        pages[name] = {
            Frame = pageFrame,
            Button = tabBtn,
            Layout = pageLayout
        }
        
        if not activePage then
            UIFramework:SwitchPage(name)
        end
        
        return pageFrame, pageLayout
    end
    
    function UIFramework:SwitchPage(name)
        if not pages[name] then return end
        
        for _, data in pairs(pages) do
            data.Frame.Visible = false
            data.Button.BackgroundColor3 = COLORS.TabInactive
            data.Button.TextColor3 = COLORS.TextDim
        end
        
        pages[name].Frame.Visible = true
        pages[name].Button.BackgroundColor3 = COLORS.TabActive
        pages[name].Button.TextColor3 = COLORS.Text
        activePage = name
    end
    
    -- Перетаскивание
    local dragging = false
    local dragStart, startPos
    
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    
    topBar.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    topBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return {
        MainFrame = mainFrame,
        TopBar = topBar,
        LeftPanel = leftScrolling,
        RightPanel = rightPanel,
        PagesContainer = pagesContainer,
        CreatePage = UIFramework.CreatePage,
        SwitchPage = UIFramework.SwitchPage,
        Pages = pages,
        ScreenGui = screenGui,
        CreateToggleWithBind = UIFramework.CreateToggleWithBind,
        CreateToggle = UIFramework.CreateToggle,
        CreateSlider = UIFramework.CreateSlider,
        CreateDropdown = UIFramework.CreateDropdown
    }
end

function UIFramework.New(title)
    return createMainFrame(title or "UI Framework")
end

return UIFramework
