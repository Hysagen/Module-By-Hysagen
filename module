--[[
    UI Module for Roblox Scripts
    Load with: local UI = loadstring(game:HttpGet("..."))()
    Usage:
        local ui = UI.New({
            title = "My UI",
            aspectRatio = 3/4,  -- width/height
            bindKey = "RightShift",
            theme = "Dark",    -- or table of colors
            tabs = {"Main", "Settings"}  -- optional
        })
        local main = ui:AddTab("Main")
        main:AddToggle("Auto Farm", "F", false)
        main:AddSlider("Speed", 1, 100, 50)
        main:AddDropdown("Mode", {"Easy","Hard"}, false, "Easy")
        main:AddButton("Click Me", function() print("Clicked") end)
        -- Settings tab is auto-added with theme & bind key changer
        -- To save theme: local theme = ui:GetTheme() then save it, and pass on next init
--]]

return function()
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local GuiService = game:GetService("GuiService")
    local HttpService = game:GetService("HttpService") -- for serialization

    local UIManager = {}
    UIManager.__index = UIManager

    -- Predefined themes
    local Themes = {
        Dark = {
            Background = Color3.fromRGB(30, 30, 36),
            BackgroundSecondary = Color3.fromRGB(45, 45, 52),
            Foreground = Color3.fromRGB(60, 60, 70),
            Text = Color3.fromRGB(220, 220, 230),
            TextDim = Color3.fromRGB(160, 160, 170),
            Accent = Color3.fromRGB(0, 120, 255),
            AccentHover = Color3.fromRGB(0, 100, 220),
            AccentPressed = Color3.fromRGB(0, 80, 190),
            ToggleOn = Color3.fromRGB(0, 200, 100),
            ToggleOff = Color3.fromRGB(200, 60, 60),
            Border = Color3.fromRGB(70, 70, 80),
            Dropdown = Color3.fromRGB(40, 40, 48),
            Shadow = Color3.fromRGB(0, 0, 0)
        },
        Light = {
            Background = Color3.fromRGB(240, 240, 245),
            BackgroundSecondary = Color3.fromRGB(220, 220, 230),
            Foreground = Color3.fromRGB(200, 200, 210),
            Text = Color3.fromRGB(30, 30, 40),
            TextDim = Color3.fromRGB(80, 80, 90),
            Accent = Color3.fromRGB(0, 120, 255),
            AccentHover = Color3.fromRGB(0, 100, 220),
            AccentPressed = Color3.fromRGB(0, 80, 190),
            ToggleOn = Color3.fromRGB(0, 200, 100),
            ToggleOff = Color3.fromRGB(200, 60, 60),
            Border = Color3.fromRGB(180, 180, 190),
            Dropdown = Color3.fromRGB(210, 210, 220),
            Shadow = Color3.fromRGB(0, 0, 0)
        },
        Blue = {
            Background = Color3.fromRGB(20, 30, 50),
            BackgroundSecondary = Color3.fromRGB(30, 45, 70),
            Foreground = Color3.fromRGB(40, 60, 90),
            Text = Color3.fromRGB(220, 230, 250),
            TextDim = Color3.fromRGB(160, 180, 210),
            Accent = Color3.fromRGB(60, 140, 255),
            AccentHover = Color3.fromRGB(40, 120, 235),
            AccentPressed = Color3.fromRGB(20, 100, 215),
            ToggleOn = Color3.fromRGB(0, 220, 120),
            ToggleOff = Color3.fromRGB(220, 80, 80),
            Border = Color3.fromRGB(50, 70, 100),
            Dropdown = Color3.fromRGB(30, 50, 80),
            Shadow = Color3.fromRGB(0, 0, 0)
        },
        Purple = {
            Background = Color3.fromRGB(30, 20, 40),
            BackgroundSecondary = Color3.fromRGB(50, 35, 65),
            Foreground = Color3.fromRGB(70, 50, 90),
            Text = Color3.fromRGB(230, 210, 250),
            TextDim = Color3.fromRGB(180, 160, 210),
            Accent = Color3.fromRGB(170, 100, 255),
            AccentHover = Color3.fromRGB(150, 80, 235),
            AccentPressed = Color3.fromRGB(130, 60, 215),
            ToggleOn = Color3.fromRGB(0, 220, 120),
            ToggleOff = Color3.fromRGB(220, 80, 80),
            Border = Color3.fromRGB(70, 50, 90),
            Dropdown = Color3.fromRGB(50, 35, 65),
            Shadow = Color3.fromRGB(0, 0, 0)
        }
    }

    -- Helper to deep copy table
    local function deepCopy(original)
        local copy = {}
        for k, v in pairs(original) do
            if type(v) == "table" then
                copy[k] = deepCopy(v)
            else
                copy[k] = v
            end
        end
        return copy
    end

    -- Merge tables
    local function merge(t1, t2)
        local result = deepCopy(t1)
        for k, v in pairs(t2) do
            result[k] = v
        end
        return result
    end

    -- Create a new UI instance
    function UIManager.New(config)
        config = config or {}
        local self = setmetatable({}, UIManager)

        self.config = {
            title = config.title or "UI",
            aspectRatio = config.aspectRatio or 3/4,
            bindKey = config.bindKey or "RightShift",
            theme = config.theme or "Dark",
            savedTheme = nil, -- will be set if theme is table
        }

        -- If theme is a table, use it directly; else get from preset
        if type(self.config.theme) == "table" then
            self.theme = deepCopy(self.config.theme)
            self.config.savedTheme = deepCopy(self.config.theme) -- store for saving
        else
            local preset = Themes[self.config.theme] or Themes.Dark
            self.theme = deepCopy(preset)
            self.config.savedTheme = deepCopy(preset)
        end

        self.tabs = {}          -- tab name -> tab object
        self.tabOrder = {}      -- list of tab names
        self.elements = {}      -- all elements for theme update
        self.activeTab = nil
        self.visible = false
        self.bindKey = self.config.bindKey

        -- Create GUI
        self:createGui()
        self:applyTheme()

        -- Add default Settings tab (if not already added)
        -- We'll add it later after creating tabs, but we can just create it when needed.
        -- We'll add it automatically when the user first calls AddTab? Better to add it manually.
        -- But we'll add it in the New, unless user already added "Settings"
        -- We'll check if "Settings" exists, if not we add it.

        -- Bind key listener
        self:setupInput()

        return self
    end

    function UIManager:createGui()
        local player = Players.LocalPlayer
        if not player then
            warn("UI: No LocalPlayer found")
            return
        end
        local playerGui = player:FindFirstChild("PlayerGui") or Instance.new("PlayerGui", player)

        -- Main ScreenGui
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "UIManager_Gui"
        screenGui.Parent = playerGui
        screenGui.ResetOnSpawn = false
        self.screenGui = screenGui

        -- Main Frame (the window)
        local mainFrame = Instance.new("Frame")
        mainFrame.Name = "MainFrame"
        mainFrame.Parent = screenGui
        mainFrame.BackgroundTransparency = 0.1
        mainFrame.BorderSizePixel = 0
        mainFrame.ClipsDescendants = true

        -- Size: 60% of screen width, height determined by aspect ratio
        -- We'll set size using UIAspectRatioConstraint
        local aspectConstraint = Instance.new("UIAspectRatioConstraint")
        aspectConstraint.Parent = mainFrame
        aspectConstraint.AspectRatio = self.config.aspectRatio
        aspectConstraint.DominantAxis = Enum.DominantAxis.Width

        mainFrame.Size = UDim2.new(0.6, 0, 0, 0) -- width 60%, height auto
        mainFrame.Position = UDim2.new(0.5, -0.3, 0.5, -0.3) -- center

        -- Shadow (optional, we add a background with transparency)
        -- We'll add a drop shadow using a transparent frame behind? Not needed.

        -- Title (top-left)
        local titleLabel = Instance.new("TextLabel")
        titleLabel.Name = "Title"
        titleLabel.Parent = mainFrame
        titleLabel.Text = self.config.title
        titleLabel.TextScaled = true
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.TextColor3 = Color3.new(1,1,1)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Size = UDim2.new(0.5, 0, 0.1, 0)
        titleLabel.Position = UDim2.new(0.02, 0, 0.01, 0)
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        self.titleLabel = titleLabel

        -- Close button (top-right) - but we have a bind to hide, maybe add X
        local closeBtn = Instance.new("TextButton")
        closeBtn.Name = "CloseBtn"
        closeBtn.Parent = mainFrame
        closeBtn.Text = "✕"
        closeBtn.TextScaled = true
        closeBtn.Font = Enum.Font.Gotham
        closeBtn.BackgroundColor3 = Color3.fromRGB(200,60,60)
        closeBtn.BackgroundTransparency = 0.2
        closeBtn.Size = UDim2.new(0.05, 0, 0.08, 0)
        closeBtn.Position = UDim2.new(0.93, 0, 0.01, 0)
        closeBtn.TextColor3 = Color3.new(1,1,1)
        closeBtn.BorderSizePixel = 0
        closeBtn.MouseButton1Click:Connect(function()
            self:Toggle()
        end)
        self.closeBtn = closeBtn

        -- Right panel: Tabs (vertical list)
        local tabPanel = Instance.new("Frame")
        tabPanel.Name = "TabPanel"
        tabPanel.Parent = mainFrame
        tabPanel.BackgroundTransparency = 0.3
        tabPanel.Size = UDim2.new(0.2, 0, 1, 0)
        tabPanel.Position = UDim2.new(0.8, 0, 0, 0)
        tabPanel.BorderSizePixel = 0

        -- Tab List (ScrollingFrame)
        local tabScroller = Instance.new("ScrollingFrame")
        tabScroller.Name = "TabScroller"
        tabScroller.Parent = tabPanel
        tabScroller.Size = UDim2.new(1, 0, 1, -0.05) -- leave room for scrollbar
        tabScroller.Position = UDim2.new(0, 0, 0.03, 0)
        tabScroller.BackgroundTransparency = 1
        tabScroller.BorderSizePixel = 0
        tabScroller.ScrollBarThickness = 4
        tabScroller.ScrollBarImageColor3 = Color3.fromRGB(150,150,150)

        local tabListLayout = Instance.new("UIListLayout")
        tabListLayout.Parent = tabScroller
        tabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        tabListLayout.Padding = UDim.new(0, 4)
        tabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        self.tabScroller = tabScroller
        self.tabListLayout = tabListLayout

        -- Content panel (left side)
        local contentPanel = Instance.new("Frame")
        contentPanel.Name = "ContentPanel"
        contentPanel.Parent = mainFrame
        contentPanel.BackgroundTransparency = 1
        contentPanel.Size = UDim2.new(0.78, 0, 1, 0)
        contentPanel.Position = UDim2.new(0.01, 0, 0, 0)
        contentPanel.ClipsDescendants = true
        self.contentPanel = contentPanel

        -- Store references
        self.mainFrame = mainFrame
        self.tabPanel = tabPanel

        -- Initially hidden
        mainFrame.Visible = false
        self.visible = false

        -- Handle resizing to keep aspect ratio on window resize
        local function updateSize()
            -- The aspect constraint handles it
        end
        -- Could listen to screen size changes but not needed
    end

    function UIManager:applyTheme()
        local theme = self.theme
        local mainFrame = self.mainFrame
        if not mainFrame then return end

        mainFrame.BackgroundColor3 = theme.Background
        -- Title color
        if self.titleLabel then
            self.titleLabel.TextColor3 = theme.Text
        end
        -- Close button
        if self.closeBtn then
            self.closeBtn.BackgroundColor3 = theme.ToggleOff
            self.closeBtn.TextColor3 = theme.Text
        end
        -- Tab panel
        if self.tabPanel then
            self.tabPanel.BackgroundColor3 = theme.BackgroundSecondary
        end
        -- Update all elements
        for _, elem in ipairs(self.elements) do
            if elem.updateTheme then
                elem:updateTheme(theme)
            end
        end
        -- Update tabs
        for _, tab in pairs(self.tabs) do
            if tab.updateTheme then
                tab:updateTheme(theme)
            end
        end
    end

    function UIManager:setupInput()
        -- Bind key for toggling visibility
        local function onInputBegan(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == Enum.KeyCode[self.bindKey] then
                self:Toggle()
            end
        end
        self.inputConnection = UserInputService.InputBegan:Connect(onInputBegan)

        -- Also handle global bind keys for toggles
        -- We'll store toggle bindings and handle them here
        self.toggleBindings = {} -- keyCode -> toggle function
        local function onToggleInput(input, gameProcessed)
            if gameProcessed then return end
            local key = input.KeyCode
            if key and self.toggleBindings[key] then
                self.toggleBindings[key]()
            end
        end
        self.toggleInputConnection = UserInputService.InputBegan:Connect(onToggleInput)
    end

    function UIManager:Toggle()
        if self.visible then
            self:Hide()
        else
            self:Show()
        end
    end

    function UIManager:Show()
        self.visible = true
        self.mainFrame.Visible = true
        -- Animate? optional
    end

    function UIManager:Hide()
        self.visible = false
        self.mainFrame.Visible = false
    end

    function UIManager:SetBindKey(newKey)
        self.bindKey = newKey
        -- Update in settings if needed
    end

    function UIManager:SetTheme(themeNameOrTable)
        if type(themeNameOrTable) == "string" then
            local preset = Themes[themeNameOrTable]
            if preset then
                self.theme = deepCopy(preset)
            else
                warn("UI: Theme not found, keeping current")
                return
            end
        elseif type(themeNameOrTable) == "table" then
            self.theme = deepCopy(themeNameOrTable)
        else
            return
        end
        self.config.savedTheme = deepCopy(self.theme) -- for saving
        self:applyTheme()
    end

    function UIManager:GetTheme()
        return deepCopy(self.theme)
    end

    function UIManager:AddTab(name)
        if self.tabs[name] then
            warn("UI: Tab '"..name.."' already exists")
            return self.tabs[name]
        end

        -- Create tab object
        local tab = {}
        tab.name = name
        tab.elements = {} -- list of elements in this tab
        tab.parent = self
        tab.contentFrame = nil

        -- Create content frame inside contentPanel (but hidden initially)
        local frame = Instance.new("Frame")
        frame.Name = name.."_Content"
        frame.Parent = self.contentPanel
        frame.BackgroundTransparency = 1
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.Position = UDim2.new(0, 0, 0, 0)
        frame.Visible = false -- hidden until selected
        frame.ClipsDescendants = true

        -- Add UIListLayout for elements
        local layout = Instance.new("UIListLayout")
        layout.Parent = frame
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 6)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

        -- Also a ScrollingFrame inside? To support many elements, we can wrap in ScrollingFrame
        local scroller = Instance.new("ScrollingFrame")
        scroller.Name = "Scroller"
        scroller.Parent = frame
        scroller.Size = UDim2.new(1, 0, 1, 0)
        scroller.BackgroundTransparency = 1
        scroller.BorderSizePixel = 0
        scroller.ScrollBarThickness = 4
        scroller.ScrollBarImageColor3 = Color3.fromRGB(150,150,150)
        -- Move layout to scroller
        layout.Parent = scroller
        -- Add a UIListLayout to scroller
        local innerLayout = Instance.new("UIListLayout")
        innerLayout.Parent = scroller
        innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        innerLayout.Padding = UDim.new(0, 6)
        innerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        -- We'll use innerLayout for elements

        -- Store scroller
        tab.scroller = scroller
        tab.layout = innerLayout

        -- Create tab button in right panel
        local btn = Instance.new("TextButton")
        btn.Name = name.."_TabBtn"
        btn.Parent = self.tabScroller
        btn.Text = name
        btn.TextScaled = true
        btn.Font = Enum.Font.GothamBold
        btn.BackgroundColor3 = self.theme.BackgroundSecondary
        btn.BackgroundTransparency = 0.5
        btn.Size = UDim2.new(0.9, 0, 0.08, 0) -- height relative to scroller
        btn.Position = UDim2.new(0.05, 0, 0, 0)
        btn.BorderSizePixel = 0
        btn.TextColor3 = self.theme.Text
        btn.AutoButtonColor = false

        -- On click, activate tab
        btn.MouseButton1Click:Connect(function()
            self:ActivateTab(name)
        end)

        -- Hover effect
        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = self.theme.AccentHover
            btn.BackgroundTransparency = 0.3
        end)
        btn.MouseLeave:Connect(function()
            if self.activeTab ~= name then
                btn.BackgroundColor3 = self.theme.BackgroundSecondary
                btn.BackgroundTransparency = 0.5
            end
        end)

        tab.button = btn

        -- Store tab
        self.tabs[name] = tab
        table.insert(self.tabOrder, name)

        -- Update scroller canvas size
        self:updateTabScroller()

        -- If first tab, activate it
        if #self.tabOrder == 1 then
            self:ActivateTab(name)
        end

        return tab
    end

    function UIManager:updateTabScroller()
        local count = #self.tabOrder
        local height = count * 0.08 + (count-1)*0.02 + 0.1 -- each button 0.08, padding 0.02, plus margins
        self.tabScroller.CanvasSize = UDim2.new(0, 0, height, 0)
    end

    function UIManager:ActivateTab(name)
        if self.activeTab == name then return end
        -- Hide previous
        if self.activeTab then
            local prev = self.tabs[self.activeTab]
            if prev then
                prev.scroller.Parent.Visible = false
                prev.button.BackgroundColor3 = self.theme.BackgroundSecondary
                prev.button.BackgroundTransparency = 0.5
            end
        end
        -- Show new
        local tab = self.tabs[name]
        if tab then
            tab.scroller.Parent.Visible = true
            tab.button.BackgroundColor3 = self.theme.Accent
            tab.button.BackgroundTransparency = 0.2
            self.activeTab = name
        end
    end

    -- Element creation functions

    function UIManager:createElement(tab, elementType, params)
        local frame = Instance.new("Frame")
        frame.BackgroundTransparency = 1
        frame.Size = UDim2.new(0.95, 0, 0, 0) -- height will be set
        frame.AutomaticSize = Enum.AutomaticSize.Y

        local layout = tab.layout
        frame.Parent = tab.scroller
        frame.LayoutOrder = #tab.elements + 1

        -- Store element data for theme update
        local element = {
            frame = frame,
            type = elementType,
            params = params,
            updateTheme = function(self, theme)
                -- Implement in each element
            end
        }

        -- Build element based on type
        if elementType == "Toggle" then
            -- Toggle with optional bind
            local label = params.label or "Toggle"
            local bindKey = params.bindKey
            local default = params.default or false

            local toggleFrame = Instance.new("Frame")
            toggleFrame.Parent = frame
            toggleFrame.BackgroundColor3 = self.theme.BackgroundSecondary
            toggleFrame.BackgroundTransparency = 0.3
            toggleFrame.Size = UDim2.new(1, 0, 0, 40)
            toggleFrame.AutomaticSize = Enum.AutomaticSize.Y
            toggleFrame.BorderSizePixel = 0
            toggleFrame.ClipsDescendants = true

            local labelText = Instance.new("TextLabel")
            labelText.Parent = toggleFrame
            labelText.Text = label
            labelText.TextScaled = true
            labelText.Font = Enum.Font.Gotham
            labelText.TextColor3 = self.theme.Text
            labelText.BackgroundTransparency = 1
            labelText.Size = UDim2.new(0.6, 0, 1, 0)
            labelText.Position = UDim2.new(0.02, 0, 0, 0)
            labelText.TextXAlignment = Enum.TextXAlignment.Left

            local toggleBtn = Instance.new("TextButton")
            toggleBtn.Parent = toggleFrame
            toggleBtn.Size = UDim2.new(0.2, 0, 0.6, 0)
            toggleBtn.Position = UDim2.new(0.78, 0, 0.2, 0)
            toggleBtn.Text = default and "ON" or "OFF"
            toggleBtn.TextScaled = true
            toggleBtn.Font = Enum.Font.GothamBold
            toggleBtn.BackgroundColor3 = default and self.theme.ToggleOn or self.theme.ToggleOff
            toggleBtn.BorderSizePixel = 0
            toggleBtn.TextColor3 = self.theme.Text
            toggleBtn.AutoButtonColor = false

            local state = default
            local function toggle()
                state = not state
                toggleBtn.Text = state and "ON" or "OFF"
                toggleBtn.BackgroundColor3 = state and self.theme.ToggleOn or self.theme.ToggleOff
                if params.callback then
                    params.callback(state)
                end
            end

            toggleBtn.MouseButton1Click:Connect(toggle)

            -- Bind key if provided
            if bindKey then
                local key = Enum.KeyCode[bindKey]
                if key then
                    self.toggleBindings[key] = toggle
                    -- Store reference to clean up later?
                end
            end

            -- Store for theme update
            element.updateTheme = function(self, theme)
                labelText.TextColor3 = theme.Text
                toggleBtn.TextColor3 = theme.Text
                toggleFrame.BackgroundColor3 = theme.BackgroundSecondary
                toggleBtn.BackgroundColor3 = state and theme.ToggleOn or theme.ToggleOff
            end

            element.toggleBtn = toggleBtn
            element.state = state
            element.toggle = toggle

        elseif elementType == "Button" then
            -- Simple button without state
            local label = params.label or "Button"
            local callback = params.callback

            local btnFrame = Instance.new("Frame")
            btnFrame.Parent = frame
            btnFrame.BackgroundColor3 = self.theme.BackgroundSecondary
            btnFrame.BackgroundTransparency = 0.3
            btnFrame.Size = UDim2.new(1, 0, 0, 40)
            btnFrame.AutomaticSize = Enum.AutomaticSize.Y
            btnFrame.BorderSizePixel = 0

            local btn = Instance.new("TextButton")
            btn.Parent = btnFrame
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.Text = label
            btn.TextScaled = true
            btn.Font = Enum.Font.GothamBold
            btn.BackgroundTransparency = 0.8
            btn.BorderSizePixel = 0
            btn.TextColor3 = self.theme.Text
            btn.AutoButtonColor = false

            btn.MouseEnter:Connect(function()
                btn.BackgroundTransparency = 0.4
            end)
            btn.MouseLeave:Connect(function()
                btn.BackgroundTransparency = 0.8
            end)
            btn.MouseButton1Click:Connect(function()
                if callback then callback() end
            end)

            element.updateTheme = function(self, theme)
                btn.TextColor3 = theme.Text
                btnFrame.BackgroundColor3 = theme.BackgroundSecondary
            end
            element.button = btn

        elseif elementType == "Slider" then
            -- Slider with label and value display
            local label = params.label or "Slider"
            local min = params.min or 0
            local max = params.max or 100
            local default = params.default or (min+max)/2
            local callback = params.callback

            local sliderFrame = Instance.new("Frame")
            sliderFrame.Parent = frame
            sliderFrame.BackgroundColor3 = self.theme.BackgroundSecondary
            sliderFrame.BackgroundTransparency = 0.3
            sliderFrame.Size = UDim2.new(1, 0, 0, 50)
            sliderFrame.AutomaticSize = Enum.AutomaticSize.Y
            sliderFrame.BorderSizePixel = 0
            sliderFrame.ClipsDescendants = true

            local labelText = Instance.new("TextLabel")
            labelText.Parent = sliderFrame
            labelText.Text = label
            labelText.TextScaled = true
            labelText.Font = Enum.Font.Gotham
            labelText.TextColor3 = self.theme.Text
            labelText.BackgroundTransparency = 1
            labelText.Size = UDim2.new(0.5, 0, 0.4, 0)
            labelText.Position = UDim2.new(0.02, 0, 0.05, 0)
            labelText.TextXAlignment = Enum.TextXAlignment.Left

            local valueLabel = Instance.new("TextLabel")
            valueLabel.Parent = sliderFrame
            valueLabel.Text = tostring(default)
            valueLabel.TextScaled = true
            valueLabel.Font = Enum.Font.Gotham
            valueLabel.TextColor3 = self.theme.Text
            valueLabel.BackgroundTransparency = 1
            valueLabel.Size = UDim2.new(0.2, 0, 0.4, 0)
            valueLabel.Position = UDim2.new(0.78, 0, 0.05, 0)
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local slider = Instance.new("Frame")
            slider.Parent = sliderFrame
            slider.BackgroundColor3 = self.theme.Background
            slider.Size = UDim2.new(0.9, 0, 0.2, 0)
            slider.Position = UDim2.new(0.05, 0, 0.6, 0)
            slider.BorderSizePixel = 0

            local fill = Instance.new("Frame")
            fill.Parent = slider
            fill.BackgroundColor3 = self.theme.Accent
            fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
            fill.BorderSizePixel = 0

            local dragBtn = Instance.new("TextButton")
            dragBtn.Parent = slider
            dragBtn.BackgroundColor3 = self.theme.Foreground
            dragBtn.Size = UDim2.new(0.04, 0, 1.5, 0)
            dragBtn.Position = UDim2.new((default-min)/(max-min) - 0.02, 0, -0.25, 0)
            dragBtn.BorderSizePixel = 0
            dragBtn.BackgroundTransparency = 0.2
            dragBtn.Text = ""

            local dragging = false
            local function updateSlider(input)
                local pos = input.Position.X - slider.AbsolutePosition.X
                local width = slider.AbsoluteSize.X
                local val = math.clamp(pos / width, 0, 1)
                local value = min + val * (max - min)
                value = math.floor(value + 0.5) -- integer
                fill.Size = UDim2.new(val, 0, 1, 0)
                dragBtn.Position = UDim2.new(val - 0.02, 0, -0.25, 0)
                valueLabel.Text = tostring(value)
                if callback then callback(value) end
            end

            dragBtn.MouseButton1Down:Connect(function()
                dragging = true
                dragBtn.BackgroundTransparency = 0
            end)
            dragBtn.MouseButton1Up:Connect(function()
                dragging = false
                dragBtn.BackgroundTransparency = 0.2
            end)
            dragBtn.MouseLeave:Connect(function()
                if dragging then
                    dragging = false
                    dragBtn.BackgroundTransparency = 0.2
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateSlider(input)
                end
            end)
            -- Also touch support
            UserInputService.TouchMoved:Connect(function(input)
                if dragging then
                    updateSlider(input)
                end
            end)

            element.updateTheme = function(self, theme)
                labelText.TextColor3 = theme.Text
                valueLabel.TextColor3 = theme.Text
                sliderFrame.BackgroundColor3 = theme.BackgroundSecondary
                slider.BackgroundColor3 = theme.Background
                fill.BackgroundColor3 = theme.Accent
                dragBtn.BackgroundColor3 = theme.Foreground
            end
            element.slider = slider
            element.fill = fill
            element.dragBtn = dragBtn

        elseif elementType == "Dropdown" then
            -- Dropdown with multi-select option
            local label = params.label or "Dropdown"
            local items = params.items or {}
            local multiSelect = params.multiSelect or false
            local default = params.default or (multiSelect and {} or nil)

            local dropdownFrame = Instance.new("Frame")
            dropdownFrame.Parent = frame
            dropdownFrame.BackgroundColor3 = self.theme.BackgroundSecondary
            dropdownFrame.BackgroundTransparency = 0.3
            dropdownFrame.Size = UDim2.new(1, 0, 0, 40)
            dropdownFrame.AutomaticSize = Enum.AutomaticSize.Y
            dropdownFrame.BorderSizePixel = 0
            dropdownFrame.ClipsDescendants = true

            local labelText = Instance.new("TextLabel")
            labelText.Parent = dropdownFrame
            labelText.Text = label
            labelText.TextScaled = true
            labelText.Font = Enum.Font.Gotham
            labelText.TextColor3 = self.theme.Text
            labelText.BackgroundTransparency = 1
            labelText.Size = UDim2.new(0.5, 0, 0.4, 0)
            labelText.Position = UDim2.new(0.02, 0, 0.05, 0)
            labelText.TextXAlignment = Enum.TextXAlignment.Left

            local selectedLabel = Instance.new("TextLabel")
            selectedLabel.Parent = dropdownFrame
            selectedLabel.Text = multiSelect and "Select..." or "None"
            selectedLabel.TextScaled = true
            selectedLabel.Font = Enum.Font.Gotham
            selectedLabel.TextColor3 = self.theme.TextDim
            selectedLabel.BackgroundTransparency = 1
            selectedLabel.Size = UDim2.new(0.3, 0, 0.4, 0)
            selectedLabel.Position = UDim2.new(0.68, 0, 0.05, 0)
            selectedLabel.TextXAlignment = Enum.TextXAlignment.Right

            local dropdownBtn = Instance.new("TextButton")
            dropdownBtn.Parent = dropdownFrame
            dropdownBtn.Size = UDim2.new(0.1, 0, 0.4, 0)
            dropdownBtn.Position = UDim2.new(0.88, 0, 0.05, 0)
            dropdownBtn.Text = "▼"
            dropdownBtn.TextScaled = true
            dropdownBtn.Font = Enum.Font.Gotham
            dropdownBtn.BackgroundTransparency = 1
            dropdownBtn.TextColor3 = self.theme.Text
            dropdownBtn.BorderSizePixel = 0

            -- Dropdown list (hidden initially)
            local listFrame = Instance.new("Frame")
            listFrame.Parent = dropdownFrame
            listFrame.BackgroundColor3 = self.theme.Dropdown
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.Position = UDim2.new(0, 0, 0.5, 0)
            listFrame.Visible = false
            listFrame.BorderSizePixel = 0
            listFrame.ClipsDescendants = true

            local listScroller = Instance.new("ScrollingFrame")
            listScroller.Parent = listFrame
            listScroller.Size = UDim2.new(1, 0, 1, 0)
            listScroller.BackgroundTransparency = 1
            listScroller.BorderSizePixel = 0
            listScroller.ScrollBarThickness = 4
            listScroller.ScrollBarImageColor3 = Color3.fromRGB(150,150,150)

            local listLayout = Instance.new("UIListLayout")
            listLayout.Parent = listScroller
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            listLayout.Padding = UDim.new(0, 2)

            local selectedItems = {} -- for multiSelect, table of item:boolean

            -- Function to update selected label
            local function updateSelectedLabel()
                if multiSelect then
                    local count = 0
                    for _, v in pairs(selectedItems) do if v then count = count + 1 end end
                    selectedLabel.Text = (count > 0) and count.." selected" or "Select..."
                else
                    for _, v in pairs(selectedItems) do
                        if v then
                            selectedLabel.Text = v
                            break
                        end
                    end
                    if selectedLabel.Text == "" or selectedLabel.Text == "None" then
                        selectedLabel.Text = "None"
                    end
                end
            end

            -- Create list items
            local itemButtons = {}
            for i, item in ipairs(items) do
                local itemFrame = Instance.new("Frame")
                itemFrame.Parent = listScroller
                itemFrame.BackgroundColor3 = self.theme.BackgroundSecondary
                itemFrame.BackgroundTransparency = 0.5
                itemFrame.Size = UDim2.new(1, 0, 0, 30)
                itemFrame.BorderSizePixel = 0

                local checkBox = Instance.new("TextButton")
                checkBox.Parent = itemFrame
                checkBox.Size = UDim2.new(0.1, 0, 1, 0)
                checkBox.Text = "☐"
                checkBox.TextScaled = true
                checkBox.Font = Enum.Font.Gotham
                checkBox.BackgroundTransparency = 1
                checkBox.TextColor3 = self.theme.Text
                checkBox.BorderSizePixel = 0

                local itemLabel = Instance.new("TextLabel")
                itemLabel.Parent = itemFrame
                itemLabel.Text = item
                itemLabel.TextScaled = true
                itemLabel.Font = Enum.Font.Gotham
                itemLabel.TextColor3 = self.theme.Text
                itemLabel.BackgroundTransparency = 1
                itemLabel.Size = UDim2.new(0.85, 0, 1, 0)
                itemLabel.Position = UDim2.new(0.1, 0, 0, 0)
                itemLabel.TextXAlignment = Enum.TextXAlignment.Left

                -- State
                local isSelected = false
                if multiSelect then
                    if default and default[item] then
                        isSelected = true
                    end
                else
                    if default == item then
                        isSelected = true
                    end
                end
                selectedItems[item] = isSelected
                checkBox.Text = isSelected and "☑" or "☐"

                -- Toggle selection
                local function toggleSelection()
                    if multiSelect then
                        selectedItems[item] = not selectedItems[item]
                        checkBox.Text = selectedItems[item] and "☑" or "☐"
                        -- Callback with all selected items
                        local selected = {}
                        for k, v in pairs(selectedItems) do
                            if v then table.insert(selected, k) end
                        end
                        if params.callback then params.callback(selected) end
                    else
                        -- Single select: deselect others
                        for k, v in pairs(selectedItems) do
                            if k ~= item and v then
                                selectedItems[k] = false
                                -- update checkbox
                                for _, btn in ipairs(itemButtons) do
                                    if btn.item == k then
                                        btn.checkBox.Text = "☐"
                                    end
                                end
                            end
                        end
                        selectedItems[item] = true
                        checkBox.Text = "☑"
                        if params.callback then params.callback(item) end
                    end
                    updateSelectedLabel()
                    -- Close list after selection? For single select maybe close
                    if not multiSelect then
                        listFrame.Visible = false
                        dropdownFrame.Size = UDim2.new(1, 0, 0, 40)
                    end
                end

                checkBox.MouseButton1Click:Connect(toggleSelection)
                itemLabel.MouseButton1Click:Connect(toggleSelection)

                table.insert(itemButtons, {frame = itemFrame, checkBox = checkBox, label = itemLabel, item = item})
            end

            -- Adjust list height based on item count (capped at 5 items)
            local maxVisible = 5
            local itemHeight = 30
            local totalHeight = math.min(#items, maxVisible) * itemHeight
            listFrame.Size = UDim2.new(1, 0, 0, totalHeight)

            -- Show/Hide dropdown
            local function toggleDropdown()
                listFrame.Visible = not listFrame.Visible
                if listFrame.Visible then
                    dropdownFrame.Size = UDim2.new(1, 0, 0, 40 + totalHeight)
                    listScroller.CanvasSize = UDim2.new(0, 0, #items * itemHeight, 0)
                else
                    dropdownFrame.Size = UDim2.new(1, 0, 0, 40)
                end
            end

            dropdownBtn.MouseButton1Click:Connect(toggleDropdown)
            -- Also close if clicked outside? Not necessary.

            -- Update selected label initially
            updateSelectedLabel()

            element.updateTheme = function(self, theme)
                labelText.TextColor3 = theme.Text
                selectedLabel.TextColor3 = theme.TextDim
                dropdownBtn.TextColor3 = theme.Text
                dropdownFrame.BackgroundColor3 = theme.BackgroundSecondary
                listFrame.BackgroundColor3 = theme.Dropdown
                for _, btn in ipairs(itemButtons) do
                    btn.frame.BackgroundColor3 = theme.BackgroundSecondary
                    btn.label.TextColor3 = theme.Text
                    btn.checkBox.TextColor3 = theme.Text
                end
            end

            -- Store for later use
            element.dropdownFrame = dropdownFrame
            element.listFrame = listFrame
            element.selectedItems = selectedItems
            element.updateSelectedLabel = updateSelectedLabel
        end

        -- Add to tab's elements
        table.insert(tab.elements, element)
        -- Also add to global elements for theme update
        table.insert(self.elements, element)

        -- Update tab's scroller canvas size
        local count = #tab.elements
        tab.scroller.CanvasSize = UDim2.new(0, 0, count * 50 + (count-1)*6 + 20, 0) -- approximate

        return element
    end

    -- Public methods on tab
    function UIManager:AddToggle(label, bindKey, default, callback)
        -- If current active tab? But we need tab object.
        -- We'll add methods on tab objects.
    end

    -- We'll extend the tab object with methods
    local tabMetatable = {}
    function tabMetatable:AddToggle(label, bindKey, default, callback)
        local params = {label=label, bindKey=bindKey, default=default, callback=callback}
        return self.parent:createElement(self, "Toggle", params)
    end
    function tabMetatable:AddButton(label, callback)
        local params = {label=label, callback=callback}
        return self.parent:createElement(self, "Button", params)
    end
    function tabMetatable:AddSlider(label, min, max, default, callback)
        local params = {label=label, min=min, max=max, default=default, callback=callback}
        return self.parent:createElement(self, "Slider", params)
    end
    function tabMetatable:AddDropdown(label, items, multiSelect, default, callback)
        local params = {label=label, items=items, multiSelect=multiSelect, default=default, callback=callback}
        return self.parent:createElement(self, "Dropdown", params)
    end

    -- Override AddTab to return tab with metatable
    local originalAddTab = UIManager.AddTab
    function UIManager:AddTab(name)
        local tab = originalAddTab(self, name)
        if tab then
            setmetatable(tab, {__index = tabMetatable})
        end
        return tab
    end

    -- Add Settings tab automatically
    function UIManager:addSettingsTab()
        local settingsTab = self:AddTab("Settings")
        if not settingsTab then return end

        -- Theme selection dropdown
        local themeNames = {}
        for name, _ in pairs(Themes) do
            table.insert(themeNames, name)
        end
        settingsTab:AddDropdown("Theme", themeNames, false, self.config.theme, function(selected)
            if selected then
                self:SetTheme(selected)
                -- Save theme to savedTheme
                self.config.savedTheme = deepCopy(self.theme)
                -- User can save via GetTheme later
            end
        end)

        -- Bind key changer
        local keys = {"RightShift", "LeftShift", "RightControl", "LeftControl", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"}
        settingsTab:AddDropdown("Toggle Key", keys, false, self.bindKey, function(selected)
            if selected then
                self:SetBindKey(selected)
            end
        end)

        -- Add a button to save theme (for user convenience)
        settingsTab:AddButton("Copy Theme to Clipboard", function()
            local themeJson = HttpService:JSONEncode(self.theme)
            setclipboard(themeJson) -- if available
            warn("Theme JSON copied to clipboard (if setclipboard is available)")
        end)
        settingsTab:AddButton("Apply Saved Theme", function()
            -- In practice, user would load from their saved data
            -- We'll just show a message
            warn("Use ui:SetTheme(themeTable) to apply a saved theme.")
        end)
    end

    -- After creating UI, add settings tab
    -- But we need to do it after the object is fully initialized.
    -- We'll call it from New
    local function init(self)
        self:addSettingsTab()
        -- Apply theme after all elements created
        self:applyTheme()
    end

    -- Override New to call init
    local oldNew = UIManager.New
    function UIManager.New(config)
        local self = oldNew(config)
        init(self)
        return self
    end

    return UIManager
end
