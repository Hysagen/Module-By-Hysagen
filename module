    TabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabContainer.Parent = MainFrame
    
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Size = UDim2.new(1, -135, 1, -55)
    ContentContainer.Position = UDim2.new(0, 130, 0, 50)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = MainFrame
    
    UIStore.ScreenGui = ScreenGui
    UIStore.MainFrame = MainFrame
    UIStore.TabContainer = TabContainer
    UIStore.ContentContainer = ContentContainer
    UIStore.TitleLabel = TitleLabel
    
    local settingsTab = self:CreateTab("Настройки", "settings")
    UIStore.SettingsTab = settingsTab
    
    self:AddSettingsUI(settingsTab)
    
