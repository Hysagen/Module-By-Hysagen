local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Library = {
    CurrentTheme = "Dark",
    ToggleKey = Enum.KeyCode.RightControl,
    Themes = {
        Dark = {
            Background = Color3.fromRGB(24, 24, 32),
            Sidebar = Color3.fromRGB(18, 18, 24),
            Element = Color3.fromRGB(32, 32, 44),
            Text = Color3.fromRGB(255, 255, 255),
            Accent = Color3.fromRGB(88, 101, 242)
        },
        Light = {
            Background = Color3.fromRGB(240, 240, 245),
            Sidebar = Color3.fromRGB(220, 220, 230),
            Element = Color3.fromRGB(255, 255, 255),
            Text = Color3.fromRGB(30, 30, 35),
            Accent = Color3.fromRGB(0, 122, 255)
        }
    }
}

function Library:CreateWindow(config)
    config = config or {}
    local titleText = config.Title or "UI Module"
    local aspectRatio = config.AspectRatio or (4/3)

    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CustomStudioUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = playerGui

    -- Главный адаптивный контейнер
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner", MainFrame)
    UICorner.CornerRadius = UDim.new(0, 10)

    local UIAspectRatio = Instance.new("UIAspectRatioConstraint", MainFrame)
    UIAspectRatio.AspectRatio = aspectRatio

    -- Шапка (Header)
    local Header = Instance.new("Frame", MainFrame)
    Header.Size = UDim2.new(1, 0, 0.12, 0)
    Header.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
    Header.BorderSizePixel = 0

    local Title = Instance.new("TextLabel", Header)
    Title.Size = UDim2.new(0.6, 0, 1, 0)
    Title.Position = UDim2.new(0.04, 0, 0, 0)
    Title.Text = titleText
    Title.TextColor3 = Library.Themes[Library.CurrentTheme].Text
    Title.TextScaled = true
    Title.Font = Enum.Font.GothamBold
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local SettingsBtn = Instance.new("TextButton", Header)
    SettingsBtn.Size = UDim2.new(0.22, 0, 0.6, 0)
    SettingsBtn.Position = UDim2.new(0.74, 0, 0.2, 0)
    SettingsBtn.Text = "Settings"
    SettingsBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
    SettingsBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
    SettingsBtn.Font = Enum.Font.GothamMedium
    SettingsBtn.TextSize = 12

    local SettingsCorner = Instance.new("UICorner", SettingsBtn)
    SettingsCorner.CornerRadius = UDim.new(0, 6)

    -- Правая боковая панель вкладок с прокруткой
    local Sidebar = Instance.new("ScrollingFrame", MainFrame)
    Sidebar.Size = UDim2.new(0.28, 0, 0.88, 0)
    Sidebar.Position = UDim2.new(0.72, 0, 0.12, 0)
    Sidebar.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
    Sidebar.BorderSizePixel = 0
    Sidebar.ScrollBarThickness = 3
    Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)

    local SidebarLayout = Instance.new("UIListLayout", Sidebar)
    SidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    SidebarLayout.Padding = UDim.new(0, 6)

    local SidebarPadding = Instance.new("UIPadding", Sidebar)
    SidebarPadding.PaddingTop = UDim.new(0, 6)
    SidebarPadding.PaddingLeft = UDim.new(0, 6)

    SidebarLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Sidebar.CanvasSize = UDim2.new(0, 0, 0, SidebarLayout.AbsoluteContentSize.Y + 12)
    end)

    -- Область содержимого вкладок
    local ContentArea = Instance.new("Frame", MainFrame)
    ContentArea.Size = UDim2.new(0.72, 0, 0.88, 0)
    ContentArea.Position = UDim2.new(0, 0, 0.12, 0)
    ContentArea.BackgroundTransparency = 1

    -- Показ / скрытие UI по клавише
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Library.ToggleKey then
            MainFrame.Visible = not MainFrame.Visible
        end
    end)

    local Window = { CurrentTab = nil }

    -- Функция создания вкладки
    function Window:CreateTab(name)
        local TabBtn = Instance.new("TextButton", Sidebar)
        TabBtn.Size = UDim2.new(0.9, 0, 0, 32)
        TabBtn.Text = name
        TabBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
        TabBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
        TabBtn.Font = Enum.Font.Gotham
        TabBtn.TextSize = 12

        local TabCorner = Instance.new("UICorner", TabBtn)
        TabCorner.CornerRadius = UDim.new(0, 6)

        local Page = Instance.new("ScrollingFrame", ContentArea)
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.Visible = false
        Page.ScrollBarThickness = 3
        Page.CanvasSize = UDim2.new(0, 0, 0, 0)

        local PageLayout = Instance.new("UIListLayout", Page)
        PageLayout.Padding = UDim.new(0, 8)

        local PagePadding = Instance.new("UIPadding", Page)
        PagePadding.PaddingTop = UDim.new(0, 8)
        PagePadding.PaddingLeft = UDim.new(0, 10)

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 16)
        end)

        TabBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(ContentArea:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            Page.Visible = true
        end)

        if not Window.CurrentTab then
            Window.CurrentTab = Page
            Page.Visible = true
        end

        local Elements = {}

        -- 1. Кнопка с биндом
        function Elements:CreateKeybindToggle(text, defaultKey, callback)
            local state = false
            local key = defaultKey or Enum.KeyCode.E
            local binding = false

            local Frame = Instance.new("Frame", Page)
            Frame.Size = UDim2.new(0.95, 0, 0, 38)
            Frame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

            local ToggleBtn = Instance.new("TextButton", Frame)
            ToggleBtn.Size = UDim2.new(0.65, 0, 1, 0)
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Text = "  " .. text .. ": OFF"
            ToggleBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
            ToggleBtn.Font = Enum.Font.Gotham
            ToggleBtn.TextSize = 12
            ToggleBtn.TextXAlignment = Enum.TextXAlignment.Left

            local BindBtn = Instance.new("TextButton", Frame)
            BindBtn.Size = UDim2.new(0.3, -6, 0.7, 0)
            BindBtn.Position = UDim2.new(0.68, 0, 0.15, 0)
            BindBtn.Text = "[" .. key.Name .. "]"
            BindBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
            BindBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
            BindBtn.Font = Enum.Font.GothamBold
            BindBtn.TextSize = 11
            Instance.new("UICorner", BindBtn).CornerRadius = UDim.new(0, 4)

            local function UpdateState(val)
                state = val
                ToggleBtn.Text = "  " .. text .. ": " .. (state and "ON" or "OFF")
                ToggleBtn.TextColor3 = state and Library.Themes[Library.CurrentTheme].Accent or Library.Themes[Library.CurrentTheme].Text
                pcall(callback, state)
            end

            ToggleBtn.MouseButton1Click:Connect(function() UpdateState(not state) end)

            BindBtn.MouseButton1Click:Connect(function()
                BindBtn.Text = "[...]"
                binding = true
            end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if binding and input.UserInputType == Enum.UserInputType.Keyboard then
                    key = input.KeyCode
                    BindBtn.Text = "[" .. key.Name .. "]"
                    binding = false
                elseif not binding and input.KeyCode == key then
                    UpdateState(not state)
                end
            end)
        end

        -- 2. Кнопка без бинда
        function Elements:CreateToggle(text, default, callback)
            local state = default or false

            local Btn = Instance.new("TextButton", Page)
            Btn.Size = UDim2.new(0.95, 0, 0, 36)
            Btn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
            Btn.Text = text .. ": " .. (state and "ON" or "OFF")
            Btn.TextColor3 = state and Library.Themes[Library.CurrentTheme].Accent or Library.Themes[Library.CurrentTheme].Text
            Btn.Font = Enum.Font.Gotham
            Btn.TextSize = 12
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

            Btn.MouseButton1Click:Connect(function()
                state = not state
                Btn.Text = text .. ": " .. (state and "ON" or "OFF")
                Btn.TextColor3 = state and Library.Themes[Library.CurrentTheme].Accent or Library.Themes[Library.CurrentTheme].Text
                pcall(callback, state)
            end)
        end

        -- 3. Ползунок (Slider)
        function Elements:CreateSlider(text, min, max, default, callback)
            local value = math.clamp(default or min, min, max)
            local dragging = false

            local SliderFrame = Instance.new("Frame", Page)
            SliderFrame.Size = UDim2.new(0.95, 0, 0, 44)
            SliderFrame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
            Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 6)

            local Label = Instance.new("TextLabel", SliderFrame)
            Label.Size = UDim2.new(1, -10, 0, 18)
            Label.Position = UDim2.new(0, 8, 0, 2)
            Label.Text = text .. ": " .. tostring(value)
            Label.TextColor3 = Library.Themes[Library.CurrentTheme].Text
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 11
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Track = Instance.new("Frame", SliderFrame)
            Track.Size = UDim2.new(0.9, 0, 0, 6)
            Track.Position = UDim2.new(0.05, 0, 0.65, 0)
            Track.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
            Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame", Track)
            Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            Fill.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Accent
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local function Update(input)
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                value = math.floor(min + ((max - min) * pos))
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                Label.Text = text .. ": " .. tostring(value)
                pcall(callback, value)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
        end

        -- 4. Выпадающий список (Dropdown)
        function Elements:CreateDropdown(text, options, multiSelect, callback)
            local selected = {}
            local expanded = false

            local DropFrame = Instance.new("Frame", Page)
            DropFrame.Size = UDim2.new(0.95, 0, 0, 36)
            DropFrame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
            DropFrame.ClipsDescendants = true
            Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 6)

            local DropBtn = Instance.new("TextButton", DropFrame)
            DropBtn.Size = UDim2.new(1, 0, 0, 36)
            DropBtn.BackgroundTransparency = 1
            DropBtn.Text = text .. " [Выбрать]"
            DropBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
            DropBtn.Font = Enum.Font.Gotham
            DropBtn.TextSize = 12

            local OptionContainer = Instance.new("Frame", DropFrame)
            OptionContainer.Size = UDim2.new(1, 0, 0, #options * 26)
            OptionContainer.Position = UDim2.new(0, 0, 0, 36)
            OptionContainer.BackgroundTransparency = 1

            local ListLayout = Instance.new("UIListLayout", OptionContainer)
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

            local function RefreshText()
                local selectedList = {}
                for k, v in pairs(selected) do
                    if v then table.insert(selectedList, k) end
                end
                DropBtn.Text = text .. " [" .. (#selectedList > 0 and table.concat(selectedList, ", ") or "Пусто") .. "]"
            end

            for _, opt in ipairs(options) do
                local OptBtn = Instance.new("TextButton", OptionContainer)
                OptBtn.Size = UDim2.new(1, 0, 0, 26)
                OptBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
                OptBtn.Text = opt
                OptBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextSize = 11

                OptBtn.MouseButton1Click:Connect(function()
                    if multiSelect then
                        selected[opt] = not selected[opt]
                        OptBtn.TextColor3 = selected[opt] and Library.Themes[Library.CurrentTheme].Accent or Library.Themes[Library.CurrentTheme].Text
                    else
                        selected = { [opt] = true }
                        for _, child in pairs(OptionContainer:GetChildren()) do
                            if child:IsA("TextButton") then
                                child.TextColor3 = Library.Themes[Library.CurrentTheme].Text
                            end
                        end
                        OptBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Accent
                    end
                    RefreshText()
                    pcall(callback, selected)
                end)
            end

            DropBtn.MouseButton1Click:Connect(function()
                expanded = not expanded
                DropFrame.Size = expanded and UDim2.new(0.95, 0, 0, 36 + (#options * 26)) or UDim2.new(0.95, 0, 0, 36)
            end)
        end

        return Elements
    end

    -- Настройки темы и клавиши
    SettingsBtn.MouseButton1Click:Connect(function()
        local Overlay = Instance.new("Frame", MainFrame)
        Overlay.Size = UDim2.new(1, 0, 1, 0)
        Overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        Overlay.BackgroundTransparency = 0.5
        Overlay.ZIndex = 10

        local Modal = Instance.new("Frame", Overlay)
        Modal.Size = UDim2.new(0.7, 0, 0.6, 0)
        Modal.Position = UDim2.new(0.15, 0, 0.2, 0)
        Modal.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Background
        Modal.ZIndex = 11
        Instance.new("UICorner", Modal).CornerRadius = UDim.new(0, 8)

        local CloseBtn = Instance.new("TextButton", Modal)
        CloseBtn.Size = UDim2.new(0.2, 0, 0.2, 0)
        CloseBtn.Position = UDim2.new(0.75, 0, 0.05, 0)
        CloseBtn.Text = "X"
        CloseBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
        CloseBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
        CloseBtn.ZIndex = 12
        Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 4)

        CloseBtn.MouseButton1Click:Connect(function() Overlay:Destroy() end)

        local ThemeToggleBtn = Instance.new("TextButton", Modal)
        ThemeToggleBtn.Size = UDim2.new(0.8, 0, 0.3, 0)
        ThemeToggleBtn.Position = UDim2.new(0.1, 0, 0.4, 0)
        ThemeToggleBtn.Text = "Тема: " .. Library.CurrentTheme
        ThemeToggleBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
        ThemeToggleBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
        ThemeToggleBtn.ZIndex = 12
        Instance.new("UICorner", ThemeToggleBtn).CornerRadius = UDim.new(0, 6)

        ThemeToggleBtn.MouseButton1Click:Connect(function()
            Library.CurrentTheme = (Library.CurrentTheme == "Dark") and "Light" or "Dark"
            ThemeToggleBtn.Text = "Тема: " .. Library.CurrentTheme
            MainFrame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Background
            Header.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
            Sidebar.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
        end)
    end)

    return Window
end

return Library
