local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Library = {
    Themes = {
        Dark = {
            Background = Color3.fromRGB(25, 25, 35),
            Sidebar = Color3.fromRGB(20, 20, 28),
            Element = Color3.fromRGB(35, 35, 48),
            Accent = Color3.fromRGB(0, 162, 255),
            Text = Color3.fromRGB(255, 255, 255)
        },
        Light = {
            Background = Color3.fromRGB(240, 240, 245),
            Sidebar = Color3.fromRGB(220, 220, 230),
            Element = Color3.fromRGB(255, 255, 255),
            Accent = Color3.fromRGB(0, 120, 215),
            Text = Color3.fromRGB(30, 30, 30)
        }
    },
    CurrentTheme = "Dark",
    ToggleKey = Enum.KeyCode.RightControl
}

function Library:CreateWindow(config)
    config = config or {}
    local titleText = config.Title or "UI Library"
    local aspectRatio = config.AspectRatio or (3/4) -- Соотношение сторон
    
    -- Создание ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CustomUI_" .. math.random(1000, 9999)
    ScreenGui.ResetOnSpawn = false
    
    -- Безопасное добавление в CoreGui или PlayerGui
    pcall(function()
        ScreenGui.Parent = CoreGui
    end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    -- Главная рамка (Main Frame)
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0.4, 0, 0.4 * (1 / aspectRatio), 0) -- Адаптивный размер
    MainFrame.Position = UDim2.new(0.3, 0, 0.3, 0)
    MainFrame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner", MainFrame)
    UICorner.CornerRadius = UDim.new(0, 8)

    local UIAspectRatio = Instance.new("UIAspectRatioConstraint", MainFrame)
    UIAspectRatio.AspectRatio = aspectRatio

    -- Верхняя панель (Header)
    local Header = Instance.new("Frame", MainFrame)
    Header.Size = UDim2.new(1, 0, 0.12, 0)
    Header.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
    Header.BorderSizePixel = 0

    local Title = Instance.new("TextLabel", Header)
    Title.Size = UDim2.new(0.6, 0, 1, 0)
    Title.Position = UDim2.new(0.03, 0, 0, 0)
    Title.Text = titleText
    Title.TextColor3 = Library.Themes[Library.CurrentTheme].Text
    Title.TextScaled = true
    Title.Font = Enum.Font.GothamBold
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left

    -- Кнопка настроек
    local SettingsBtn = Instance.new("TextButton", Header)
    SettingsBtn.Size = UDim2.new(0.2, 0, 0.6, 0)
    SettingsBtn.Position = UDim2.new(0.77, 0, 0.2, 0)
    SettingsBtn.Text = "Settings"
    SettingsBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
    SettingsBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
    SettingsBtn.Font = Enum.Font.Gotham

    -- Боковая панель для вкладок (Справа, со скроллом)
    local Sidebar = Instance.new("ScrollingFrame", MainFrame)
    Sidebar.Size = UDim2.new(0.25, 0, 0.88, 0)
    Sidebar.Position = UDim2.new(0.75, 0, 0.12, 0)
    Sidebar.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Sidebar
    Sidebar.BorderSizePixel = 0
    Sidebar.ScrollBarThickness = 4

    local SidebarLayout = Instance.new("UIListLayout", Sidebar)
    SidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    SidebarLayout.Padding = UDim.new(0, 5)

    -- Контейнер для содержимого
    local Container = Instance.new("Frame", MainFrame)
    Container.Size = UDim2.new(0.75, 0, 0.88, 0)
    Container.Position = UDim2.new(0, 0, 0.12, 0)
    Container.BackgroundTransparency = 1

    -- Скрытие / открытие UI по клавише
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Library.ToggleKey then
            MainFrame.Visible = not MainFrame.Visible
        end
    end)

    local Window = { Tabs = {} }

    -- Функция добавления вкладки
    function Window:CreateTab(name)
        local TabBtn = Instance.new("TextButton", Sidebar)
        TabBtn.Size = UDim2.new(0.9, 0, 0, 35)
        TabBtn.Text = name
        TabBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
        TabBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
        TabBtn.Font = Enum.Font.Gotham

        local Page = Instance.new("ScrollingFrame", Container)
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.Visible = false
        Page.BackgroundTransparency = 1
        Page.ScrollBarThickness = 4

        local PageLayout = Instance.new("UIListLayout", Page)
        PageLayout.Padding = UDim.new(0, 8)

        TabBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(Container:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            Page.Visible = true
        end)

        local TabElements = {}

        -- 1. Переключатель (Toggle) без бинда
        function TabElements:CreateToggle(text, default, callback)
            local state = default or false
            local ToggleBtn = Instance.new("TextButton", Page)
            ToggleBtn.Size = UDim2.new(0.95, 0, 0, 40)
            ToggleBtn.Text = text .. ": " .. (state and "ON" or "OFF")
            ToggleBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
            ToggleBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text
            
            ToggleBtn.MouseButton1Click:Connect(function()
                state = not state
                ToggleBtn.Text = text .. ": " .. (state and "ON" or "OFF")
                pcall(callback, state)
            end)
        end

        -- 2. Переключатель с биндом (Keybind Toggle)
        function TabElements:CreateKeybindToggle(text, defaultKey, callback)
            local currentKey = defaultKey or Enum.KeyCode.E
            local state = false
            
            local KeybindBtn = Instance.new("TextButton", Page)
            KeybindBtn.Size = UDim2.new(0.95, 0, 0, 40)
            KeybindBtn.Text = text .. " [" .. currentKey.Name .. "]: OFF"
            KeybindBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
            KeybindBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text

            KeybindBtn.MouseButton1Click:Connect(function()
                state = not state
                KeybindBtn.Text = text .. " [" .. currentKey.Name .. "]: " .. (state and "ON" or "OFF")
                pcall(callback, state)
            end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if not gpe and input.KeyCode == currentKey then
                    state = not state
                    KeybindBtn.Text = text .. " [" .. currentKey.Name .. "]: " .. (state and "ON" or "OFF")
                    pcall(callback, state)
                end
            end)
        end

        -- 3. Ползунок (Slider)
        function TabElements:CreateSlider(text, min, max, default, callback)
            local value = default or min
            local SliderFrame = Instance.new("Frame", Page)
            SliderFrame.Size = UDim2.new(0.95, 0, 0, 50)
            SliderFrame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element

            local Label = Instance.new("TextLabel", SliderFrame)
            Label.Size = UDim2.new(1, 0, 0.5, 0)
            Label.Text = text .. ": " .. tostring(value)
            Label.TextColor3 = Library.Themes[Library.CurrentTheme].Text
            Label.BackgroundTransparency = 1

            -- Логика перетаскивания ползунка (упрощенная)
            SliderFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    -- Расчет значения на основе позиции
                    value = math.clamp(math.floor(min + (max - min) * 0.5), min, max)
                    Label.Text = text .. ": " .. tostring(value)
                    pcall(callback, value)
                end
            end)
        end

        -- 4. Выпадающий список (Dropdown)
        function TabElements:CreateDropdown(text, options, multiSelect, callback)
            local selected = {}
            local DropdownBtn = Instance.new("TextButton", Page)
            DropdownBtn.Size = UDim2.new(0.95, 0, 0, 40)
            DropdownBtn.Text = text .. " (Select)"
            DropdownBtn.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Element
            DropdownBtn.TextColor3 = Library.Themes[Library.CurrentTheme].Text

            -- Внутренняя логика показа вариантов и выбора
            DropdownBtn.MouseButton1Click:Connect(function()
                -- Переключение видимости списка опций
            end)
        end

        return TabElements
    end

    return Window
end

return Library
