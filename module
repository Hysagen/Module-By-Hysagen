    -- Функция обновления CanvasSize
    local function updatePagesCanvas()
        if not pages or next(pages) == nil then
            pagesScrolling.CanvasSize = UDim2.new(0, 0, 0, 16)
            return
        end
        
        local totalHeight = 16
        for _, data in pairs(pages) do
            if data.Frame and data.Frame.Visible then
                totalHeight = totalHeight + data.Frame.Size.Y.Offset + 4
            end
        end
        pagesScrolling.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
    end
    
    -- === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ===
    local function createElementContainer(parent)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 44)
        frame.BackgroundTransparency = 1
        frame.Parent = parent
        
        -- Обновляем размер страницы при добавлении элементов
        task.wait(0.05)
        if parent and parent.Parent then
            -- Находим страницу
            local page = parent
            while page and page.Name ~= "PageFrame" and not page:IsA("ScrollingFrame") do
                page = page.Parent
            end
            if page and page.Parent and pages then
                for name, data in pairs(pages) do
                    if data.Frame == page then
                        updatePagesCanvas()
                        break
                    end
                end
            end
        end
        
        return frame
    end
    
    -- === 1) КНОПКА С БИНДОМ (выключена по умолчанию) ===
    function UIFramework:CreateToggleWithBind(page, label, defaultState, bindKey)
        defaultState = defaultState or false
        local container = createElementContainer(page)
        
        local toggleFrame = Instance.new("Frame")
        toggleFrame.Size = UDim2.new(1, -16, 0, 36)
        toggleFrame.Position = UDim2.new(0, 8, 0, 4)
        toggleFrame.BackgroundColor3 = COLORS.TabInactive
        toggleFrame.BackgroundTransparency = 0
        toggleFrame.BorderSizePixel = 0
        toggleFrame.Parent = container
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = toggleFrame
        
        local labelText = Instance.new("TextLabel")
        labelText.Size = UDim2.new(0.6, 0, 1, 0)
        labelText.Position = UDim2.new(0, 8, 0, 0)
        labelText.BackgroundTransparency = 1
        labelText.Text = label .. " [" .. string.upper(bindKey) .. "]"
        labelText.TextColor3 = COLORS.Text
        labelText.TextSize = 14
        labelText.TextXAlignment = Enum.TextXAlignment.Left
        labelText.Font = Enum.Font.GothamSemibold
        labelText.Parent = toggleFrame
        
        local state = defaultState
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 60, 0, 28)
        btn.Position = UDim2.new(1, -68, 0.5, -14)
        btn.BackgroundColor3 = state and COLORS.Green or COLORS.Red
        btn.BackgroundTransparency = 0
        btn.BorderSizePixel = 0
        btn.Text = state and "ON" or "OFF"
        btn.TextColor3 = COLORS.Text
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.Parent = toggleFrame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        local function toggle()
            state = not state
            btn.BackgroundColor3 = state and COLORS.Green or COLORS.Red
            btn.Text = state and "ON" or "OFF"
        end
        
        btn.MouseButton1Click:Connect(toggle)
        
        local connection
        connection = game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == Enum.KeyCode[bindKey] then
                toggle()
            end
        end)
        
        task.wait(0.05)
        updatePagesCanvas()
        
        return {
            Toggle = toggle,
            SetState = function(newState)
                state = newState
                btn.BackgroundColor3 = state and COLORS.Green or COLORS.Red
                btn.Text = state and "ON" or "OFF"
            end,
            GetState = function() return state end,
            Connection = connection
        }
    end
    
