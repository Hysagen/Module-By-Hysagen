            glowCorner2.CornerRadius = UDim.new(1, 0)
            
            local function Update(mouseX)
                local barX = SliderBack.AbsolutePosition.X
                local barW = SliderBack.AbsoluteSize.X
                local perc = math.clamp((mouseX - barX) / barW, 0, 1)
                local val = min + (max - min) * perc
                local rounded = math.floor(val * 10) / 10
                
                SliderFill.Size = UDim2.new(perc, 0, 1, 0)
                T.Text = text .. ": " .. rounded
                valueLabel.Text = tostring(rounded)
                Value = rounded
                
                if callback then callback(rounded) end
            end
            
            local dragging = false
            
            local backInput = SliderBack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    _G.IsDraggingSlider = true
                    Update(input.Position.X)
                    playSound("9120332383")
                end
            end)
            table.insert(Library.Connections, backInput)
            
            local knobInput = SliderKnob.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    _G.IsDraggingSlider = true
                end
            end)
            table.insert(Library.Connections, knobInput)
            
            local ended = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    _G.IsDraggingSlider = false
                end
            end)
            table.insert(Library.Connections, ended)
            
            local changed = UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    Update(input.Position.X)
                end
            end)
            table.insert(Library.Connections, changed)
            
            table.insert(self.Elements, Row)
            return Row
        end
        
