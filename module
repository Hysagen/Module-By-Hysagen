    -- ========== THEME SYSTEM ==========
    local function ApplyTheme(theme, themeName, animate)
        CurrentTheme = theme
        Library.CurrentTheme = themeName
        animate = animate ~= false
        
        local tInfo = TweenInfo.new(animate and 0.5 or 0, Enum.EasingStyle.Quart)
        
        -- Main
        if Main then
            TweenService:Create(Main, tInfo, {
                BackgroundColor3 = theme.Main,
                BackgroundTransparency = 0.05
            }):Play()
            
            local b = Main:FindFirstChildWhichIsA("UIStroke")
            if b then
                TweenService:Create(b, tInfo, {
                    Color = theme.Border,
                    Transparency = 0.3
                }):Play()
            end
        end
        
        -- Sidebar & TitleBar
        for _, obj in pairs({Sidebar, TitleBar}) do
            if obj then
                TweenService:Create(obj, tInfo, {
                    BackgroundColor3 = theme.Sidebar,
                    BackgroundTransparency = 0.1
                }):Play()
                
                local s = obj:FindFirstChildWhichIsA("UIStroke")
                if s then
                    TweenService:Create(s, tInfo, {
                        Color = theme.Border,
                        Transparency = 0.4
                    }):Play()
                end
            end
        end
        
        -- Tab Buttons
        for _, btn in pairs(Library.TabButtons) do
            if btn:GetAttribute("Active") then
                TweenService:Create(btn, tInfo, {
                    BackgroundColor3 = theme.Accent,
                    TextColor3 = theme.BtnText
                }):Play()
            else
                TweenService:Create(btn, tInfo, {
                    BackgroundColor3 = theme.Secondary,
                    TextColor3 = theme.Text
                }):Play()
            end
        end
        
        -- Elements
        for _, element in pairs(Library.Elements) do
            if element and element.Type and element.UpdateTheme then
                element:UpdateTheme(theme)
            end
        end
        
        -- Title icon
        if titleIcon then
            TweenService:Create(titleIcon, tInfo, {
                TextColor3 = theme.Accent
            }):Play()
        end
        
        if titleLabel then
            TweenService:Create(titleLabel, tInfo, {
                TextColor3 = theme.Text
            }):Play()
        end
        
        -- Save theme
        if themeName then
            saveData(CONFIG.ThemeFile, { theme = themeName })
        end
        
        -- Notification
        if animate then
            _G.Notify("Theme applied: " .. themeName, "success", 2)
        end
    end
    
