-- Название модуля: UIFramework (или как хочешь)
local UIFramework = {}

-- Конфиг для красоты
local COLORS = {
    Background = Color3.fromRGB(30, 30, 36),
    TopBar = Color3.fromRGB(45, 45, 54),
    Accent = Color3.fromRGB(0, 150, 255),
    TabInactive = Color3.fromRGB(45, 45, 54),
    TabActive = Color3.fromRGB(60, 60, 72),
    Text = Color3.fromRGB(255, 255, 255),
    TextDim = Color3.fromRGB(180, 180, 195),
}

local function createMainFrame(title)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "UIFramework"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    
    -- Главное окно
    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.new(0, 600, 0, 400)
    mainFrame.Position = UDim2.new(0.5, -300, 0.5, -200) -- По центру
    mainFrame.BackgroundColor3 = COLORS.Background
    mainFrame.BackgroundTransparency = 0
    mainFrame.BorderSizePixel = 0
    mainFrame.ClipsDescendants = true
    mainFrame.Parent = screenGui
    
    -- Скругление углов (UIStroke для современного вида)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = mainFrame
    
    -- Тень (лёгкая, через прозрачный фрейм)
    local shadow = Instance.new("Frame")
    shadow.Size = UDim2.new(1, 0, 1, 0)
    shadow.Position = UDim2.new(0, 8, 0, 8)
    shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    shadow.BackgroundTransparency = 0.5
    shadow.BorderSizePixel = 0
    shadow.ZIndex = 0
    shadow.Parent = mainFrame
    
    local shadowCorner = Instance.new("UICorner")
    shadowCorner.CornerRadius = UDim.new(0, 8)
    shadowCorner.Parent = shadow
    
    -- Верхняя панель (для перетаскивания)
    local topBar = Instance.new("Frame")
    topBar.Name = "TopBar"
    topBar.Size = UDim2.new(1, 0, 0, 36)
    topBar.BackgroundColor3 = COLORS.TopBar
    topBar.BackgroundTransparency = 0
    topBar.BorderSizePixel = 0
    topBar.Parent = mainFrame
    
    local topCorner = Instance.new("UICorner")
    topCorner.CornerRadius = UDim.new(0, 8)
    topCorner.Parent = topBar
    
    -- Заголовок
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -50, 1, 0)
    titleLabel.Position = UDim2.new(0, 12, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title or "UI Framework"
    titleLabel.TextColor3 = COLORS.Text
    titleLabel.TextSize = 16
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Parent = topBar
    
    -- Кнопка закрытия (опционально, но пригодится)
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -36, 0, 3)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = COLORS.TextDim
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.Parent = topBar
    closeBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = false
    end)
    
    -- Основной контейнер (делит окно на левую и правую часть)
    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, 0, 1, -36)
    container.Position = UDim2.new(0, 0, 0, 36)
    container.BackgroundTransparency = 1
    container.Parent = mainFrame
    
    -- ЛЕВАЯ ПАНЕЛЬ (вкладки)
    local leftPanel = Instance.new("Frame")
    leftPanel.Name = "LeftPanel"
    leftPanel.Size = UDim2.new(0, 180, 1, 0)
    leftPanel.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    leftPanel.BackgroundTransparency = 0
    leftPanel.BorderSizePixel = 0
    leftPanel.Parent = container
    
    local leftCorner = Instance.new("UICorner")
    leftCorner.CornerRadius = UDim.new(0, 0) -- Слева углы не скругляем, чтобы стык был ровный
    leftCorner.Parent = leftPanel
    
    -- Скроллинг для левой панели (если вкладок будет много)
    local leftScrolling = Instance.new("ScrollingFrame")
    leftScrolling.Size = UDim2.new(1, 0, 1, 0)
    leftScrolling.BackgroundTransparency = 1
    leftScrolling.BorderSizePixel = 0
    leftScrolling.ScrollBarThickness = 4
    leftScrolling.ScrollBarImageColor3 = COLORS.Accent
    leftScrolling.CanvasSize = UDim2.new(0, 0, 0, 0) -- Будет расширяться динамически
    leftScrolling.Parent = leftPanel
    
    local leftLayout = Instance.new("UIListLayout")
    leftLayout.Padding = UDim.new(0, 4)
    leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    leftLayout.Parent = leftScrolling
    
    -- ПРАВАЯ ПАНЕЛЬ (контент)
    local rightPanel = Instance.new("Frame")
    rightPanel.Name = "RightPanel"
    rightPanel.Size = UDim2.new(1, -180, 1, 0)
    rightPanel.Position = UDim2.new(0, 180, 0, 0)
    rightPanel.BackgroundColor3 = COLORS.Background
    rightPanel.BackgroundTransparency = 0
    rightPanel.BorderSizePixel = 0
    rightPanel.Parent = container
    
    local rightCorner = Instance.new("UICorner")
    rightCorner.CornerRadius = UDim.new(0, 0) -- Справа тоже ровный стык
    rightCorner.Parent = rightPanel
    
    -- Контейнер для страниц (все страницы лежат тут, но видна только одна)
    local pagesContainer = Instance.new("Frame")
    pagesContainer.Name = "PagesContainer"
    pagesContainer.Size = UDim2.new(1, 0, 1, 0)
    pagesContainer.BackgroundTransparency = 1
    pagesContainer.Parent = rightPanel
    
    -- Словарь для хранения страниц
    local pages = {}
    local activePage = nil
    
    -- === ФУНКЦИИ ДЛЯ РАБОТЫ С МОДУЛЕМ ===
    
    -- Создание новой страницы (вкладки)
    function UIFramework:CreatePage(name, icon)
        local pageFrame = Instance.new("Frame")
        pageFrame.Name = name
        pageFrame.Size = UDim2.new(1, 0, 1, 0)
        pageFrame.BackgroundTransparency = 1
        pageFrame.Visible = false
        pageFrame.Parent = pagesContainer
        
        -- UIListLayout для контента на странице (чтобы удобно добавлять элементы)
        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 8)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = pageFrame
        
        -- Кнопка в левой панели
        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = name .. "Tab"
        tabBtn.Size = UDim2.new(1, -12, 0, 36)
        tabBtn.Position = UDim2.new(0, 6, 0, 0)
        tabBtn.BackgroundColor3 = COLORS.TabInactive
        tabBtn.BackgroundTransparency = 0
        tabBtn.BorderSizePixel = 0
        tabBtn.Text = name
        tabBtn.TextColor3 = COLORS.TextDim
        tabBtn.TextSize = 14
        tabBtn.TextXAlignment = Enum.TextXAlignment.Left
        tabBtn.TextTruncate = Enum.TextTruncate.AtEnd
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.Parent = leftScrolling
        
        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 4)
        tabCorner.Parent = tabBtn
        
        -- Иконка слева от текста (если передана)
        if icon then
            local iconLabel = Instance.new("TextLabel")
            iconLabel.Size = UDim2.new(0, 24, 1, 0)
            iconLabel.Position = UDim2.new(0, 6, 0, 0)
            iconLabel.BackgroundTransparency = 1
            iconLabel.Text = icon
            iconLabel.TextColor3 = COLORS.TextDim
            iconLabel.TextSize = 16
            iconLabel.TextXAlignment = Enum.TextXAlignment.Center
            iconLabel.Font = Enum.Font.GothamBold
            iconLabel.Parent = tabBtn
            
            -- Сдвигаем текст вправо
            tabBtn.Text = "   " .. name
        end
        
        -- Обновляем CanvasSize для скролла
        leftScrolling.CanvasSize = UDim2.new(0, 0, 0, leftScrolling.CanvasSize.Y.Offset + 40)
        
        -- Клик по вкладке
        tabBtn.MouseButton1Click:Connect(function()
            UIFramework:SwitchPage(name)
        end)
        
        -- Сохраняем
        pages[name] = {
            Frame = pageFrame,
            Button = tabBtn,
            Layout = pageLayout
        }
        
        -- Если это первая страница - делаем активной
        if not activePage then
            UIFramework:SwitchPage(name)
        end
        
        return pageFrame, pageLayout
    end
    
    -- Переключение страницы
    function UIFramework:SwitchPage(name)
        if not pages[name] then return end
        
        -- Прячем все страницы
        for _, data in pairs(pages) do
            data.Frame.Visible = false
            data.Button.BackgroundColor3 = COLORS.TabInactive
            data.Button.TextColor3 = COLORS.TextDim
        end
        
        -- Показываем нужную
        pages[name].Frame.Visible = true
        pages[name].Button.BackgroundColor3 = COLORS.TabActive
        pages[name].Button.TextColor3 = COLORS.Text
        activePage = name
    end
    
    -- Перетаскивание окна
    local dragging = false
    local dragStart, startPos
    
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    
    topBar.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    topBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Возвращаем всё необходимое
    return {
        MainFrame = mainFrame,
        TopBar = topBar,
        LeftPanel = leftScrolling,
        RightPanel = rightPanel,
        PagesContainer = pagesContainer,
        CreatePage = UIFramework.CreatePage,
        SwitchPage = UIFramework.SwitchPage,
        Pages = pages,
        ScreenGui = screenGui
    }
end

-- Главная функция модуля
function UIFramework.New(title)
    return createMainFrame(title or "UI Framework")
end

return UIFramework
