--  PERSISTENCE
-- █████████████████████████████████████████████████████████████████

local function loadSavedTheme()
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG.THEME_FILE))
    end)
    if success and result and result.theme and Themes[result.theme] then
        return result.theme
    end
    return CONFIG.DEFAULT_THEME
end

local function saveTheme(themeName, windowState)
    local settings = {
        theme = themeName,
        window = windowState,
        savedAt = DateTime.now():ToIsoDate(),
        version = "3.0"
    }
    pcall(function() writefile(CONFIG.THEME_FILE, HttpService:JSONEncode(settings)) end)
end

