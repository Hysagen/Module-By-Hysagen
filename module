            arrow.Text = Open and "▲" or "▼"
            
            TweenService:Create(OptionsContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
                Size = UDim2.new(0.45, 0, 0, targetHeight)
            }):Play()
        end
        
        local function SelectOption(option)
            Selected = option
            DropdownBtn.Text = option
            
            if callback then callback(option) end
            
            -- Save value
            if not Library.SavedSettings then Library.SavedSettings = {} end
            Library.SavedSettings[text.."_dropdown"] = option
            saveData(CONFIG.SettingsFile, Library.SavedSettings)
            
            ToggleDropdown()
        end
        
        -- Создание опций
        for _, option in ipairs(options) do
            local optBtn = Instance.new("TextButton", OptionsContainer)
            optBtn.Size = UDim2.new(1, -8, 0, 28)
            optBtn.Position = UDim2.new(0, 4, 0, 0)
            optBtn.BackgroundTransparency = 1
            optBtn.Text = option
            optBtn.TextColor3 = CurrentTheme.Text
            optBtn.Font = Enum.Font.GothamMedium
            optBtn.TextSize = 13
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.AutoButtonColor = false
            optBtn.ZIndex = 3
            
            -- Hover
            optBtn.MouseEnter:Connect(function()
                TweenService:Create(optBtn, TweenInfo.new(0.15), {
                    BackgroundTransparency = 0.7,
                    BackgroundColor3 = CurrentTheme.Accent,
                    TextColor3 = CurrentTheme.BtnText
                }):Play()
            end)
            
            optBtn.MouseLeave:Connect(function()
                TweenService:Create(optBtn, TweenInfo.new(0.15), {
                    BackgroundTransparency = 1,
                    BackgroundColor3 = Color3.fromRGB(0, 0, 0),
                    TextColor3 = CurrentTheme.Text
                }):Play()
            end)
            
            optBtn.MouseButton1Click:Connect(function()
                SelectOption(option)
            end)
        end
        
        local dropdownClick = DropdownBtn.MouseButton1Click:Connect(ToggleDropdown)
        table.insert(Library.Connections, dropdownClick)
        
        -- Скрыть при клике вне
        local outsideClick = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and Open then
                local mousePos = input.Position
                local absPos = DropdownBtn.AbsolutePosition
                local absSize = DropdownBtn.AbsoluteSize
                
                local inBtn = mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and
                             mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y
                
                if not inBtn then
                    ToggleDropdown()
                end
            end
        end)
        table.insert(Library.Connections, outsideClick)
        
        table.insert(Library.Elements, {
            Type = "Dropdown",
            Row = Row,
            Button = DropdownBtn,
            Label = L,
            Container = OptionsContainer,
            UpdateTheme = function(theme)
                TweenService:Create(Row, TweenInfo.new(0.3), {
                    BackgroundColor3 = theme.Card,
                }):Play()
                TweenService:Create(rowStroke, TweenInfo.new(0.3), {
                    Color = theme.Border
                }):Play()
                TweenService:Create(L, TweenInfo.new(0.3), {
                    TextColor3 = theme.Text
                }):Play()
                TweenService:Create(DropdownBtn, TweenInfo.new(0.3), {
                    BackgroundColor3 = theme.Secondary,
                    TextColor3 = theme.Text
                }):Play()
                TweenService:Create(dropdownStroke, TweenInfo.new(0.3), {
                    Color = theme.Border
                }):Play()
                TweenService:Create(arrow, TweenInfo.new(0.3), {
                    TextColor3 = theme.Text
                }):Play()
                TweenService:Create(OptionsContainer, TweenInfo.new(0.3), {
                    BackgroundColor3 = theme.Secondary
                }):Play()
                TweenService:Create(optStroke, TweenInfo.new(0.3), {
                    Color = theme.Border
                }):Play()
                
                for _, child in pairs(OptionsContainer:GetChildren()) do
                    if child:IsA("TextButton") then
                        TweenService:Create(child, TweenInfo.new(0.3), {
                            TextColor3 = theme.Text
                        }):Play()
                    end
                end
            end
        })
    end
    
    function TabBase:AddKeybind(text, defaultKey, callback)
        self.Count = self.Count + 1
        local CurrentKey = defaultKey or Enum.KeyCode.E
        local Binding = false
        
        -- Load saved key
        if Library.SavedSettings and Library.SavedSettings[text.."_key"] then
            CurrentKey = Enum.KeyCode[Library.SavedSettings[text.."_key"]] or defaultKey or Enum.KeyCode.E
        end
        
        local Row = Instance.new("Frame", self.Page)
        Row.Size = UDim2.new(1, -10, 0, 52)
        Row.BackgroundColor3 = CurrentTheme.Card
        Row.BackgroundTransparency = 0.3
        Row.LayoutOrder = self.Count
        
        local rowCorner = Instance.new("UICorner", Row)
        rowCorner.CornerRadius = UDim.new(0, 10)
        
        local rowStroke = Instance.new("UIStroke", Row)
        rowStroke.Thickness = 1
        rowStroke.Color = CurrentTheme.Border
        rowStroke.Transparency = 0.2
        
        local L = Instance.new("TextLabel", Row)
        L.Size = UDim2.new(0.4, 0, 1, 0)
        L.Position = UDim2.new(0, 16, 0, 0)
        L.Text = text
        L.TextColor3 = CurrentTheme.Text
        L.Font = Enum.Font.GothamMedium
        L.TextSize = 15
        L.BackgroundTransparency = 1
        L.TextXAlignment = Enum.TextXAlignment.Left
        
        local KeyBtn = Instance.new("TextButton", Row)
        KeyBtn.Size = UDim2.new(0.35, 0, 0, 34)
        KeyBtn.Position = UDim2.new(0.5, 0, 0.5, -17)
        KeyBtn.BackgroundColor3 = CurrentTheme.Accent
        KeyBtn.Text = CurrentKey.Name
        KeyBtn.TextColor3 = CurrentTheme.BtnText
        KeyBtn.Font = Enum.Font.GothamBold
        KeyBtn.TextSize = 14
        KeyBtn.AutoButtonColor = false
        KeyBtn.ZIndex = 2
        
        local keyCorner = Instance.new("UICorner", KeyBtn)
        keyCorner.CornerRadius = UDim.new(0, 8)
        
        local function SetKey(key)
            CurrentKey = key
            KeyBtn.Text = key.Name
            
            -- Save key
            if not Library.SavedSettings then Library.SavedSettings = {} end
            Library.SavedSettings[text.."_key"] = key.Name
            saveData(CONFIG.SettingsFile, Library.SavedSettings)
            
            if callback then callback(key) end
        end
        
        local click = KeyBtn.MouseButton1Click:Connect(function()
            Binding = true
            KeyBtn.Text = "..."
            KeyBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
            
            local conn
            conn = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    Binding = false
                    SetKey(input.KeyCode)
                    KeyBtn.BackgroundColor3 = CurrentTheme.Accent
                    if conn then conn:Disconnect() end
                end
            end)
            table.insert(Library.Connections, conn)
            
            task.delay(5, function()
                if Binding then
                    Binding = false
                    KeyBtn.Text = CurrentKey.Name
                    KeyBtn.BackgroundColor3 = CurrentTheme.Accent
                    if conn then conn:Disconnect() end
                end
            end)
        end)
        table.insert(Library.Connections, click)
        
        table.insert(Library.Elements, {
            Type = "Keybind",
            Row = Row,
            Button = KeyBtn,
            Label = L,
            Key = CurrentKey,
            SetKey = SetKey,
            UpdateTheme = function(theme)
                TweenService:Create(Row, TweenInfo.new(0.3), {
                    BackgroundColor3 = theme.Card,
                }):Play()
                TweenService:Create(rowStroke, TweenInfo.new(0.3), {
                    Color = theme.Border
                }):Play()
                TweenService:Create(L, TweenInfo.new(0.3), {
                    TextColor3 = theme.Text
                }):Play()
                TweenService:Create(KeyBtn, TweenInfo.new(0.3), {
                    BackgroundColor3 = theme.Accent,
                    TextColor3 = theme.BtnText
                }):Play()
            end
        })
    end
    
    -- ========== CREATE TAB ==========
    function Library:CreateTab(name, icon)
        local NewTab = setmetatable({}, TabBase)
        NewTab.Count = 0
        
        local displayName = (icon or "") .. " " .. name
        
        local TabBtn = Instance.new("TextButton", SidebarScroll)
        TabBtn.Name = "TabBtn"
        TabBtn.Size = UDim2.new(0.92, 0, 0, 40)
        TabBtn.Position = UDim2.new(0.04, 0, 0, 0)
        TabBtn.BackgroundColor3 = CurrentTheme.Secondary
        TabBtn.Text = displayName
        TabBtn.TextColor3 = CurrentTheme.Text
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 14
        TabBtn.AutoButtonColor = false
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.ZIndex = 3
        
        local tabCorner = Instance.new("UICorner", TabBtn)
        tabCorner.CornerRadius = UDim.new(0, 8)
        
        local tabStroke = Instance.new("UIStroke", TabBtn)
        tabStroke.Thickness = 1
        tabStroke.Color = CurrentTheme.Border
        tabStroke.Transparency = 0.3
        
        -- Активная полоска
        local activeBar = Instance.new("Frame", TabBtn)
        activeBar.Size = UDim2.new(0, 3, 1, -8)
        activeBar.Position = UDim2.new(0, 0, 0.5, -4)
        activeBar.BackgroundColor3 = CurrentTheme.Accent
        activeBar.BackgroundTransparency = 1
        activeBar.BorderSizePixel = 0
        
        local activeCorner = Instance.new("UICorner", activeBar)
        activeCorner.CornerRadius = UDim.new(1, 0)
        
        table.insert(Library.TabButtons, TabBtn)
        
        local Page = Instance.new("ScrollingFrame", PagesFolder)
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.Visible = false
        Page.ScrollBarThickness = 0
        Page.CanvasSize = UDim2.new(0, 0, 0, 0)
        Page.Name = "Page_"..name
        Page.ZIndex = 1
        
        local List = Instance.new("UIListLayout", Page)
        List.Padding = UDim.new(0, 10)
        List.SortOrder = Enum.SortOrder.LayoutOrder
        
        local listSizeConn = List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, List.AbsoluteContentSize.Y + 20)
        end)
        table.insert(Library.Connections, listSizeConn)
        
        NewTab.Page = Page
        
        local tabClick = TabBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(PagesFolder:GetChildren()) do 
                p.Visible = false 
            end
            for _, b in pairs(Library.TabButtons) do
                b:SetAttribute("Active", false)
                TweenService:Create(b, TweenInfo.new(0.3), {
                    BackgroundColor3 = CurrentTheme.Secondary,
                    TextColor3 = CurrentTheme.Text
                }):Play()
                local bar = b:FindFirstChild("activeBar")
                if bar then
                    TweenService:Create(bar, TweenInfo.new(0.3), {
                        BackgroundTransparency = 1
                    }):Play()
                end
            end
            
            Page.Visible = true
            TabBtn:SetAttribute("Active", true)
            TweenService:Create(TabBtn, TweenInfo.new(0.3), {
                BackgroundColor3 = CurrentTheme.Accent,
                TextColor3 = CurrentTheme.BtnText
            }):Play()
            TweenService:Create(activeBar, TweenInfo.new(0.3), {
                BackgroundTransparency = 0
            }):Play()
        end)
        table.insert(Library.Connections, tabClick)
        
        -- Если первая вкладка
        if not Library._firstTab then
            Library._firstTab = true
            Page.Visible = true
            TabBtn:SetAttribute("Active", true)
            TabBtn.BackgroundColor3 = CurrentTheme.Accent
            TabBtn.TextColor3 = CurrentTheme.BtnText
            activeBar.BackgroundTransparency = 0
        end
        
        return NewTab
    end
    
    -- ========== THEMES TAB ==========
    local ThemesTab = Library:CreateTab("Themes", "🎨")
    ThemesTab:AddSection("Select Theme")
    
    for name, data in pairs(Themes) do
        ThemesTab:AddButton(name, function()
            ApplyTheme(data, name, true)
        end)
    end
    
    -- ========== SETTINGS TAB ==========
    local SettingsTab = Library:CreateTab("Settings", "⚙️")
    SettingsTab:AddSection("UI Settings")
    
    -- Keybind для показа/скрытия UI
    SettingsTab:AddKeybind("Toggle UI", _G.UI_Keybind, function(key)
        _G.UI_Keybind = key
    end)
    
    -- ========== GLOBAL KEYBIND ==========
    local toggleConnection = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == _G.UI_Keybind then
                _G.UI_Active = not _G.UI_Active
                ScreenGui.Enabled = _G.UI_Active
                
                if _G.UI_Active then
                    _G.Notify("UI Enabled", "info", 1)
                else
                    _G.Notify("UI Disabled", "warning", 1)
                end
            end
        end
    end)
    table.insert(Library.Connections, toggleConnection)
    
    -- ========== ADD DEFAULT ELEMENTS ==========
    -- Информационная вкладка
    local InfoTab = Library:CreateTab("Info", "ℹ️")
    InfoTab:AddLabel("Welcome to Hysagen UI v2.0")
    InfoTab:AddLabel(" ")
    InfoTab:AddLabel("✦ Fully customizable UI framework")
    InfoTab:AddLabel("✦ 15+ beautiful themes")
    InfoTab:AddLabel("✦ Advanced notification system")
    InfoTab:AddLabel("✦ Settings auto-save")
    InfoTab:AddLabel("✦ Global keybind support")
    
    -- ========== DESTROY ==========
    function Library:Destroy()
        for _, c in ipairs(Library.Connections) do 
            if c and c.Disconnect then c:Disconnect() end 
        end
        ScreenGui:Destroy()
        _G.UI_Active = false
    end
    
    -- Приветственное уведомление
    task.delay(0.5, function()
        _G.Notify("✨ " .. (hubTitle or "Hysagen UI") .. " loaded!", "success", 3)
    end)
    
    return Library
end

-- Возвращаем модуль
return UI_Module
