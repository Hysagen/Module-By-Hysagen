            local elemCorner = Instance.new("UICorner")
            elemCorner.CornerRadius = UDim.new(0, 5)
            elemCorner.Parent = elem

            -- Метка
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.6, 0, 1, 0)
            lbl.Position = UDim2.new(0, 5, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = label
            lbl.TextColor3 = Themes[CurrentTheme].Text
            lbl.TextSize = 14
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Font = Enum.Font.GothamMedium
            lbl.Parent = elem

            -- Кнопка тогла
            local toggleBtn = Instance.new("TextButton")
            toggleBtn.Size = UDim2.new(0, 50, 0, 25)
            toggleBtn.Position = UDim2.new(1, -55, 0, 7.5)
            toggleBtn.BackgroundColor3 = default and Themes[CurrentTheme].ToggleOn or Themes[CurrentTheme].ToggleOff
            toggleBtn.Text = default and "ON" or "OFF"
            toggleBtn.TextColor3 = Color3.new(1,1,1)
            toggleBtn.TextSize = 12
            toggleBtn.Font = Enum.Font.GothamBold
            toggleBtn.BorderSizePixel = 0
            toggleBtn.Parent = elem
            local togCorner = Instance.new("UICorner")
            togCorner.CornerRadius = UDim.new(0, 5)
            togCorner.Parent = toggleBtn

            local state = default
            toggleBtn.MouseButton1Click:Connect(function()
                state = not state
                toggleBtn.BackgroundColor3 = state and Themes[CurrentTheme].ToggleOn or Themes[CurrentTheme].ToggleOff
                toggleBtn.Text = state and "ON" or "OFF"
                if cfg.OnToggle then
                    cfg.OnToggle(state)
                end
            end)

            -- Привязка клавиши
            if bindKey then
                game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
                    if not gameProcessed and input.KeyCode == bindKey then
                        state = not state
                        toggleBtn.BackgroundColor3 = state and Themes[CurrentTheme].ToggleOn or Themes[CurrentTheme].ToggleOff
                        toggleBtn.Text = state and "ON" or "OFF"
                        if cfg.OnToggle then
                            cfg.OnToggle(state)
                        end
                    end
                end)
            end

            table.insert(tab._elements, elem)
            -- Если эта вкладка активна, показываем сразу
            if currentTab == tab then
                local clone = elem:Clone()
                clone.Parent = leftPanel
            end
        end

        function tab:AddSlider(label, cfg)
            cfg = cfg or {}
            local min = cfg.Min or 0
            local max = cfg.Max or 100
            local default = cfg.Default or (min + max)/2

            local elem = Instance.new("Frame")
            elem.Size = UDim2.new(1, -10, 0, 50)
            elem.BackgroundColor3 = Themes[CurrentTheme].Frame
            elem.BackgroundTransparency = 0.3
            elem.BorderSizePixel = 0
            local elemCorner = Instance.new("UICorner")
            elemCorner.CornerRadius = UDim.new(0, 5)
            elemCorner.Parent = elem

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.5, 0, 0.4, 0)
            lbl.Position = UDim2.new(0, 5, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = label .. ": " .. tostring(default)
            lbl.TextColor3 = Themes[CurrentTheme].Text
            lbl.TextSize = 14
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Font = Enum.Font.GothamMedium
            lbl.Parent = elem

            -- Слайдер
            local sliderBg = Instance.new("Frame")
            sliderBg.Size = UDim2.new(0.8, 0, 0.2, 0)
            sliderBg.Position = UDim2.new(0.1, 0, 0.6, 0)
            sliderBg.BackgroundColor3 = Themes[CurrentTheme].Background
            sliderBg.BorderSizePixel = 0
            sliderBg.Parent = elem
            local sliderCorner = Instance.new("UICorner")
            sliderCorner.CornerRadius = UDim.new(0, 3)
            sliderCorner.Parent = sliderBg

            local sliderFill = Instance.new("Frame")
            sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            sliderFill.BackgroundColor3 = Themes[CurrentTheme].Accent
            sliderFill.BorderSizePixel = 0
            sliderFill.Parent = sliderBg
            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(0, 3)
            fillCorner.Parent = sliderFill

            local sliderBtn = Instance.new("TextButton")
            sliderBtn.Size = UDim2.new(0, 12, 0, 12)
            sliderBtn.Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6)
            sliderBtn.BackgroundColor3 = Themes[CurrentTheme].Accent
            sliderBtn.BorderSizePixel = 0
            sliderBtn.Parent = sliderBg
            local btnCorner2 = Instance.new("UICorner")
            btnCorner2.CornerRadius = UDim.new(1, 0)
            btnCorner2.Parent = sliderBtn

            local dragging = false
            sliderBtn.MouseButton1Down:Connect(function()
                dragging = true
            end)
            game:GetService("UserInputService").InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)

            local function UpdateSlider(x)
                local relX = math.clamp((x - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                local value = min + (max - min) * relX
                value = math.floor(value + 0.5) -- округление
                if value < min then value = min end
                if value > max then value = max end
                sliderFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                sliderBtn.Position = UDim2.new((value - min) / (max - min), -6, 0.5, -6)
                lbl.Text = label .. ": " .. tostring(value)
                if cfg.OnChange then
                    cfg.OnChange(value)
                end
            end

            sliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    UpdateSlider(input.Position.X)
                end
            end)
            sliderBg.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
                    UpdateSlider(input.Position.X)
                end
            end)

            table.insert(tab._elements, elem)
            if currentTab == tab then
                local clone = elem:Clone()
                clone.Parent = leftPanel
            end
        end

        function tab:AddDropdown(label, cfg)
            cfg = cfg or {}
            local options = cfg.Options or {}
            local multi = cfg.Multi or false
            local default = cfg.Default -- может быть строка или таблица

            local elem = Instance.new("Frame")
            elem.Size = UDim2.new(1, -10, 0, 40)
            elem.BackgroundColor3 = Themes[CurrentTheme].Frame
            elem.BackgroundTransparency = 0.3
            elem.BorderSizePixel = 0
            local elemCorner = Instance.new("UICorner")
            elemCorner.CornerRadius = UDim.new(0, 5)
            elemCorner.Parent = elem

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.5, 0, 1, 0)
            lbl.Position = UDim2.new(0, 5, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = label .. ": " .. (multi and "Множественный" or (default and tostring(default) or "Выбрать"))
            lbl.TextColor3 = Themes[CurrentTheme].Text
            lbl.TextSize = 14
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Font = Enum.Font.GothamMedium
            lbl.Parent = elem

            local dropBtn = Instance.new("TextButton")
            dropBtn.Size = UDim2.new(0, 30, 0, 25)
            dropBtn.Position = UDim2.new(1, -35, 0, 7.5)
            dropBtn.BackgroundColor3 = Themes[CurrentTheme].Accent
            dropBtn.Text = "▼"
            dropBtn.TextColor3 = Color3.new(1,1,1)
            dropBtn.TextSize = 12
            dropBtn.Font = Enum.Font.GothamBold
            dropBtn.BorderSizePixel = 0
            dropBtn.Parent = elem
            local dropCorner = Instance.new("UICorner")
            dropCorner.CornerRadius = UDim.new(0, 5)
            dropCorner.Parent = dropBtn

            -- Выпадающий список
            local listFrame = Instance.new("ScrollingFrame")
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.Position = UDim2.new(0, 0, 1, 5)
            listFrame.BackgroundColor3 = Themes[CurrentTheme].DropdownBg
            listFrame.BorderSizePixel = 0
            listFrame.Visible = false
            listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
            listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
            listFrame.ScrollBarThickness = 4
            listFrame.Parent = elem
            local listCorner = Instance.new("UICorner")
            listCorner.CornerRadius = UDim.new(0, 5)
            listCorner.Parent = listFrame

            local listLayout = Instance.new("UIListLayout")
            listLayout.Padding = UDim.new(0, 2)
            listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            listLayout.Parent = listFrame

            local selected = multi and (type(default) == "table" and default or {}) or default

            local function UpdateDropdownLabel()
                if multi then
                    local count = #selected
                    lbl.Text = label .. ": выбрано " .. count .. (count == 0 and "" or " (" .. table.concat(selected, ", ") .. ")")
                else
                    lbl.Text = label .. ": " .. tostring(selected or "нет")
                end
            end

            -- Создаем кнопки для каждого варианта
            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, -5, 0, 25)
                optBtn.BackgroundTransparency = 0.5
                optBtn.Text = opt
                optBtn.TextColor3 = Themes[CurrentTheme].Text
                optBtn.TextSize = 13
                optBtn.Font = Enum.Font.GothamMedium
                optBtn.BorderSizePixel = 0
                optBtn.Parent = listFrame

                optBtn.MouseButton1Click:Connect(function()
                    if multi then
                        -- Переключение
                        local index = table.find(selected, opt)
                        if index then
                            table.remove(selected, index)
                            optBtn.BackgroundTransparency = 0.5
                        else
                            table.insert(selected, opt)
                            optBtn.BackgroundTransparency = 0
                        end
                        UpdateDropdownLabel()
                        if cfg.OnSelect then
                            cfg.OnSelect(selected)
                        end
                    else
                        selected = opt
                        UpdateDropdownLabel()
                        listFrame.Visible = false
                        listFrame.Size = UDim2.new(1, 0, 0, 0)
                        if cfg.OnSelect then
                            cfg.OnSelect(selected)
                        end
                    end
                end)

                -- Если это значение выбрано по умолчанию
                if multi then
                    if table.find(selected, opt) then
                        optBtn.BackgroundTransparency = 0
                    else
                        optBtn.BackgroundTransparency = 0.5
                    end
                else
                    if selected == opt then
                        optBtn.BackgroundTransparency = 0
                    else
                        optBtn.BackgroundTransparency = 0.5
                    end
                end
            end

            dropBtn.MouseButton1Click:Connect(function()
                listFrame.Visible = not listFrame.Visible
                if listFrame.Visible then
                    -- Высота списка
                    local count = #options
                    local height = math.min(count * 27 + 5, 150)
                    listFrame.Size = UDim2.new(1, 0, 0, height)
                else
                    listFrame.Size = UDim2.new(1, 0, 0, 0)
                end
            end)

            table.insert(tab._elements, elem)
            if currentTab == tab then
                local clone = elem:Clone()
                clone.Parent = leftPanel
            end
        end

        -- Добавляем вкладку в общий список
        table.insert(tabs, tab)

        -- Если это первая вкладка, делаем её активной
        if #tabs == 1 then
            currentTab = tab
            SwitchTab(name)
        end

        return tab
    end

    -- ===== ОБНОВЛЕНИЕ ТЕМЫ ВСЕХ КОНТРОЛОВ =====
    function ApplyTheme(themeName)
        local theme = Themes[themeName]
        if not theme then return end
        -- Обновляем основные элементы
        mainFrame.BackgroundColor3 = theme.Background
        topBar.BackgroundColor3 = theme.TopBar
        titleLabel.TextColor3 = theme.Text
        settingsBtn.ImageColor3 = theme.Text
        leftPanel.BackgroundColor3 = theme.Background
        rightPanel.BackgroundColor3 = theme.Background
        settingsFrame.BackgroundColor3 = theme.Background
        settingsTitle.BackgroundColor3 = theme.TopBar
        settingsTitle.TextColor3 = theme.Text
        closeSettings.TextColor3 = theme.Text
        themeLabel.TextColor3 = theme.Text
        themeDropdown.BackgroundColor3 = theme.DropdownBg
        themeDropdown.TextColor3 = theme.Text
        themeListFrame.BackgroundColor3 = theme.DropdownBg
        keyLabel.TextColor3 = theme.Text
        keyButton.BackgroundColor3 = theme.DropdownBg
        keyButton.TextColor3 = theme.Text
        -- Обновляем все элементы вкладок
        for _, tab in ipairs(tabs) do
            for _, elem in ipairs(tab._elements) do
                -- Рекурсивно обновить все дочерние элементы
                local function updateChildren(obj)
                    for _, child in ipairs(obj:GetChildren()) do
                        if child:IsA("TextLabel") or child:IsA("TextButton") then
                            if child:FindFirstAncestor("SettingsFrame") == nil then -- не трогаем настройки
                                -- Для простоты обновляем цвет текста
                                if child:IsA("TextLabel") and child.Name ~= "Title" then
                                    child.TextColor3 = theme.Text
                                elseif child:IsA("TextButton") then
                                    if child.Name ~= "SettingsBtn" and child.Name ~= "closeSettings" then
                                        child.TextColor3 = theme.Text
                                    end
                                end
                            end
                        elseif child:IsA("Frame") then
                            if child ~= mainFrame and child ~= topBar and child ~= contentFrame and child ~= leftPanel and child ~= rightPanel and child ~= settingsFrame and child ~= settingsContent then
                                child.BackgroundColor3 = theme.Frame
                            end
                        end
                        updateChildren(child)
                    end
                end
                updateChildren(elem)
            end
        end
        -- Обновляем сами вкладки справа
        for _, child in ipairs(rightPanel:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = theme.Frame
                child.TextColor3 = theme.Text
            end
        end
    end

    -- ===== УПРАВЛЕНИЕ ПОКАЗОМ/СКРЫТИЕМ ПО КЛАВИШЕ =====
    game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == keybind then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)

    -- Возвращаем объект UI
    local self = {
        AddTab = AddTab,
        SetTheme = function(themeName)
            if Themes[themeName] then
                CurrentTheme = themeName
                SaveTheme(themeName)
                ApplyTheme(themeName)
            end
        end,
        GetTheme = function()
            return CurrentTheme
        end,
        SetKeybind = function(newKey)
            keybind = newKey
            _G.__UIKeybind = newKey
        end,
        Destroy = function()
            gui:Destroy()
        end,
        _mainFrame = mainFrame,
    }

    return self
end

return UIModule
