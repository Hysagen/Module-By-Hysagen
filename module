local UIFramework = {}

local COLORS = {
    Background = Color3.fromRGB(30, 30, 36),
    TopBar = Color3.fromRGB(45, 45, 54),
    Accent = Color3.fromRGB(0, 150, 255),
    AccentHover = Color3.fromRGB(0, 170, 255),
    TabInactive = Color3.fromRGB(40, 40, 48),
    TabActive = Color3.fromRGB(55, 55, 65),
    Text = Color3.fromRGB(255, 255, 255),
    TextDim = Color3.fromRGB(180, 180, 195),
    Red = Color3.fromRGB(255, 70, 70),
    Green = Color3.fromRGB(70, 255, 70),
}

local SCALES = {
    {name = "3:4", width = 600, height = 400, tabsLeft = true},
    {name = "1:1", width = 500, height = 500, tabsLeft = true},
    {name = "1:2", width = 700, height = 350, tabsLeft = false},
}

local function saveSettings(settings)
    if not writefile then return end
    pcall(function() writefile("UIFramework_Settings.json", game:GetService("HttpService"):JSONEncode(settings)) end)
end

local function loadSettings()
    if not readfile then return nil end
    local success, data = pcall(function() return readfile("UIFramework_Settings.json") end)
    if success and data then
        local success2, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(data) end)
        if success2 then return decoded end
    end
    return nil
end

local function createMainFrame(title)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "UIFramework"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = game:GetService("CoreGui")

    local settings = loadSettings()
    local savedScale = settings and settings.scale or "3:4"
    local savedToggleKey = settings and settings.toggleKey or "RightControl"

    local currentScale = nil
    for _, s in ipairs(SCALES) do if s.name == savedScale then currentScale = s; break end end
    if not currentScale then currentScale = SCALES[1] end

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.new(0, currentScale.width, 0, currentScale.height)
    mainFrame.Position = UDim2.new(0.5, -currentScale.width/2, 0.5, -currentScale.height/2)
    mainFrame.BackgroundColor3 = COLORS.Background
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = screenGui

    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 8)
    mainCorner.Parent = mainFrame

    local topBar = Instance.new("Frame")
    topBar.Name = "TopBar"
    topBar.Size = UDim2.new(1, 0, 0, 36)
    topBar.BackgroundColor3 = COLORS.TopBar
    topBar.BorderSizePixel = 0
    topBar.Parent = mainFrame

    local topCorner = Instance.new("UICorner")
    topCorner.CornerRadius = UDim.new(0, 8)
    topCorner.Parent = topBar

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -50, 1, 0)
    titleLabel.Position = UDim2.new(0, 12, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title or "UI Framework"
    titleLabel.TextColor3 = COLORS.Text
    titleLabel.TextSize = 16
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Parent = topBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -36, 0, 3)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = COLORS.TextDim
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.Parent = topBar
    closeBtn.MouseButton1Click:Connect(function() mainFrame.Visible = false end)

    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, 0, 1, -36)
    container.Position = UDim2.new(0, 0, 0, 36)
    container.BackgroundTransparency = 1
    container.Parent = mainFrame

    local leftPanel, leftScrolling, rightPanel, pagesScrolling, pagesContainer
    local topTabsPanel, topTabsScrolling, bottomContent, bottomScrolling, bottomContainer

    local pages = {}
    local activePage = nil
    local toggleKey = savedToggleKey
    local uiRef = nil

    local function updatePagesCanvas()
        if not pages then
            if pagesScrolling then pagesScrolling.CanvasSize = UDim2.new(0, 0, 0, 16) end
            if bottomScrolling then bottomScrolling.CanvasSize = UDim2.new(0, 0, 0, 16) end
            return
        end
        local totalHeight = 16
        for _, data in pairs(pages) do
            if data and data.Frame and data.Frame.Visible then
                totalHeight = totalHeight + data.Frame.Size.Y.Offset + 4
            end
        end
        if currentScale.tabsLeft then
            if pagesScrolling then pagesScrolling.CanvasSize = UDim2.new(0, 0, 0, totalHeight) end
        else
            if bottomScrolling then bottomScrolling.CanvasSize = UDim2.new(0, 0, 0, totalHeight) end
        end
    end

    local function buildInterface()
        for _, child in ipairs(container:GetChildren()) do child:Destroy() end
        local pagesCopy = {}
        for name, data in pairs(pages) do pagesCopy[name] = data end
        pages = {}

        if currentScale.tabsLeft then
            leftPanel = Instance.new("Frame")
            leftPanel.Size = UDim2.new(0, 180, 1, 0)
            leftPanel.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            leftPanel.BorderSizePixel = 0
            leftPanel.Parent = container
            local leftCorner = Instance.new("UICorner"); leftCorner.CornerRadius = UDim.new(0, 8); leftCorner.Parent = leftPanel
            
            leftScrolling = Instance.new("ScrollingFrame")
            leftScrolling.Size = UDim2.new(1, 0, 1, 0)
            leftScrolling.BackgroundTransparency = 1
            leftScrolling.BorderSizePixel = 0
            leftScrolling.ScrollBarThickness = 4
            leftScrolling.ScrollBarImageColor3 = COLORS.Accent
            leftScrolling.Parent = leftPanel

            local leftLayout = Instance.new("UIListLayout")
            leftLayout.Padding = UDim.new(0, 4)
            leftLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            leftLayout.Parent = leftScrolling

            rightPanel = Instance.new("Frame")
            rightPanel.Size = UDim2.new(1, -180, 1, 0)
            rightPanel.Position = UDim2.new(0, 180, 0, 0)
            rightPanel.BackgroundColor3 = COLORS.Background
            rightPanel.BorderSizePixel = 0
            rightPanel.Parent = container

            pagesScrolling = Instance.new("ScrollingFrame")
            pagesScrolling.Size = UDim2.new(1, 0, 1, 0)
            pagesScrolling.BackgroundTransparency = 1
            pagesScrolling.BorderSizePixel = 0
            pagesScrolling.ScrollBarThickness = 6
            pagesScrolling.ScrollBarImageColor3 = COLORS.Accent
            pagesScrolling.Parent = rightPanel

            pagesContainer = Instance.new("Frame")
            pagesContainer.Size = UDim2.new(1, -16, 1, 0)
            pagesContainer.Position = UDim2.new(0, 8, 0, 0)
            pagesContainer.BackgroundTransparency = 1
            pagesContainer.Parent = pagesScrolling

            for name, data in pairs(pagesCopy) do
                if data and data.Frame then data.Frame.Parent = pagesContainer; data.Frame.Visible = false end
                if data and data.Button then data.Button.Parent = leftScrolling; data.Button.Size = UDim2.new(0, 140, 0, 36) end
                pages[name] = data
            end
        else
            topTabsPanel = Instance.new("Frame")
            topTabsPanel.Size = UDim2.new(1, 0, 0, 50)
            topTabsPanel.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            topTabsPanel.BorderSizePixel = 0
            topTabsPanel.Parent = container

            topTabsScrolling = Instance.new("ScrollingFrame")
            topTabsScrolling.Size = UDim2.new(1, 0, 1, 0)
            topTabsScrolling.BackgroundTransparency = 1
            topTabsScrolling.BorderSizePixel = 0
            topTabsScrolling.Parent = topTabsPanel
            topTabsScrolling.ScrollingDirection = Enum.ScrollingDirection.X

            local topTabsLayout = Instance.new("UIListLayout")
            topTabsLayout.Padding = UDim.new(0, 4)
            topTabsLayout.FillDirection = Enum.FillDirection.Horizontal
            topTabsLayout.Parent = topTabsScrolling

            bottomContent = Instance.new("Frame")
            bottomContent.Size = UDim2.new(1, 0, 1, -50)
            bottomContent.Position = UDim2.new(0, 0, 0, 50)
            bottomContent.BackgroundColor3 = COLORS.Background
            bottomContent.BorderSizePixel = 0
            bottomContent.Parent = container

            bottomScrolling = Instance.new("ScrollingFrame")
            bottomScrolling.Size = UDim2.new(1, 0, 1, 0)
            bottomScrolling.BackgroundTransparency = 1
            bottomScrolling.BorderSizePixel = 0
            bottomScrolling.Parent = bottomContent

            bottomContainer = Instance.new("Frame")
            bottomContainer.Size = UDim2.new(1, -16, 1, 0)
            bottomContainer.Position = UDim2.new(0, 8, 0, 0)
            bottomContainer.BackgroundTransparency = 1
            bottomContainer.Parent = bottomScrolling

            for name, data in pairs(pagesCopy) do
                if data and data.Frame then data.Frame.Parent = bottomContainer; data.Frame.Visible = false end
                if data and data.Button then data.Button.Parent = topTabsScrolling; data.Button.Size = UDim2.new(0, 140, 0, 36) end
                pages[name] = data
            end
        end

        if activePage and pages[activePage] then
            if pages[activePage].Frame then pages[activePage].Frame.Visible = true end
        else
            for name, data in pairs(pages) do
                if data and data.Frame then data.Frame.Visible = true; activePage = name; break end
            end
        end
        updatePagesCanvas()
    end

    buildInterface()

    local function createElementContainer(parent)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 44)
        frame.BackgroundTransparency = 1
        frame.Parent = parent
        return frame
    end

    function UIFramework:CreateToggle(page, label, defaultState, callback)
        defaultState = defaultState or false
        local container = createElementContainer(page)

        local toggleFrame = Instance.new("Frame")
        toggleFrame.Size = UDim2.new(1, -16, 0, 36)
        toggleFrame.Position = UDim2.new(0, 8, 0, 4)
        toggleFrame.BackgroundColor3 = COLORS.TabInactive
        toggleFrame.Parent = container
        local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 4); corner.Parent = toggleFrame

        local labelText = Instance.new("TextLabel")
        labelText.Size = UDim2.new(0.6, 0, 1, 0)
        labelText.Position = UDim2.new(0, 8, 0, 0)
        labelText.BackgroundTransparency = 1
        labelText.Text = label
        labelText.TextColor3 = COLORS.Text
        labelText.TextSize = 14
        labelText.TextXAlignment = Enum.TextXAlignment.Left
        labelText.Font = Enum.Font.GothamSemibold
        labelText.Parent = toggleFrame

        local state = defaultState
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 60, 0, 28)
        btn.Position = UDim2.new(1, -68, 0.5, -14)
        btn.BackgroundColor3 = state and COLORS.Green or COLORS.Red
        btn.BorderSizePixel = 0
        btn.Text = state and "ON" or "OFF"
        btn.TextColor3 = COLORS.Text
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.Parent = toggleFrame
        local btnCorner = Instance.new("UICorner"); btnCorner.CornerRadius = UDim.new(0, 4); btnCorner.Parent = btn

        local function toggle()
            state = not state
            btn.BackgroundColor3 = state and COLORS.Green or COLORS.Red
            btn.Text = state and "ON" or "OFF"
            if callback then callback(state) end
        end

        btn.MouseButton1Click:Connect(toggle)
        task.wait(0.05); updatePagesCanvas()

        return {
            Toggle = toggle,
            SetState = function(newState)
                state = newState
                btn.BackgroundColor3 = state and COLORS.Green or COLORS.Red
                btn.Text = state and "ON" or "OFF"
                if callback then callback(state) end
            end,
            GetState = function() return state end
        }
    end

    function UIFramework:CreateDropdown(page, label, options, defaultOption, multiSelect, callback)
        multiSelect = multiSelect or false
        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, 0, 0, 44)
        container.BackgroundTransparency = 1
        container.Parent = page

        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, -16, 0, 36)
        mainBtn.Position = UDim2.new(0, 8, 0, 4)
        mainBtn.BackgroundColor3 = COLORS.TabInactive
        mainBtn.BorderSizePixel = 0
        mainBtn.Text = label .. ": " .. tostring(defaultOption or "Выберите...")
        mainBtn.TextColor3 = COLORS.Text
        mainBtn.TextSize = 13
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.Font = Enum.Font.GothamSemibold
        mainBtn.Parent = container
        local mainCorner = Instance.new("UICorner"); mainCorner.CornerRadius = UDim.new(0, 4); mainCorner.Parent = mainBtn

        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 30, 0, 36)
        arrow.Position = UDim2.new(1, -36, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▼"
        arrow.TextColor3 = COLORS.TextDim
        arrow.TextSize = 14
        arrow.TextXAlignment = Enum.TextXAlignment.Center
        arrow.Font = Enum.Font.GothamBold
        arrow.Parent = mainBtn

        local listFrame = Instance.new("Frame")
        listFrame.Size = UDim2.new(1, -16, 0, 0)
        listFrame.Position = UDim2.new(0, 8, 0, 40)
        listFrame.BackgroundColor3 = COLORS.TabInactive
        listFrame.BorderSizePixel = 0
        listFrame.Visible = false
        listFrame.Parent = container
        listFrame.ClipsDescendants = true
        local listCorner = Instance.new("UICorner"); listCorner.CornerRadius = UDim.new(0, 4); listCorner.Parent = listFrame

        local listScrolling = Instance.new("ScrollingFrame")
        listScrolling.Size = UDim2.new(1, 0, 1, 0)
        listScrolling.BackgroundTransparency = 1
        listScrolling.BorderSizePixel = 0
        listScrolling.ScrollBarThickness = 4
        listScrolling.Parent = listFrame
        
        local listLayout = Instance.new("UIListLayout")
        listLayout.Padding = UDim.new(0, 2)
        listLayout.Parent = listScrolling

        local selected = defaultOption
        local isOpen = false
        local buttons = {}

        local function updateMainText()
            if multiSelect then
                local count = 0
                if type(selected) == "table" then for _, v in pairs(selected) do if v then count = count + 1 end end end
                mainBtn.Text = label .. ": " .. (count > 0 and ("Выбрано " .. count) or "Ничего не выбрано")
            else
                mainBtn.Text = label .. ": " .. tostring(selected or "Выберите...")
            end
        end

        local function updateListSize()
            local count = 0
            for _ in pairs(buttons) do count = count + 1 end
            local maxHeight = math.min(count * 30 + 4, 150)
            listScrolling.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 4)
            listFrame.Size = UDim2.new(1, -16, 0, maxHeight)
            container.Size = UDim2.new(1, 0, 0, 44 + (isOpen and maxHeight or 0))
            task.wait(0.05); updatePagesCanvas()
        end

        for _, option in ipairs(options) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -8, 0, 28)
            btn.Position = UDim2.new(0, 4, 0, 0)
            btn.BackgroundColor3 = COLORS.TabInactive
            btn.BorderSizePixel = 0
            btn.Text = option
            btn.TextColor3 = COLORS.Text
            btn.TextSize = 13
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.GothamSemibold
            btn.Parent = listScrolling

            local btnCorner = Instance.new("UICorner"); btnCorner.CornerRadius = UDim.new(0, 3); btnCorner.Parent = btn
            local check = Instance.new("TextLabel")
            check.Size = UDim2.new(0, 20, 1, 0)
            check.Position = UDim2.new(1, -24, 0, 0)
            check.BackgroundTransparency = 1
            check.Text = "✓"
            check.TextColor3 = COLORS.Accent
            check.Visible = false
            check.Parent = btn

            buttons[option] = { Button = btn, Check = check }

            btn.MouseButton1Click:Connect(function()
                if multiSelect then
                    if type(selected) ~= "table" then selected = {} end
                    selected[option] = not selected[option]
                    check.Visible = selected[option]
                    updateMainText()
                    if callback then callback(selected) end
                else
                    selected = option
                    for opt, data in pairs(buttons) do
                        data.Button.BackgroundColor3 = COLORS.TabInactive
                        data.Check.Visible = false
                    end
                    btn.BackgroundColor3 = COLORS.Accent
                    check.Visible = true
                    updateMainText()
                    isOpen = false
                    listFrame.Visible = false
                    arrow.Text = "▼"
                    updateListSize()
                    if callback then callback(selected) end
                end
            end)
        end

        mainBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            listFrame.Visible = isOpen
            arrow.Text = isOpen and "▲" or "▼"
            updateListSize()
        end)

        updateMainText(); updateListSize()
        task.wait(0.05); updatePagesCanvas()

        return {
            GetSelected = function() return selected end,
            SetSelected = function(newValue)
                selected = newValue
                updateMainText()
                if callback then callback(selected) end
            end
        }
    end

    function UIFramework:CreatePage(name)
        local pageFrame = Instance.new("Frame")
        pageFrame.Size = UDim2.new(1, 0, 0, 0)
        pageFrame.BackgroundTransparency = 1
        pageFrame.Visible = false
        pageFrame.Parent = currentScale.tabsLeft and pagesContainer or bottomContainer

        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 4)
        pageLayout.Parent = pageFrame

        local function updatePageSize()
            local totalHeight = 16
            for _, child in ipairs(pageFrame:GetChildren()) do
                if child:IsA("Frame") then totalHeight = totalHeight + child.Size.Y.Offset + 4 end
            end
            pageFrame.Size = UDim2.new(1, 0, 0, totalHeight)
            updatePagesCanvas()
        end

        pageFrame.ChildAdded:Connect(function() task.wait(0.05); updatePageSize() end)

        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(0, 140, 0, 36)
        tabBtn.BackgroundColor3 = COLORS.TabInactive
        tabBtn.BorderSizePixel = 0
        tabBtn.Text = name
        tabBtn.TextColor3 = COLORS.TextDim
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.Parent = currentScale.tabsLeft and leftScrolling or topTabsScrolling
        local tabCorner = Instance.new("UICorner"); tabCorner.CornerRadius = UDim.new(0, 4); tabCorner.Parent = tabBtn

        tabBtn.MouseButton1Click:Connect(function() UIFramework:SwitchPage(name) end)

        pages[name] = { Frame = pageFrame, Button = tabBtn, UpdateSize = updatePageSize }
        if not activePage then activePage = name; pageFrame.Visible = true end

        task.wait(0.1); updatePageSize()
        return pageFrame, pageLayout
    end

    function UIFramework:SwitchPage(name)
        if not pages[name] then return end
        for _, data in pairs(pages) do
            if data and data.Frame then data.Frame.Visible = false end
            if data and data.Button then data.Button.BackgroundColor3 = COLORS.TabInactive; data.Button.TextColor3 = COLORS.TextDim end
        end
        if pages[name] and pages[name].Frame then pages[name].Frame.Visible = true end
        if pages[name] and pages[name].Button then pages[name].Button.BackgroundColor3 = COLORS.TabActive; pages[name].Button.TextColor3 = COLORS.Text end
        activePage = name
        task.wait(0.05); if pages[name] and pages[name].UpdateSize then pages[name]:UpdateSize() end
        updatePagesCanvas()
    end

    game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode[toggleKey] then mainFrame.Visible = not mainFrame.Visible end
    end)

    local dragging, dragStart, startPos
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; dragStart = input.Position; startPos = mainFrame.Position end
    end)
    topBar.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    topBar.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    return {
        MainFrame = mainFrame,
        CreatePage = UIFramework.CreatePage,
        SwitchPage = UIFramework.SwitchPage,
        CreateToggle = UIFramework.CreateToggle,
        CreateDropdown = UIFramework.CreateDropdown
    }
end

function UIFramework.New(title) return createMainFrame(title or "UI Framework") end
return UIFramework
