-- ============ Tab Management ============
function UIModule:addTab(name, elements)
    if self.tabs[name] then return end
    self.tabs[name] = { elements = {} }
    self.elements[name] = {}

    -- Tab button
    local btn = Instance.new("TextButton")
    btn.Name = "Tab_"..name
    btn.Parent = self.tabsPanel
    btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
    btn.BackgroundTransparency = 0
    btn.BorderSizePixel = 0
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.TextSize = 16
    btn.Font = Enum.Font.Gotham
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Position = UDim2.new(0, 0, 0, (#self.tabButtons)*40)
    btn.AutoButtonColor = false
    btn.MouseButton1Click:Connect(function()
        self:selectTab(name)
    end)

    self.tabButtons[name] = btn

    -- Panel (ScrollingFrame) for content
    local panel = Instance.new("ScrollingFrame")
    panel.Name = "Panel_"..name
    panel.Parent = self.contentPanel
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel = 0
    panel.Size = UDim2.new(1, 0, 1, 0)
    panel.Position = UDim2.new(0, 0, 0, 0)
    panel.CanvasSize = UDim2.new(0, 0, 0, 0)
    panel.ScrollBarThickness = 6
    panel.AutomaticCanvasSize = Enum.AutomaticSize.Y
    panel.Visible = false

    self.tabPanels[name] = panel

    -- Add elements
    if elements then
        for _, elemData in ipairs(elements) do
            self:addElement(name, elemData)
        end
    end
end

function UIModule:selectTab(name)
    if self.currentTab == name then return end
    -- Hide previous
    if self.currentTab and self.tabPanels[self.currentTab] then
        self.tabPanels[self.currentTab].Visible = false
        self.tabButtons[self.currentTab].BackgroundColor3 = self.themeData.Tab
    end
    -- Show selected
    self.currentTab = name
    if name and self.tabPanels[name] then
        self.tabPanels[name].Visible = true
        self.tabButtons[name].BackgroundColor3 = self.themeData.TabSelected
    end
end

-- ============ Elements ============
function UIModule:addElement(tabName, elemData)
    local panel = self.tabPanels[tabName]
    if not panel then return end

    local element = nil
    if elemData.Type == "Toggle" then
        element = self:createToggle(panel, elemData)
    elseif elemData.Type == "Button" then
        element = self:createButton(panel, elemData)
    elseif elemData.Type == "Slider" then
        element = self:createSlider(panel, elemData)
    elseif elemData.Type == "Dropdown" then
        element = self:createDropdown(panel, elemData)
    end

    if element then
        table.insert(self.elements[tabName], element)
        -- apply current theme
        self:applyThemeToElement(element)
    end
end

-- ============ Toggle ============
function UIModule:createToggle(parent, data)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.AutomaticSize = Enum.AutomaticSize.Y

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.BackgroundTransparency = 1
    label.Text = data.Name
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.TextSize = 16
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.Position = UDim2.new(0.05, 0, 0, 0)

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = frame
    toggleBtn.BackgroundColor3 = Color3.fromRGB(80,80,80)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Size = UDim2.new(0, 70, 0, 30)
    toggleBtn.Position = UDim2.new(0.75, 0, 0.5, -15)
    toggleBtn.Text = "Off"
    toggleBtn.TextColor3 = Color3.fromRGB(255,255,255)
    toggleBtn.Font = Enum.Font.Gotham
    toggleBtn.TextSize = 14

    local state = data.Default or false
    toggleBtn.Text = state and "On" or "Off"
    toggleBtn.BackgroundColor3 = state and Color3.fromRGB(0,200,0) or Color3.fromRGB(200,0,0)

    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        toggleBtn.Text = state and "On" or "Off"
        toggleBtn.BackgroundColor3 = state and self.themeData.ToggleOn or self.themeData.ToggleOff
        if data.Callback then data.Callback(state) end
    end)

    -- Bind key
    local bindKey = nil
    if data.Bind then
        local key = getKeyEnum(data.Bind)
        if key then
            bindKey = key
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                if input.KeyCode == bindKey then
                    toggleBtn.MouseButton1Click:Fire()
                end
            end)
            frame._bindConnection = conn
        end
    end

    local element = {
        type = "Toggle",
        frame = frame,
        label = label,
        toggleBtn = toggleBtn,
        state = state,
        data = data,
        bindKey = bindKey,
        applyTheme = function(self, themeData)
            label.TextColor3 = themeData.Text
            toggleBtn.TextColor3 = themeData.Text
            toggleBtn.BackgroundColor3 = state and themeData.ToggleOn or themeData.ToggleOff
        end
    }
    return element
end

-- ============ Button ============
function UIModule:createButton(parent, data)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.AutomaticSize = Enum.AutomaticSize.Y

    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
    btn.BorderSizePixel = 0
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = UDim2.new(0.05, 0, 0.5, -15)
    btn.Text = data.Name
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 16
    btn.AutoButtonColor = false

    btn.MouseButton1Click:Connect(function()
        if data.Callback then data.Callback() end
    end)

    local element = {
        type = "Button",
        frame = frame,
        button = btn,
        data = data,
        applyTheme = function(self, themeData)
            btn.BackgroundColor3 = themeData.Button
            btn.TextColor3 = themeData.Text
        end,
        onHover = function(hover)
            btn.BackgroundColor3 = hover and self.themeData.ButtonHover or self.themeData.Button
        end
    }
    btn.MouseEnter:Connect(function() element:onHover(true) end)
    btn.MouseLeave:Connect(function() element:onHover(false) end)
    return element
end

-- ============ Slider ============
function UIModule:createSlider(parent, data)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, 50)
    frame.AutomaticSize = Enum.AutomaticSize.Y

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.BackgroundTransparency = 1
    label.Text = data.Name .. ": " .. tostring(data.Default or data.Min or 0)
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.TextSize = 16
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Size = UDim2.new(0.6, 0, 0, 20)
    label.Position = UDim2.new(0.05, 0, 0, 0)

    local track = Instance.new("Frame")
    track.Parent = frame
    track.BackgroundColor3 = Color3.fromRGB(70,70,70)
    track.BorderSizePixel = 0
    track.Size = UDim2.new(0.8, 0, 0, 6)
    track.Position = UDim2.new(0.1, 0, 0.5, -3)

    local fill = Instance.new("Frame")
    fill.Parent = track
    fill.BackgroundColor3 = Color3.fromRGB(0,120,255)
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.Position = UDim2.new(0, 0, 0, 0)

    local knob = Instance.new("TextButton")
    knob.Parent = frame
    knob.BackgroundColor3 = Color3.fromRGB(200,200,200)
    knob.BorderSizePixel = 0
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0.1, -8, 0.5, -8)
    knob.Text = ""
    knob.AutoButtonColor = false

    local min = data.Min or 0
    local max = data.Max or 100
    local value = data.Default or min
    local callback = data.Callback

    local function updateSlider(val)
        val = math.clamp(val, min, max)
        value = val
        local ratio = (val - min) / (max - min)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(0.1 + ratio * 0.8, -8, 0.5, -8)
        label.Text = data.Name .. ": " .. tostring(math.floor(val * 100) / 100)
        if callback then callback(val) end
    end

    updateSlider(value)

    local dragging = false
    local connection = nil
    knob.MouseButton1Down:Connect(function()
        dragging = true
        connection = RunService.RenderStepped:Connect(function()
            if not dragging then return end
            local mouse = player:GetMouse()
            local absPos = track.AbsolutePosition
            local absSize = track.AbsoluteSize
            local x = math.clamp((mouse.X - absPos.X) / absSize.X, 0, 1)
            local val = min + x * (max - min)
            updateSlider(val)
        end)
    end)
    knob.MouseButton1Up:Connect(function()
        dragging = false
        if connection then connection:Disconnect() connection = nil end
    end)
    knob.MouseLeave:Connect(function()
        if dragging then
            dragging = false
            if connection then connection:Disconnect() connection = nil end
        end
    end)

    local element = {
        type = "Slider",
        frame = frame,
        label = label,
        track = track,
        fill = fill,
        knob = knob,
        min = min,
        max = max,
        value = value,
        data = data,
        update = updateSlider,
        applyTheme = function(self, themeData)
            label.TextColor3 = themeData.Text
            track.BackgroundColor3 = themeData.SliderTrack
            fill.BackgroundColor3 = themeData.SliderFill
            knob.BackgroundColor3 = themeData.Button
            knob.TextColor3 = themeData.Text
        end
    }
    return element
end

-- ============ Dropdown ============
function UIModule:createDropdown(parent, data)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.AutomaticSize = Enum.AutomaticSize.Y

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.BackgroundTransparency = 1
    label.Text = data.Name
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.TextSize = 16
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Size = UDim2.new(0.3, 0, 1, 0)
    label.Position = UDim2.new(0.05, 0, 0, 0)

    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
    btn.BorderSizePixel = 0
    btn.Size = UDim2.new(0.5, 0, 0, 30)
    btn.Position = UDim2.new(0.4, 0, 0.5, -15)
    btn.Text = data.Default or "Select"
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.AutoButtonColor = false

    local dropdownFrame = Instance.new("Frame")
    dropdownFrame.Parent = frame
    dropdownFrame.BackgroundColor3 = Color3.fromRGB(50,50,50)
    dropdownFrame.BorderSizePixel = 0
    dropdownFrame.Size = UDim2.new(0.5, 0, 0, 0)
    dropdownFrame.Position = UDim2.new(0.4, 0, 1, 0)
    dropdownFrame.ClipsDescendants = true
    dropdownFrame.Visible = false

    local list = Instance.new("ScrollingFrame")
    list.Parent = dropdownFrame
    list.BackgroundTransparency = 1
    list.Size = UDim2.new(1, 0, 1, 0)
    list.Position = UDim2.new(0, 0, 0, 0)
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.ScrollBarThickness = 6
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y

    local options = data.Options or {}
    local multi = data.Multi or false
    local selected = {}
    local default = data.Default
    if default then
        if multi then
            if type(default) == "table" then
                for _, v in ipairs(default) do selected[v] = true end
            else
                selected[default] = true
            end
        else
            if options[default] then
                selected[default] = true
            end
        end
    end

    local function updateButtonText()
        if multi then
            local sel = {}
            for opt, v in pairs(selected) do if v then table.insert(sel, opt) end end
            btn.Text = #sel > 0 and table.concat(sel, ", ") or "None"
        else
            for opt, v in pairs(selected) do
                if v then btn.Text = opt; return end
            end
            btn.Text = "Select"
        end
    end

    local function createOption(opt)
        local optBtn = Instance.new("TextButton")
        optBtn.Parent = list
        optBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
        optBtn.BorderSizePixel = 0
        optBtn.Size = UDim2.new(1, 0, 0, 30)
        optBtn.Text = opt
        optBtn.TextColor3 = Color3.fromRGB(255,255,255)
        optBtn.Font = Enum.Font.Gotham
        optBtn.TextSize = 14
        optBtn.AutoButtonColor = false

        if multi then
            optBtn.Text = (selected[opt] and "✓ " or "") .. opt
        end

        optBtn.MouseButton1Click:Connect(function()
            if multi then
                selected[opt] = not selected[opt]
                optBtn.Text = (selected[opt] and "✓ " or "") .. opt
                updateButtonText()
                if data.Callback then data.Callback(selected) end
            else
                for k in pairs(selected) do selected[k] = false end
                selected[opt] = true
                updateButtonText()
                dropdownFrame.Visible = false
                if data.Callback then data.Callback(opt) end
            end
        end)

        return optBtn
    end

    for _, opt in ipairs(options) do
        createOption(opt)
    end

    -- Toggle dropdown visibility
    btn.MouseButton1Click:Connect(function()
        dropdownFrame.Visible = not dropdownFrame.Visible
        if dropdownFrame.Visible then
            local count = #options
            local height = math.min(count * 30, 200)
            dropdownFrame.Size = UDim2.new(0.5, 0, 0, height)
        end
    end)

    -- Close dropdown when clicking outside (simple: hide on any click outside)
    local function closeDropdown()
        dropdownFrame.Visible = false
    end
    -- We'll handle by listening to mouse clicks on the frame itself? Simpler: add a temporary connection.
    local clickConn
    btn.MouseButton1Click:Connect(function()
        if dropdownFrame.Visible then
            -- close on next click outside?
        end
    end)
    -- Use a global click listener: any click outside dropdown closes it.
    local function onGlobalClick(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if dropdownFrame.Visible then
                -- Check if click is inside dropdown or on button
                local mouse = player:GetMouse()
                if not dropdownFrame:IsAncestorOf(mouse.Target) and btn ~= mouse.Target and not btn:IsAncestorOf(mouse.Target) then
                    dropdownFrame.Visible = false
                end
            end
        end
    end
    local globalConn = UserInputService.InputBegan:Connect(onGlobalClick)

    -- Store connection for cleanup
    frame._globalConn = globalConn

    local element = {
        type = "Dropdown",
        frame = frame,
        label = label,
        btn = btn,
        dropdownFrame = dropdownFrame,
        list = list,
        options = options,
        multi = multi,
        selected = selected,
        data = data,
        updateButtonText = updateButtonText,
        applyTheme = function(self, themeData)
            label.TextColor3 = themeData.Text
            btn.BackgroundColor3 = themeData.Button
            btn.TextColor3 = themeData.Text
            dropdownFrame.BackgroundColor3 = themeData.DropdownBg
            for _, child in ipairs(list:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 = themeData.DropdownItem
                    child.TextColor3 = themeData.Text
                end
            end
        end
    }
    return element
end

-- ============ Settings Tab ============
function UIModule:addSettingsTab()
    local settingsElements = {}

    -- Theme dropdown
    local themeOptions = {}
    for name in pairs(Themes) do
        table.insert(themeOptions, name)
    end
    table.sort(themeOptions)
    settingsElements[#settingsElements+1] = {
        Type = "Dropdown",
        Name = "Theme",
        Options = themeOptions,
        Default = self.settings.Theme,
        Multi = false,
        Callback = function(choice)
            self:setTheme(choice)
        end
    }

    -- Toggle Key dropdown (common keys)
    local keyOptions = {"RightControl", "LeftControl", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Insert", "Home", "PageUp", "Delete", "End", "PageDown"}
    settingsElements[#settingsElements+1] = {
        Type = "Dropdown",
        Name = "Toggle Key",
        Options = keyOptions,
        Default = self.settings.ToggleKey,
        Multi = false,
        Callback = function(choice)
            self:setToggleKey(choice)
        end
    }

    -- Size Ratio dropdown
    local ratioOptions = {"1:1", "2:3", "3:4", "4:5", "5:6", "1:2", "1:3", "2:1", "3:1", "4:3", "16:9", "9:16"}
    settingsElements[#settingsElements+1] = {
        Type = "Dropdown",
        Name = "Size Ratio",
        Options = ratioOptions,
        Default = self.settings.SizeRatio,
        Multi = false,
        Callback = function(choice)
            self:setSizeRatio(choice)
        end
    }

    self:addTab("Settings", settingsElements)
end

-- ============ Theme & Settings ============
function UIModule:setTheme(themeName)
    if not Themes[themeName] then return end
    self.theme = themeName
    self.settings.Theme = themeName
    saveSettings(self.settings)
    self:applyTheme(themeName)
end

function UIModule:applyTheme(themeName)
    self.themeData = Themes[themeName] or Themes.Dark
    -- Apply to main frame
    self.mainFrame.BackgroundColor3 = self.themeData.Background
    self.titleBar.BackgroundColor3 = self.themeData.TabSelected
    self.titleLabel.TextColor3 = self.themeData.Text
    self.tabsPanel.BackgroundColor3 = self.themeData.Panel
    self.contentPanel.BackgroundColor3 = self.themeData.Panel
    self.closeButton.TextColor3 = self.themeData.Text

    -- Apply to tab buttons
    for name, btn in pairs(self.tabButtons) do
        btn.BackgroundColor3 = (name == self.currentTab) and self.themeData.TabSelected or self.themeData.Tab
        btn.TextColor3 = self.themeData.Text
    end

    -- Apply to all elements in all tabs
    for tabName, elemList in pairs(self.elements) do
        for _, elem in ipairs(elemList) do
            self:applyThemeToElement(elem)
        end
    end
end

function UIModule:applyThemeToElement(element)
    if element.applyTheme then
        element:applyTheme(self.themeData)
    end
end

function UIModule:setToggleKey(keyName)
    local key = getKeyEnum(keyName)
    if not key then return end
    self.settings.ToggleKey = keyName
    saveSettings(self.settings)
    self:setupToggleKey()
end

function UIModule:setupToggleKey()
    if self.toggleConnection then
        self.toggleConnection:Disconnect()
        self.toggleConnection = nil
    end
    local key = getKeyEnum(self.settings.ToggleKey)
    if key then
        self.toggleConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == key then
                self:toggleVisibility()
            end
        end)
    end
end

function UIModule:setSizeRatio(ratioStr)
    self.settings.SizeRatio = ratioStr
    saveSettings(self.settings)
    self.aspectConstraint.AspectRatio = parseRatio(ratioStr)
end

-- ============ Visibility ============
function UIModule:toggleVisibility()
    self.visible = not self.visible
    self.mainFrame.Visible = self.visible
end

function UIModule:setVisible(vis)
    self.visible = vis
    self.mainFrame.Visible = vis
end

-- ============ Destruction ============
function UIModule:destroy()
    if self.gui then
        self.gui:Destroy()
    end
    if self.toggleConnection then
        self.toggleConnection:Disconnect()
        self.toggleConnection = nil
    end
    -- Cleanup any global connections stored in elements
    for tabName, elemList in pairs(self.elements) do
        for _, elem in ipairs(elemList) do
            if elem.frame and elem.frame._bindConnection then
                elem.frame._bindConnection:Disconnect()
            end
            if elem.frame and elem.frame._globalConn then
                elem.frame._globalConn:Disconnect()
            end
        end
    end
end

-- ============ Return ============
return UIModule
