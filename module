    -- Функция обновления CanvasSize для страниц
    local function updatePagesCanvas()
        if not pages then
            if pagesScrolling then
                pagesScrolling.CanvasSize = UDim2.new(0, 0, 0, 16)
            end
            if bottomScrolling then
                bottomScrolling.CanvasSize = UDim2.new(0, 0, 0, 16)
            end
            return
        end
        
        local totalHeight = 16
        for _, data in pairs(pages) do
            if data and data.Frame and data.Frame.Visible then
                totalHeight = totalHeight + data.Frame.Size.Y.Offset + 4
            end
        end
        
        if currentScale.tabsLeft then
            if pagesScrolling then
                pagesScrolling.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
            end
        else
            if bottomScrolling then
                bottomScrolling.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
            end
        end
    end
    
