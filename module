--[[
	UIModule.lua
	Модуль для создания кастомизируемого UI для скриптов в Roblox.
	Включает вкладки, кнопки-тогглы (с биндом и без), слайдеры, дропдауны,
	настройки темы и горячей клавиши, адаптивный размер.
	
	Использование:
		local UI = require(script.Parent.UIModule)
		local myUI = UI.new({
			title = "My Script",
			ratio = "3:4",          -- соотношение ширины к высоте
			theme = "dark",         -- "light" или "dark"
			toggleKey = Enum.KeyCode.F1
		})
		local tab = myUI:addTab("Main")
		local toggle = tab:addToggle("Enable", {bindKey = Enum.KeyCode.F, default = false})
		toggle.onChanged:Connect(function(value) print("Toggle changed:", value) end)
		
		local slider = tab:addSlider("Speed", {min = 0, max = 100, default = 50})
		slider.onChanged:Connect(function(value) print("Speed:", value) end)
		
		local dropdown = tab:addDropdown("Mode", {
			options = {"Easy", "Normal", "Hard"},
			mode = "single",   -- или "multiple"
			default = "Normal"
		})
		dropdown.onChanged:Connect(function(value) print("Mode:", value) end)
		
		-- Доступ к настройкам
		myUI:setTheme("light")
		myUI:setToggleKey(Enum.KeyCode.RightShift)
		
		-- Показать/скрыть
		myUI:show()
		myUI:hide()
		myUI:toggle()
		
		-- Сохранение темы (пользователь реализует сохранение)
		myUI.onThemeChanged:Connect(function(theme)
			-- сохранить тему, например в DataStore
		end)
--]]

local UIModule = {}
UIModule.__index = UIModule

-- Вспомогательные функции
local function parseRatio(ratioStr)
	local w, h = ratioStr:match("(%d+):(%d+)")
	if not w then return 0.75 end
	return tonumber(w) / tonumber(h)
end

local function createRoundedFrame(parent, size, position, background, transparency)
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = background
	frame.BackgroundTransparency = transparency or 0
	frame.Parent = parent
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame
	
	return frame
end

local function createTextLabel(parent, text, size, position, color, font, textSize, transparency)
	local label = Instance.new("TextLabel")
	label.Text = text
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.Font = font or Enum.Font.Gotham
	label.TextSize = textSize or 16
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

-- Класс элемента UI (базовый)
local Element = {}
Element.__index = Element

function Element.new(ui, tab, name, params)
	local self = setmetatable({}, Element)
	self.ui = ui
	self.tab = tab
	self.name = name
	self.params = params or {}
	self.onChanged = Instance.new("BindableEvent")
	self.value = nil
	self.guiObjects = {} -- храним все созданные гуи объекты
	self:create()
	return self
end

function Element:create() end
function Element:getValue() return self.value end
function Element:setValue(val) self.value = val; self:updateGUI(); self.onChanged:Fire(val) end
function Element:updateGUI() end
function Element:applyTheme(theme) end

-- Класс Toggle (с биндом или без)
local Toggle = setmetatable({}, {__index = Element})
Toggle.__index = Toggle

function Toggle.new(ui, tab, name, params)
	local self = setmetatable(Element.new(ui, tab, name, params), Toggle)
	return self
end

function Toggle:create()
	local tabFrame = self.tab.contentFrame
	local y = self.tab:getNextY()
	
	local container = createRoundedFrame(tabFrame, UDim2.new(1, -20, 0, 40), UDim2.new(0, 10, 0, y), self.ui.themeColors.buttonBg, 0)
	container.Parent = tabFrame
	
	local label = createTextLabel(container, self.name, UDim2.new(0.7, -10, 1, 0), UDim2.new(0, 10, 0, 0), self.ui.themeColors.text, Enum.Font.Gotham, 16)
	
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0, 80, 0, 30)
	toggleBtn.Position = UDim2.new(1, -90, 0.5, -15)
	toggleBtn.BackgroundColor3 = self.ui.themeColors.toggleOff
	toggleBtn.Text = "OFF"
	toggleBtn.TextColor3 = self.ui.themeColors.text
	toggleBtn.Font = Enum.Font.Gotham
	toggleBtn.TextSize = 14
	toggleBtn.AutoButtonColor = false
	toggleBtn.Parent = container
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = toggleBtn
	
	local bindLabel = nil
	if self.params.bindKey then
		local keyName = self.params.bindKey.Name
		bindLabel = createTextLabel(container, "["..keyName.."]", UDim2.new(0, 80, 0, 20), UDim2.new(0, 100, 0.5, -10), self.ui.themeColors.textDim, Enum.Font.Gotham, 12)
		bindLabel.TextXAlignment = Enum.TextXAlignment.Left
		bindLabel.Parent = container
	end
	
	self.guiObjects.container = container
	self.guiObjects.toggleBtn = toggleBtn
	self.guiObjects.bindLabel = bindLabel
	
	-- значение по умолчанию
	local default = self.params.default or false
	self:setValue(default)
	
	-- обработчик клика
	toggleBtn.MouseButton1Click:Connect(function()
		self:setValue(not self.value)
	end)
	
	-- обработчик бинда
	if self.params.bindKey then
		local inputService = game:GetService("UserInputService")
		local bindFunc = function(input, processed)
			if processed then return end
			if input.KeyCode == self.params.bindKey and input.UserInputType == Enum.UserInputType.Keyboard then
				self:setValue(not self.value)
			end
		end
		inputService.InputBegan:Connect(bindFunc)
		self.bindFunc = bindFunc
	end
end

function Toggle:updateGUI()
	local btn = self.guiObjects.toggleBtn
	if self.value then
		btn.BackgroundColor3 = self.ui.themeColors.toggleOn
		btn.Text = "ON"
	else
		btn.BackgroundColor3 = self.ui.themeColors.toggleOff
		btn.Text = "OFF"
	end
end

function Toggle:applyTheme(theme)
	local container = self.guiObjects.container
	container.BackgroundColor3 = theme.buttonBg
	local btn = self.guiObjects.toggleBtn
	btn.BackgroundColor3 = self.value and theme.toggleOn or theme.toggleOff
	btn.TextColor3 = theme.text
	if self.guiObjects.bindLabel then
		self.guiObjects.bindLabel.TextColor3 = theme.textDim
	end
	-- обновляем текст лейбла (он уже есть, но цвет)
	local label = container:FindFirstChildOfClass("TextLabel")
	if label then
		label.TextColor3 = theme.text
	end
end

-- Класс Slider
local Slider = setmetatable({}, {__index = Element})
Slider.__index = Slider

function Slider.new(ui, tab, name, params)
	local self = setmetatable(Element.new(ui, tab, name, params), Slider)
	return self
end

function Slider:create()
	local tabFrame = self.tab.contentFrame
	local y = self.tab:getNextY()
	
	local container = createRoundedFrame(tabFrame, UDim2.new(1, -20, 0, 50), UDim2.new(0, 10, 0, y), self.ui.themeColors.buttonBg, 0)
	container.Parent = tabFrame
	
	local label = createTextLabel(container, self.name, UDim2.new(0.4, -10, 1, 0), UDim2.new(0, 10, 0, 0), self.ui.themeColors.text, Enum.Font.Gotham, 16)
	
	local valueLabel = createTextLabel(container, "0", UDim2.new(0.4, -10, 1, 0), UDim2.new(0.6, 0, 0, 0), self.ui.themeColors.text, Enum.Font.Gotham, 14)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = container
	
	-- ползунок
	local sliderFrame = Instance.new("Frame")
	sliderFrame.Size = UDim2.new(0.4, -10, 0, 6)
	sliderFrame.Position = UDim2.new(0.6, 0, 0.5, -3)
	sliderFrame.BackgroundColor3 = self.ui.themeColors.sliderBg
	sliderFrame.Parent = container
	local cornerSlider = Instance.new("UICorner")
	cornerSlider.CornerRadius = UDim.new(1, 0)
	cornerSlider.Parent = sliderFrame
	
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0.5, 0, 1, 0)
	fill.BackgroundColor3 = self.ui.themeColors.sliderFill
	fill.Parent = sliderFrame
	local cornerFill = Instance.new("UICorner")
	cornerFill.CornerRadius = UDim.new(1, 0)
	cornerFill.Parent = fill
	
	-- кнопка-ползунок
	local grabber = Instance.new("TextButton")
	grabber.Size = UDim2.new(0, 16, 0, 16)
	grabber.Position = UDim2.new(0.5, -8, 0.5, -8)
	grabber.BackgroundColor3 = self.ui.themeColors.grabber
	grabber.Text = ""
	grabber.Parent = sliderFrame
	local cornerGrab = Instance.new("UICorner")
	cornerGrab.CornerRadius = UDim.new(1, 0)
	cornerGrab.Parent = grabber
	
	self.guiObjects.container = container
	self.guiObjects.valueLabel = valueLabel
	self.guiObjects.fill = fill
	self.guiObjects.grabber = grabber
	self.guiObjects.sliderFrame = sliderFrame
	
	self.min = self.params.min or 0
	self.max = self.params.max or 100
	local default = self.params.default or (self.min + self.max) / 2
	self:setValue(default)
	
	-- Drag логика
	local dragging = false
	local function updateSlider(input)
		local posX = input.Position.X - sliderFrame.AbsolutePosition.X
		local width = sliderFrame.AbsoluteSize.X
		local ratio = math.clamp(posX / width, 0, 1)
		local val = self.min + (self.max - self.min) * ratio
		self:setValue(val)
	end
	
	grabber.MouseButton1Down:Connect(function()
		dragging = true
	end)
	
	game:GetService("UserInputService").InputChanged:Connect(function(input, processed)
		if processed then return end
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			updateSlider(input)
		end
	end)
	
	game:GetService("UserInputService").InputEnded:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	
	-- также клик на трек
	sliderFrame.MouseButton1Click:Connect(function(input)
		updateSlider(input)
	end)
end

function Slider:updateGUI()
	local ratio = (self.value - self.min) / (self.max - self.min)
	self.guiObjects.fill.Size = UDim2.new(ratio, 0, 1, 0)
	self.guiObjects.grabber.Position = UDim2.new(ratio, -8, 0.5, -8)
	self.guiObjects.valueLabel.Text = string.format("%.1f", self.value)
end

function Slider:applyTheme(theme)
	local container = self.guiObjects.container
	container.BackgroundColor3 = theme.buttonBg
	self.guiObjects.valueLabel.TextColor3 = theme.text
	self.guiObjects.sliderFrame.BackgroundColor3 = theme.sliderBg
	self.guiObjects.fill.BackgroundColor3 = theme.sliderFill
	self.guiObjects.grabber.BackgroundColor3 = theme.grabber
	local label = container:FindFirstChildOfClass("TextLabel")
	if label then
		label.TextColor3 = theme.text
	end
end

-- Класс Dropdown
local Dropdown = setmetatable({}, {__index = Element})
Dropdown.__index = Dropdown

function Dropdown.new(ui, tab, name, params)
	local self = setmetatable(Element.new(ui, tab, name, params), Dropdown)
	self.options = params.options or {}
	self.mode = params.mode or "single" -- "single" или "multiple"
	self.selected = {}
	if self.mode == "single" then
		local default = params.default or self.options[1]
		if default then self.selected[default] = true end
	else
		local defaults = params.default or {}
		if type(defaults) == "table" then
			for _, opt in ipairs(defaults) do
				self.selected[opt] = true
			end
		else
			self.selected[defaults] = true
		end
	end
	return self
end

function Dropdown:create()
	local tabFrame = self.tab.contentFrame
	local y = self.tab:getNextY()
	
	local container = createRoundedFrame(tabFrame, UDim2.new(1, -20, 0, 40), UDim2.new(0, 10, 0, y), self.ui.themeColors.buttonBg, 0)
	container.Parent = tabFrame
	
	local label = createTextLabel(container, self.name, UDim2.new(0.5, -10, 1, 0), UDim2.new(0, 10, 0, 0), self.ui.themeColors.text, Enum.Font.Gotham, 16)
	
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.4, -10, 0, 30)
	btn.Position = UDim2.new(0.6, 0, 0.5, -15)
	btn.BackgroundColor3 = self.ui.themeColors.buttonBg
	btn.Text = self:getDisplayText()
	btn.TextColor3 = self.ui.themeColors.text
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 14
	btn.Parent = container
	local cornerBtn = Instance.new("UICorner")
	cornerBtn.CornerRadius = UDim.new(0, 4)
	cornerBtn.Parent = btn
	
	-- выпадающий список
	local dropdownFrame = Instance.new("Frame")
	dropdownFrame.Size = UDim2.new(0.4, -10, 0, 100)
	dropdownFrame.Position = UDim2.new(0.6, 0, 1, 5)
	dropdownFrame.BackgroundColor3 = self.ui.themeColors.buttonBg
	dropdownFrame.Visible = false
	dropdownFrame.ZIndex = 10
	dropdownFrame.Parent = container
	local cornerDrop = Instance.new("UICorner")
	cornerDrop.CornerRadius = UDim.new(0, 4)
	cornerDrop.Parent = dropdownFrame
	-- тень
	local shadow = Instance.new("UIShadow")
	shadow.Size = 5
	shadow.Parent = dropdownFrame
	
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.ScrollBarThickness = 6
	scroll.Parent = dropdownFrame
	
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 2)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = scroll
	
	self.guiObjects.container = container
	self.guiObjects.btn = btn
	self.guiObjects.dropdownFrame = dropdownFrame
	self.guiObjects.scroll = scroll
	self.guiObjects.list = list
	self.guiObjects.optionButtons = {}
	
	-- заполнение опций
	self:refreshOptions()
	
	-- клик по кнопке для открытия/закрытия
	btn.MouseButton1Click:Connect(function()
		dropdownFrame.Visible = not dropdownFrame.Visible
	end)
	
	-- закрытие при клике вне
	-- упрощённо: при клике на любую другую кнопку закрывать? сложно, оставим так.
end

function Dropdown:refreshOptions()
	local scroll = self.guiObjects.scroll
	-- очистить старые
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	self.guiObjects.optionButtons = {}
	
	local options = self.options
	local selected = self.selected
	local mode = self.mode
	
	local ySize = 0
	for i, opt in ipairs(options) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -10, 0, 30)
		btn.BackgroundColor3 = self.ui.themeColors.buttonBg
		btn.Text = opt
		btn.TextColor3 = self.ui.themeColors.text
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 14
		btn.AutoButtonColor = false
		btn.Parent = scroll
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 2)
		corner.Parent = btn
		
		-- индикатор выбора
		local check = Instance.new("TextLabel")
		check.Size = UDim2.new(0, 20, 1, 0)
		check.Position = UDim2.new(1, -25, 0, 0)
		check.BackgroundTransparency = 1
		check.Text = (selected[opt]) and "✓" or ""
		check.TextColor3 = self.ui.themeColors.text
		check.Font = Enum.Font.Gotham
		check.TextSize = 18
		check.TextXAlignment = Enum.TextXAlignment.Center
		check.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			if mode == "single" then
				-- сбросить все
				for k in pairs(selected) do selected[k] = nil end
				selected[opt] = true
			else
				selected[opt] = not selected[opt]
			end
			self:refreshOptions()
			self.guiObjects.btn.Text = self:getDisplayText()
			self.onChanged:Fire(self:getValue())
		end)
		
		self.guiObjects.optionButtons[opt] = btn
		ySize = ySize + 32
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

function Dropdown:getDisplayText()
	local selected = self.selected
	local options = self.options
	local texts = {}
	for _, opt in ipairs(options) do
		if selected[opt] then
			table.insert(texts, opt)
		end
	end
	if #texts == 0 then return "Выберите" end
	return table.concat(texts, ", ")
end

function Dropdown:getValue()
	local result = {}
	for opt, sel in pairs(self.selected) do
		if sel then table.insert(result, opt) end
	end
	if self.mode == "single" then
		return result[1] or nil
	end
	return result
end

function Dropdown:applyTheme(theme)
	local container = self.guiObjects.container
	container.BackgroundColor3 = theme.buttonBg
	self.guiObjects.btn.BackgroundColor3 = theme.buttonBg
	self.guiObjects.btn.TextColor3 = theme.text
	if self.guiObjects.dropdownFrame then
		self.guiObjects.dropdownFrame.BackgroundColor3 = theme.buttonBg
	end
	local label = container:FindFirstChildOfClass("TextLabel")
	if label then
		label.TextColor3 = theme.text
	end
	-- обновить опции (цвета)
	for _, btn in pairs(self.guiObjects.optionButtons) do
		btn.BackgroundColor3 = theme.buttonBg
		btn.TextColor3 = theme.text
		local check = btn:FindFirstChildOfClass("TextLabel")
		if check then
			check.TextColor3 = theme.text
		end
	end
end

-- Класс Tab
local Tab = {}
Tab.__index = Tab

function Tab.new(ui, name)
	local self = setmetatable({}, Tab)
	self.ui = ui
	self.name = name
	self.elements = {}
	self.yOffset = 10 -- для вертикального расположения элементов
	
	-- создаем GUI для вкладки: кнопка в левой панели и фрейм для содержимого
	self:createGUI()
	return self
end

function Tab:createGUI()
	local ui = self.ui
	local leftPanel = ui.leftPanel
	local rightPanel = ui.rightPanel
	
	-- кнопка вкладки слева
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 35)
	btn.Position = UDim2.new(0, 5, 0, 0)
	btn.BackgroundColor3 = ui.themeColors.buttonBg
	btn.Text = self.name
	btn.TextColor3 = ui.themeColors.text
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 16
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.TextTruncate = Enum.TextTruncate.AtEnd
	btn.AutoButtonColor = false
	btn.Parent = leftPanel
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn
	
	-- фрейм содержимого (изначально невидим)
	local content = Instance.new("Frame")
	content.Size = UDim2.new(1, 0, 1, 0)
	content.BackgroundTransparency = 1
	content.Visible = false
	content.Parent = rightPanel
	
	-- ScrollingFrame для элементов внутри содержимого
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.ScrollBarThickness = 6
	scroll.Parent = content
	
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 5)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = scroll
	
	self.guiBtn = btn
	self.contentFrame = content
	self.scrollFrame = scroll
	self.listLayout = list
	
	-- обработчик клика для переключения вкладки
	btn.MouseButton1Click:Connect(function()
		ui:selectTab(self)
	end)
end

function Tab:getNextY()
	-- возвращает Y для следующего элемента (используется для абсолютного позиционирования)
	-- мы используем UIListLayout, поэтому просто возвращаем 0, но для совместимости оставим
	return 0
end

function Tab:addToggle(name, params)
	local toggle = Toggle.new(self.ui, self, name, params)
	table.insert(self.elements, toggle)
	return toggle
end

function Tab:addSlider(name, params)
	local slider = Slider.new(self.ui, self, name, params)
	table.insert(self.elements, slider)
	return slider
end

function Tab:addDropdown(name, params)
	local dropdown = Dropdown.new(self.ui, self, name, params)
	table.insert(self.elements, dropdown)
	return dropdown
end

function Tab:applyTheme(theme)
	self.guiBtn.BackgroundColor3 = theme.buttonBg
	self.guiBtn.TextColor3 = theme.text
	for _, elem in ipairs(self.elements) do
		elem:applyTheme(theme)
	end
end

function Tab:show()
	self.contentFrame.Visible = true
end

function Tab:hide()
	self.contentFrame.Visible = false
end

-- Основной класс UI
function UIModule.new(config)
	local self = setmetatable({}, UIModule)
	config = config or {}
	self.title = config.title or "UI"
	self.ratioStr = config.ratio or "3:4"
	self.ratio = parseRatio(self.ratioStr)
	self.theme = config.theme or "light"
	self.toggleKey = config.toggleKey or Enum.KeyCode.RightShift
	self.tabs = {}
	self.currentTab = nil
	self.onThemeChanged = Instance.new("BindableEvent")
	self.isVisible = true
	
	-- цвета тем
	self.themes = {
		light = {
			bg = Color3.fromRGB(240, 240, 240),
			buttonBg = Color3.fromRGB(220, 220, 220),
			text = Color3.fromRGB(30, 30, 30),
			textDim = Color3.fromRGB(100, 100, 100),
			toggleOn = Color3.fromRGB(76, 175, 80),
			toggleOff = Color3.fromRGB(200, 80, 80),
			sliderBg = Color3.fromRGB(180, 180, 180),
			sliderFill = Color3.fromRGB(66, 133, 244),
			grabber = Color3.fromRGB(255, 255, 255),
		},
		dark = {
			bg = Color3.fromRGB(35, 35, 40),
			buttonBg = Color3.fromRGB(55, 55, 65),
			text = Color3.fromRGB(230, 230, 230),
			textDim = Color3.fromRGB(150, 150, 150),
			toggleOn = Color3.fromRGB(76, 175, 80),
			toggleOff = Color3.fromRGB(200, 80, 80),
			sliderBg = Color3.fromRGB(80, 80, 90),
			sliderFill = Color3.fromRGB(66, 133, 244),
			grabber = Color3.fromRGB(255, 255, 255),
		}
	}
	self.themeColors = self.themes[self.theme] or self.themes.light
	
	-- создаем GUI
	self:createUI()
	self:setupToggleKey()
	
	return self
end

function UIModule:createUI()
	local player = game.Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	
	-- ScreenGui
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "CustomUI"
	screenGui.Parent = playerGui
	self.screenGui = screenGui
	
	-- Main Frame с соотношением
	local mainFrame = Instance.new("Frame")
	mainFrame.Name = "MainFrame"
	mainFrame.BackgroundColor3 = self.themeColors.bg
	mainFrame.BackgroundTransparency = 0
	mainFrame.Parent = screenGui
	
	-- размер: 45% ширины экрана, но не менее 300 и не более 600
	local screenSize = playerGui.AbsoluteSize
	local width = math.clamp(screenSize.X * 0.45, 300, 600)
	local height = width / self.ratio
	mainFrame.Size = UDim2.new(0, width, 0, height)
	mainFrame.Position = UDim2.new(0.5, -width/2, 0.5, -height/2)
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = mainFrame
	
	-- тень
	local shadow = Instance.new("UIShadow")
	shadow.Size = 10
	shadow.Parent = mainFrame
	
	-- Верхняя панель (заголовок + кнопка настроек)
	local topPanel = Instance.new("Frame")
	topPanel.Size = UDim2.new(1, 0, 0, 40)
	topPanel.BackgroundColor3 = self.themeColors.buttonBg
	topPanel.BackgroundTransparency = 0
	topPanel.Parent = mainFrame
	local topCorner = Instance.new("UICorner")
	topCorner.CornerRadius = UDim.new(0, 12)
	topCorner.Parent = topPanel
	-- обрезаем нижние углы
	local topClip = Instance.new("UICorner")
	topClip.CornerRadius = UDim.new(0, 0)
	topClip.Parent = topPanel -- не работает, лучше сделать отдельный frame
	
	-- заголовок
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(0.7, -10, 1, 0)
	titleLabel.Position = UDim2.new(0, 10, 0, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = self.title
	titleLabel.TextColor3 = self.themeColors.text
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextYAlignment = Enum.TextYAlignment.Center
	titleLabel.Parent = topPanel
	
	-- кнопка настроек (шестеренка)
	local settingsBtn = Instance.new("TextButton")
	settingsBtn.Size = UDim2.new(0, 30, 0, 30)
	settingsBtn.Position = UDim2.new(1, -40, 0.5, -15)
	settingsBtn.BackgroundColor3 = self.themeColors.buttonBg
	settingsBtn.Text = "⚙"
	settingsBtn.TextColor3 = self.themeColors.text
	settingsBtn.Font = Enum.Font.Gotham
	settingsBtn.TextSize = 20
	settingsBtn.Parent = topPanel
	local cornerBtn = Instance.new("UICorner")
	cornerBtn.CornerRadius = UDim.new(1, 0)
	cornerBtn.Parent = settingsBtn
	
	-- Основная область: левая панель (вкладки) и правая (содержимое)
	local mainArea = Instance.new("Frame")
	mainArea.Size = UDim2.new(1, 0, 1, -40)
	mainArea.Position = UDim2.new(0, 0, 0, 40)
	mainArea.BackgroundTransparency = 1
	mainArea.Parent = mainFrame
	
	-- Левая панель (вкладки)
	local leftPanel = Instance.new("Frame")
	leftPanel.Size = UDim2.new(0.3, 0, 1, 0)
	leftPanel.BackgroundTransparency = 0
	leftPanel.BackgroundColor3 = self.themeColors.buttonBg
	leftPanel.Parent = mainArea
	local leftCorner = Instance.new("UICorner")
	leftCorner.CornerRadius = UDim.new(0, 0)
	leftCorner.Parent = leftPanel
	-- обрезаем правый угол
	local clip = Instance.new("UICorner")
	clip.CornerRadius = UDim.new(0, 0)
	clip.Parent = leftPanel
	
	-- ScrollingFrame для вкладок
	local tabScroll = Instance.new("ScrollingFrame")
	tabScroll.Size = UDim2.new(1, 0, 1, 0)
	tabScroll.BackgroundTransparency = 1
	tabScroll.BorderSizePixel = 0
	tabScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	tabScroll.ScrollBarThickness = 4
	tabScroll.Parent = leftPanel
	
	local tabList = Instance.new("UIListLayout")
	tabList.Padding = UDim.new(0, 5)
	tabList.SortOrder = Enum.SortOrder.LayoutOrder
	tabList.Parent = tabScroll
	
	self.mainFrame = mainFrame
	self.topPanel = topPanel
	self.leftPanel = tabScroll
	self.rightPanel = mainArea:FindFirstChild("RightPanel") or (function()
		local right = Instance.new("Frame")
		right.Size = UDim2.new(0.7, 0, 1, 0)
		right.Position = UDim2.new(0.3, 0, 0, 0)
		right.BackgroundTransparency = 1
		right.Parent = mainArea
		return right
	end)()
	
	-- встроенная вкладка "Настройки" (всегда первая)
	local settingsTab = self:addTab("Настройки")
	-- добавляем элементы настроек: выбор темы и клавиша
	local themeDropdown = settingsTab:addDropdown("Тема", {
		options = {"light", "dark"},
		mode = "single",
		default = self.theme
	})
	themeDropdown.onChanged:Connect(function(value)
		if value then
			self:setTheme(value)
		end
	end)
	
	local keyInput = settingsTab:addDropdown("Клавиша показа", {
		options = {"F1", "F2", "F3", "F4", "RightShift", "LeftShift", "Tab"},
		mode = "single",
		default = self.toggleKey.Name
	})
	keyInput.onChanged:Connect(function(value)
		if value then
			local keyMap = {
				F1 = Enum.KeyCode.F1,
				F2 = Enum.KeyCode.F2,
				F3 = Enum.KeyCode.F3,
				F4 = Enum.KeyCode.F4,
				RightShift = Enum.KeyCode.RightShift,
				LeftShift = Enum.KeyCode.LeftShift,
				Tab = Enum.KeyCode.Tab
			}
			local newKey = keyMap[value]
			if newKey then
				self:setToggleKey(newKey)
			end
		end
	end)
	
	-- сохраняем ссылки для обновления тем
	self.settingsTab = settingsTab
	self.themeDropdown = themeDropdown
	self.keyInput = keyInput
	
	-- кнопка настроек открывает вкладку настроек
	settingsBtn.MouseButton1Click:Connect(function()
		self:selectTab(self.tabs[1]) -- первая вкладка - настройки
	end)
	
	-- изначально показываем первую вкладку (настройки)
	if #self.tabs > 0 then
		self:selectTab(self.tabs[1])
	end
	
	-- обработка изменения размера экрана
	game:GetService("UserInputService").WindowSizeChanged:Connect(function()
		self:resizeUI()
	end)
	
	self:resizeUI()
end

function UIModule:resizeUI()
	local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
	local screenSize = playerGui.AbsoluteSize
	local width = math.clamp(screenSize.X * 0.45, 300, 600)
	local height = width / self.ratio
	self.mainFrame.Size = UDim2.new(0, width, 0, height)
	self.mainFrame.Position = UDim2.new(0.5, -width/2, 0.5, -height/2)
end

function UIModule:setupToggleKey()
	local inputService = game:GetService("UserInputService")
	self.toggleConnection = inputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == self.toggleKey and input.UserInputType == Enum.UserInputType.Keyboard then
			self:toggle()
		end
	end)
end

function UIModule:addTab(name)
	local tab = Tab.new(self, name)
	table.insert(self.tabs, tab)
	-- обновляем CanvasSize левой панели
	local leftPanel = self.leftPanel
	local list = leftPanel:FindFirstChildOfClass("UIListLayout")
	if list then
		-- после добавления нужно обновить canvas
		task.wait() -- даем время на рендер
		local count = #self.tabs
		leftPanel.CanvasSize = UDim2.new(0, 0, 0, count * 40 + 10)
	end
	return tab
end

function UIModule:selectTab(tab)
	if self.currentTab == tab then return end
	if self.currentTab then
		self.currentTab:hide()
	end
	self.currentTab = tab
	tab:show()
	-- подсветка кнопки
	for _, t in ipairs(self.tabs) do
		if t == tab then
			t.guiBtn.BackgroundColor3 = self.themeColors.toggleOn -- или другой цвет
		else
			t.guiBtn.BackgroundColor3 = self.themeColors.buttonBg
		end
	end
end

function UIModule:setTheme(theme)
	if theme == self.theme then return end
	self.theme = theme
	self.themeColors = self.themes[theme] or self.themes.light
	-- обновить все элементы
	self.mainFrame.BackgroundColor3 = self.themeColors.bg
	self.topPanel.BackgroundColor3 = self.themeColors.buttonBg
	-- обновить заголовок
	local title = self.topPanel:FindFirstChildOfClass("TextLabel")
	if title then title.TextColor3 = self.themeColors.text end
	-- обновить кнопку настроек
	local settingsBtn = self.topPanel:FindFirstChildOfClass("TextButton")
	if settingsBtn then
		settingsBtn.BackgroundColor3 = self.themeColors.buttonBg
		settingsBtn.TextColor3 = self.themeColors.text
	end
	-- обновить левую панель
	self.leftPanel.Parent.BackgroundColor3 = self.themeColors.buttonBg
	-- обновить все вкладки и элементы
	for _, tab in ipairs(self.tabs) do
		tab:applyTheme(self.themeColors)
	end
	-- обновить дропдауны в настройках (они уже обновились через applyTheme)
	-- обновляем выбранные значения в дропдауне темы и клавиши
	if self.themeDropdown then
		self.themeDropdown.selected = {[self.theme] = true}
		self.themeDropdown:refreshOptions()
		self.themeDropdown.guiObjects.btn.Text = self.themeDropdown:getDisplayText()
	end
	if self.keyInput then
		local keyName = self.toggleKey.Name
		self.keyInput.selected = {[keyName] = true}
		self.keyInput:refreshOptions()
		self.keyInput.guiObjects.btn.Text = self.keyInput:getDisplayText()
	end
	self.onThemeChanged:Fire(theme)
end

function UIModule:getTheme()
	return self.theme
end

function UIModule:setToggleKey(key)
	if key == self.toggleKey then return end
	self.toggleKey = key
	-- обновляем отображение в настройках
	if self.keyInput then
		self.keyInput.selected = {[key.Name] = true}
		self.keyInput:refreshOptions()
		self.keyInput.guiObjects.btn.Text = self.keyInput:getDisplayText()
	end
	-- переподключаем бинд
	if self.toggleConnection then
		self.toggleConnection:Disconnect()
	end
	self:setupToggleKey()
end

function UIModule:getToggleKey()
	return self.toggleKey
end

function UIModule:show()
	self.mainFrame.Visible = true
	self.isVisible = true
end

function UIModule:hide()
	self.mainFrame.Visible = false
	self.isVisible = false
end

function UIModule:toggle()
	if self.isVisible then
		self:hide()
	else
		self:show()
	end
end

return UIModule
