-- Функция для добавления слайдера
function ModernUI:AddSlider(tabId, name, minValue, maxValue, defaultValue, callback)
    local tab = self:FindTab(tabId)
    if not tab then return end
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -20, 0, 70)
    container.Position = UDim2.new(0, 0, 0, self:GetNextPosition(tab))
    container.BackgroundTransparency = 1
    container.Parent = tab.Content
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(0.6, 0, 0.4, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 16
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.Parent = container
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Name = "ValueLabel"
    valueLabel.Size = UDim2.new(0.4, 0, 0.4, 0)
    valueLabel.Position = UDim2.new(0.6, 0, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(defaultValue or minValue)
    valueLabel.TextColor3 = Color3.fromRGB(64, 128, 255)
    valueLabel.TextSize = 16
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.Parent = container
    
    local sliderBg = Instance.new("Frame")
    sliderBg.Name = "SliderBackground"
    sliderBg.Size = UDim2.new(1, 0, 0, 6)
    sliderBg.Position = UDim2.new(0, 0, 0.6, 5)
    sliderBg.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = container
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "SliderFill"
    sliderFill.Size = UDim2.new(0, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(64, 128, 255)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBg
    
    local sliderButton = Instance.new("ImageButton")
    sliderButton.Name = "SliderButton"
    sliderButton.Size = UDim2.new(0, 20, 0, 20)
    sliderButton.Position = UDim2.new(0, -10, 0.5, -10)
    sliderButton.BackgroundTransparency = 1
    sliderButton.Image = "rbxassetid://6023426911"
    sliderButton.ImageColor3 = Color3.fromRGB(64, 128, 255)
    sliderButton.Parent = sliderFill
    
    local min = minValue or 0
    local max = maxValue or 100
    local value = defaultValue or min
    
    local function updateSlider(newValue)
        -- Защита от передачи таблицы или другого нечислового значения
        if type(newValue) == "table" then
            newValue = newValue[1] or 0
        end
        newValue = tonumber(newValue) or 0
        
        value = math.clamp(newValue, min, max)
        local percentage = (value - min) / (max - min)
        sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
        valueLabel.Text = tostring(math.round(value * 100) / 100)
        if callback then callback(value) end
    end
    
    updateSlider(value)
    
    local dragging = false
    local dragConnection
    
    sliderButton.MouseButton1Down:Connect(function()
        dragging = true
        
        dragConnection = RunService.Heartbeat:Connect(function()
            if not dragging then
                if dragConnection then dragConnection:Disconnect() end
                return
            end
            
            local mousePos = UserInputService:GetMouseLocation().X
            local offset = math.clamp((mousePos - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            local newValue = min + (max - min) * offset
            updateSlider(newValue)
        end)
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if dragConnection then dragConnection:Disconnect() end
        end
    end)
    
    -- Также обрабатываем клик по фону слайдера
    sliderBg.MouseButton1Click:Connect(function()
        local mousePos = UserInputService:GetMouseLocation().X
        local offset = math.clamp((mousePos - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local newValue = min + (max - min) * offset
        updateSlider(newValue)
    end)
    
    table.insert(tab.Elements, {
        Type = "Slider",
        Name = name,
        Value = value,
        Update = updateSlider,
        GetValue = function() return value end
    })
    
    tab.UpdateCanvas()
    return {
        SetValue = updateSlider,
        GetValue = function() return value end
    }
end

-- Функция для добавления дропдауна
function ModernUI:AddDropdown(tabId, name, options, allowMultiSelect, callback)
    local tab = self:FindTab(tabId)
    if not tab then return end
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -20, 0, 70)
    container.Position = UDim2.new(0, 0, 0, self:GetNextPosition(tab))
    container.BackgroundTransparency = 1
    container.ClipsDescendants = true
    container.Parent = tab.Content
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(0.5, 0, 0.4, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 16
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.Parent = container
    
    local dropdownButton = Instance.new("TextButton")
    dropdownButton.Name = "Dropdown"
    dropdownButton.Size = UDim2.new(0.5, 0, 0.4, 0)
    dropdownButton.Position = UDim2.new(0.5, 0, 0, 0)
    dropdownButton.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    dropdownButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    dropdownButton.Text = "Выберите..."
    dropdownButton.TextSize = 14
    dropdownButton.Font = Enum.Font.Gotham
    dropdownButton.BorderSizePixel = 0
    dropdownButton.Parent = container
    
    local listContainer = Instance.new("Frame")
    listContainer.Size = UDim2.new(0.5, 0, 0, 0)
    listContainer.Position = UDim2.new(0.5, 0, 0.4, 5)
    listContainer.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    listContainer.BorderSizePixel = 0
    listContainer.ClipsDescendants = true
    listContainer.Parent = container
    
    local listScrolling = Instance.new("ScrollingFrame")
    listScrolling.Size = UDim2.new(1, 0, 1, 0)
    listScrolling.BackgroundTransparency = 1
    listScrolling.BorderSizePixel = 0
    listScrolling.ScrollBarThickness = 3
    listScrolling.CanvasSize = UDim2.new(0, 0, 0, 0)
    listScrolling.Parent = listContainer
    
    local optionsList = {}
    local selectedOptions = {}
    local isMulti = allowMultiSelect or false
    
    local function updateList()
        for _, child in pairs(listScrolling:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        
        optionsList = {}
        
        for i, option in pairs(options) do
            local item = Instance.new("TextButton")
            item.Name = "DropdownItem"
            item.Size = UDim2.new(1, 0, 0, 30)
            item.Position = UDim2.new(0, 0, 0, (i-1) * 30)
            item.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            item.TextColor3 = Color3.fromRGB(200, 200, 200)
            item.Text = option
            item.TextSize = 14
            item.Font = Enum.Font.Gotham
            item.BorderSizePixel = 0
            item.Parent = listScrolling
            
            item.MouseEnter:Connect(function()
                if item.Name ~= "DropdownItemSelected" then
                    TweenService:Create(item, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
                end
            end)
            
            item.MouseLeave:Connect(function()
                if item.Name ~= "DropdownItemSelected" then
                    TweenService:Create(item, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 45)}):Play()
                end
            end)
            
            item.MouseButton1Click:Connect(function()
                if isMulti then
                    local index = table.find(selectedOptions, option)
                    if index then
                        table.remove(selectedOptions, index)
                        item.Name = "DropdownItem"
                        item.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
                        item.TextColor3 = Color3.fromRGB(200, 200, 200)
                    else
                        table.insert(selectedOptions, option)
                        item.Name = "DropdownItemSelected"
                        item.BackgroundColor3 = Color3.fromRGB(64, 128, 255)
                        item.TextColor3 = Color3.fromRGB(255, 255, 255)
                    end
                    
                    if #selectedOptions > 0 then
                        dropdownButton.Text = table.concat(selectedOptions, ", ")
                    else
                        dropdownButton.Text = "Выберите..."
                    end
                    
                    if callback then callback(selectedOptions) end
                else
                    selectedOptions = {option}
                    dropdownButton.Text = option
                    
                    for _, child in pairs(listScrolling:GetChildren()) do
                        if child:IsA("TextButton") then
                            if child.Text == option then
                                child.Name = "DropdownItemSelected"
                                child.BackgroundColor3 = Color3.fromRGB(64, 128, 255)
                                child.TextColor3 = Color3.fromRGB(255, 255, 255)
                            else
                                child.Name = "DropdownItem"
                                child.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
                                child.TextColor3 = Color3.fromRGB(200, 200, 200)
                            end
                        end
                    end
                    
                    if callback then callback(option) end
                    toggleDropdown(false)
                end
            end)
            
            table.insert(optionsList, item)
        end
        
        listScrolling.CanvasSize = UDim2.new(0, 0, 0, #options * 30)
    end
    
    local dropdownOpen = false
    local function toggleDropdown(open)
        dropdownOpen = (open == nil) and not dropdownOpen or open
        if dropdownOpen then
            listContainer.Size = UDim2.new(0.5, 0, 0, math.min(#options * 30, 120))
            listContainer.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        else
            listContainer.Size = UDim2.new(0.5, 0, 0, 0)
        end
    end
    
    dropdownButton.MouseButton1Click:Connect(function()
        toggleDropdown()
        updateList()
    end)
    
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if dropdownOpen then
                local mousePos = UserInputService:GetMouseLocation()
                local listPos = listContainer.AbsolutePosition
                local listSize = listContainer.AbsoluteSize
                
                if not (mousePos.X >= listPos.X and mousePos.X <= listPos.X + listSize.X and
                       mousePos.Y >= listPos.Y and mousePos.Y <= listPos.Y + listSize.Y) then
                    toggleDropdown(false)
                end
            end
        end
    end)
    
    updateList()
    
    table.insert(tab.Elements, {
        Type = "Dropdown",
        Name = name,
        Options = options,
        Selected = selectedOptions,
        Update = updateList,
        GetSelected = function() return selectedOptions end
    })
    
    tab.UpdateCanvas()
    return {
        GetSelected = function() return selectedOptions end,
        SetSelected = function(newSelected)
            selectedOptions = {}
            for _, option in pairs(newSelected) do
                if table.find(options, option) then
                    table.insert(selectedOptions, option)
                end
            end
            if #selectedOptions > 0 then
                dropdownButton.Text = table.concat(selectedOptions, ", ")
            else
                dropdownButton.Text = "Выберите..."
            end
            if callback then callback(selectedOptions) end
            updateList()
        end
    }
end

-- Вспомогательные функции
function ModernUI:FindTab(tabId)
    for _, tab in pairs(UIStore.Tabs) do
        if tab.Id == tabId then
            return tab
        end
    end
    return nil
end

function ModernUI:GetNextPosition(tab)
    local maxY = 0
    for _, child in pairs(tab.Content:GetChildren()) do
        if child:IsA("Frame") and child.BackgroundTransparency == 1 then
            local posY = child.Position.Y.Offset + child.Size.Y.Offset
            if posY > maxY then
                maxY = posY
            end
        end
    end
    return maxY + 10
end

-- Настройки UI
function ModernUI:AddSettingsUI(tabId)
    local tab = self:FindTab(tabId)
    if not tab then return end
    
    local themeDropdown = self:AddDropdown(tabId, "Тема", {"Dark", "Light", "Neon", "Pastel"}, false, function(value)
        UIStore.Settings.Theme = value
        self:ApplyTheme(value)
        self:SaveSettings()
    end)
    
    local keyOptions = {}
    for _, key in pairs(Enum.KeyCode:GetEnumItems()) do
        table.insert(keyOptions, tostring(key))
    end
    
    local keyDropdown = self:AddDropdown(tabId, "Горячая клавиша", keyOptions, false, function(value)
        for _, key in pairs(Enum.KeyCode:GetEnumItems()) do
            if tostring(key) == value then
                UIStore.Settings.ToggleKey = key
                self:SaveSettings()
                break
            end
        end
    end)
    
    local sizeDropdown = self:AddDropdown(tabId, "Размер UI", {"3:4", "1:1", "1:2", "2:3", "1:3"}, false, function(value)
        local parts = splitString(value, ":")
        UIStore.Settings.UIScale = Vector2.new(tonumber(parts[1]), tonumber(parts[2]))
        self:ResizeUI()
        self:SaveSettings()
    end)
    
    themeDropdown:SetSelected({UIStore.Settings.Theme})
    keyDropdown:SetSelected({tostring(UIStore.Settings.ToggleKey)})
    local scaleStr = tostring(UIStore.Settings.UIScale.X) .. ":" .. tostring(UIStore.Settings.UIScale.Y)
    sizeDropdown:SetSelected({scaleStr})
end

-- Применение темы
function ModernUI:ApplyTheme(theme)
    if not UIStore.MainFrame then return end
    ApplyTheme(UIStore.MainFrame, theme)
    UIStore.Settings.Theme = theme
end

-- Изменение размера UI
function ModernUI:ResizeUI()
    if not UIStore.MainFrame then return end
    local scale = UIStore.Settings.UIScale
    local aspectRatio = scale.X / scale.Y
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local sizeX = math.min(viewportSize.X * 0.75, 800)
    local sizeY = sizeX / aspectRatio
    local maxSizeY = viewportSize.Y * 0.8
    
    if sizeY > maxSizeY then
        sizeY = maxSizeY
        sizeX = sizeY * aspectRatio
    end
    
    UIStore.MainFrame.Size = UDim2.new(0, sizeX, 0, sizeY)
    UIStore.MainFrame.Position = UDim2.new(0.5, -sizeX/2, 0.5, -sizeY/2)
end

-- Сохранение настроек
function ModernUI:SaveSettings()
    if not UIStore.DataStore then return end
    UIStore.DataStore.Settings = UIStore.Settings
end

-- Загрузка настроек
function ModernUI:LoadSettings()
    if UIStore.DataStore and UIStore.DataStore.Settings then
        UIStore.Settings = UIStore.DataStore.Settings
        self:ApplyTheme(UIStore.Settings.Theme)
        self:ResizeUI()
    end
end

-- Переключение видимости UI
function ModernUI:ToggleUI()
    if not UIStore.MainFrame then return end
    UIStore.Settings.Visible = not UIStore.Settings.Visible
    UIStore.MainFrame.Visible = UIStore.Settings.Visible
    self:SaveSettings()
end

-- Показать UI
function ModernUI:ShowUI()
    if not UIStore.MainFrame then return end
    UIStore.Settings.Visible = true
    UIStore.MainFrame.Visible = true
    self:SaveSettings()
end

-- Скрыть UI
function ModernUI:HideUI()
    if not UIStore.MainFrame then return end
    UIStore.Settings.Visible = false
    UIStore.MainFrame.Visible = false
    self:SaveSettings()
end

-- Получение состояния UI
function ModernUI:IsVisible()
    return UIStore.Settings.Visible or false
end

-- Настройка привязки UI к экрану
function ModernUI:SetUIScale(scale)
    UIStore.Settings.UIScale = scale
    self:ResizeUI()
    self:SaveSettings()
end

-- Инициализация
function ModernUI:Init(title, scale)
    return self:CreateUI(title, scale)
end

return ModernUI
