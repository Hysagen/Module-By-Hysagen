    }):Play()
    
    task.wait(0.2)
    TweenService:Create(notif, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
    
    task.wait(data.duration or 3)
    
    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Position = UDim2.new(1, -30, 0, 20),
        BackgroundTransparency = 1
    }):Play()
    
    task.wait(0.4)
    notif:Destroy()
    
    IsNotificationShowing = false
