-- Вспомогательная функция для разделения строки
local function splitString(str, delimiter)
    if type(str) ~= "string" then
        str = tostring(str)
    end
    local result = {}
    for match in (str .. delimiter):gmatch("(.-)" .. delimiter) do
        table.insert(result, match)
    end
    return result
end

