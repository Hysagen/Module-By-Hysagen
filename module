--  ADVANCED DRAG WITH PHYSICS
-- █████████████████████████████████████████████████████████████████

local function MakeDraggable(gui, options)
    options = options or {}
    local damping = options.damping or CONFIG.SPRING_DAMPING
    local inertia = options.inertia or false
    
    local dragData = {
        dragging = false,
        dragStart = nil,
        startPos = nil,
        velocity = Vector2.new(0, 0),
        lastPos = nil,
        lastTime = nil,
    }
    
    local function update(input)
        if not dragData.dragging or not dragData.dragStart or not dragData.startPos then return end
        local delta = input.Position - dragData.dragStart
        local newPos = UDim2.new(
            dragData.startPos.X.Scale,
            dragData.startPos.X.Offset + delta.X,
            dragData.startPos.Y.Scale,
            dragData.startPos.Y.Offset + delta.Y
        )
        gui.Position = newPos
        
        if inertia then
            local now = tick()
            if dragData.lastPos and dragData.lastTime then
                local dt = now - dragData.lastTime
                if dt > 0 then
                    dragData.velocity = (input.Position - dragData.lastPos) / dt
                    dragData.velocity = dragData.velocity * damping
                end
            end
            dragData.lastPos = input.Position
            dragData.lastTime = now
        end
    end
    
    local connections = {}
    
    local began = gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not _G.IsDraggingSlider then
            dragData.dragging = true
            dragData.dragStart = input.Position
            dragData.startPos = gui.Position
            dragData.velocity = Vector2.new(0, 0)
            dragData.lastPos = input.Position
            dragData.lastTime = tick()
        end
    end)
    table.insert(connections, began)
    
    local ended = gui.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragData.dragging = false
            if inertia and dragData.velocity.Magnitude > 10 then
                local startPos = gui.Position
                local vel = dragData.velocity
                local startTime = tick()
                local conn
                conn = RunService.Heartbeat:Connect(function()
                    local dt = tick() - startTime
                    if dt > 0.8 or vel.Magnitude < 1 then
                        if conn then conn:Disconnect() end
                        return
                    end
                    local decay = math.exp(-dt * 5)
                    local offset = vel * dt * decay * 0.5
                    gui.Position = UDim2.new(
                        startPos.X.Scale,
                        startPos.X.Offset + offset.X,
                        startPos.Y.Scale,
                        startPos.Y.Offset + offset.Y
                    )
                end)
                table.insert(connections, conn)
            end
        end
    end)
    table.insert(connections, ended)
    
    local changed = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragData.dragging and not _G.IsDraggingSlider then
            update(input)
        end
    end)
    table.insert(connections, changed)
    
    return connections, dragData
end

