    --  THEME APPLICATION
    -- █████████████████████████████████████████████████████████████████
    
    local function ApplyTheme(theme, themeName)
        CurrentTheme = deepCopy(theme)
        Library.CurrentTheme = CurrentTheme
        local tInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        
        -- Update main frame
        TweenService:Create(Main, tInfo, {BackgroundColor3 = theme.Main}):Play()
        
        -- Update border
        local b = Main:FindFirstChildWhichIsA("UIStroke")
        if b then
            TweenService:Create(b, tInfo, {Color = theme.Stroke, Transparency = 0.5}):Play()
        end
        
        -- Update glow
        TweenService:Create(glow, tInfo, {BackgroundColor3 = theme.Glow}):Play()
        
        -- Update sidebar and titlebar
        for _, obj in pairs({Sidebar, TitleBar}) do
            TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Sidebar}):Play()
            local s = obj:FindFirstChildWhichIsA("UIStroke")
            if s then TweenService:Create(s, tInfo, {Color = theme.Stroke}):Play() end
        end
        
        -- Update all UI elements
        for _, obj in pairs(ScreenGui:GetDescendants()) do
            if obj:IsA("UIStroke") and obj.Parent and obj.Parent.Name ~= "SliderKnob" then
                if obj.Parent:FindFirstChild("SliderBack") then
                    -- Skip slider strokes
                else
                    TweenService:Create(obj, tInfo, {Color = theme.Stroke}):Play()
                end
            end
            
            if obj:IsA("Frame") and obj.Name == "Row" then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Secondary}):Play()
            end
            
            if obj:IsA("Frame") and obj.Name == "SliderBack" then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
            end
            
            if obj:IsA("Frame") and (obj.Name == "SliderFill" or obj.Name == "SliderKnob") then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Accent}):Play()
            end
            
            if obj:IsA("TextButton") and obj.Name == "ActionBtn" then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Accent, TextColor3 = theme.BtnText}):Play()
            end
            
            if obj:IsA("TextButton") and obj.Name == "ToggleBtn" and obj:FindFirstChild("Dot") then
                -- Keep toggle colors as they are
            end
            
            if obj:IsA("TextLabel") and obj.Parent and obj.Parent.Name ~= "SliderKnob" then
                if obj.Name ~= "MinimizeBtn" and obj.Name ~= "CloseBtn" then
                    TweenService:Create(obj, tInfo, {TextColor3 = theme.Text}):Play()
                end
            end
        end
        
        -- Update sidebar scrollbar
        SidebarScroll.ScrollBarImageColor3 = theme.Stroke
        
        -- Update tab buttons
        for _, btn in pairs(Library.TabButtons) do
            if btn:GetAttribute("Active") then
                TweenService:Create(btn, tInfo, {
                    BackgroundColor3 = theme.Accent,
                    TextColor3 = theme.BtnText
                }):Play()
            else
                TweenService:Create(btn, tInfo, {
                    BackgroundColor3 = theme.Secondary,
                    TextColor3 = theme.Text
                }):Play()
            end
        end
        
        -- Save theme
        if themeName then
            local windowState = {
                size = Main.Size,
                position = Main.Position,
            }
            saveTheme(themeName, windowState)
        end
        
        UI_Module:Notify("Theme Changed", "Applied " .. themeName .. " theme", "success", 2)
    end
    
