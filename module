    -- █████████████████████████████████████████████████████████████████
    --  LIBRARY INTERFACE
    -- █████████████████████████████████████████████████████████████████
    
    function Library:CreateTab(name)
        return createTab(name, false)
    end
    
    function Library:CreateSettingsTab()
        return createTab("Settings", true)
    end
    
    function Library:Destroy()
        for _, c in ipairs(self.Connections) do 
            if c and c.Disconnect then pcall(c.Disconnect, c) end 
        end
        if self.ScreenGui then self.ScreenGui:Destroy() end
        UI_Module.ScreenGui = nil
    end
    
    function Library:Notify(title, message, type, duration)
        UI_Module:Notify(title, message, type, duration)
    end
    
    function Library:GetTheme()
        return deepCopy(CurrentTheme)
    end
    
    function Library:SetTheme(themeName)
        if Themes[themeName] then
            ApplyTheme(Themes[themeName], themeName)
        end
    end
    
    -- █████████████████████████████████████████████████████████████████
    --  SETTINGS TAB
    -- █████████████████████████████████████████████████████████████████
    
    local SettingsTab = createTab("Settings", true)
    
    SettingsTab:AddLabel("🎨 Theme Selection", 28)
    SettingsTab:AddSeparator()
    
    -- Theme grid
    local themeNames = {}
    for name, _ in pairs(Themes) do
        table.insert(themeNames, name)
    end
    
    -- Create theme buttons in a grid
    local gridFrame = Instance.new("Frame", SettingsTab.Page)
    gridFrame.Size = UDim2.new(1, -12, 0, 0)
    gridFrame.BackgroundTransparency = 1
    gridFrame.LayoutOrder = SettingsTab.Count + 1
    SettingsTab.Count = SettingsTab.Count + 1
    
    local gridLayout = Instance.new("UIGridLayout", gridFrame)
    gridLayout.CellSize = UDim2.new(0, 120, 0, 48)
    gridLayout.CellPadding = UDim.new(0, 8, 0, 8)
    gridLayout.FillDirectionMaxCells = 4
    gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
    
    local themeBtns = {}
    
    for i, name in ipairs(themeNames) do
        local theme = Themes[name]
        local btn = Instance.new("TextButton", gridFrame)
        btn.Size = UDim2.new(0, 120, 0, 48)
        btn.BackgroundColor3 = theme.Main
        btn.Text = name
        btn.TextColor3 = theme.Text
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 13
        btn.AutoButtonColor = false
        btn.BorderSizePixel = 0
        btn.LayoutOrder = i
        
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 10)
        
        -- Accent bar
        local accentBar = Instance.new("Frame", btn)
        accentBar.Size = UDim2.new(1, 0, 0, 3)
        accentBar.Position = UDim2.new(0, 0, 1, -3)
        accentBar.BackgroundColor3 = theme.Accent
        accentBar.BorderSizePixel = 0
        
        local btnClick = btn.MouseButton1Click:Connect(function()
            ApplyTheme(theme, name)
            -- Highlight selected
            for _, b in pairs(themeBtns) do
                if b ~= btn then
                    TweenService:Create(b, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
                    TweenService:Create(b, TweenInfo.new(0.2), {Size = UDim2.new(0, 120, 0, 48)}):Play()
                end
            end
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
            TweenService:Create(btn, TweenInfo.new(0.2), {Size = UDim2.new(0, 124, 0, 52)}):Play()
        end)
        table.insert(Library.Connections, btnClick)
        
        table.insert(themeBtns, btn)
    end
    
    -- Update grid height
    local gridUpdate = gridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        gridFrame.Size = UDim2.new(1, -12, 0, gridLayout.AbsoluteContentSize.Y)
    end)
    table.insert(Library.Connections, gridUpdate)
    
    SettingsTab:AddSeparator()
    SettingsTab:AddButton("📁 Open Theme Folder", "Open", function()
        pcall(function() shell("explorer " .. CONFIG.THEME_FILE) end)
        UI_Module:Notify("Themes", "Theme folder opened", "info", 2)
    end, "📁")
    
    SettingsTab:AddButton("🔄 Reset UI", "Reset", function()
        Library:Destroy()
        task.wait(0.5)
        UI_Module.CreateMain(hubTitle, options)
        UI_Module:Notify("UI Reset", "Interface has been restarted", "success", 2)
    end, "🔄")
    
    -- █████████████████████████████████████████████████████████████████
    --  THEME LOAD & WELCOME
    -- █████████████████████████████████████████████████████████████████
    
    -- Load saved theme
    if currentThemeName and Themes[currentThemeName] then
        ApplyTheme(Themes[currentThemeName], currentThemeName)
    end
    
    -- Welcome notification
    task.wait(0.5)
    UI_Module:Notify("Welcome", "Hysagen Ultra UI v3.0 loaded successfully! ✨", "success", 3)
    
    return Library
end

return UI_Module
