}

function NotificationSystem:Create(message, type, duration)
    type = type or "info"
    duration = duration or 3
    
    local colors = {
        info = Color3.fromRGB(0, 150, 255),
        success = Color3.fromRGB(0, 255, 100),
        warning = Color3.fromRGB(255, 200, 0),
        error = Color3.fromRGB(255, 50, 50),
    }
    
    local icon = {
        info = "ℹ️",
        success = "✅",
        warning = "⚠️",
        error = "❌",
    }
    
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 350, 0, 60)
    notif.Position = UDim2.new(1, 10, 1, -70 - (#self.Notifications * 70))
    notif.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    notif.BackgroundTransparency = 0.15
    notif.BorderSizePixel = 0
    notif.ClipsDescendants = true
    notif.ZIndex = 999
    
    -- Анимированный вход
    notif.Position = UDim2.new(1, 10 + 400, 1, -70 - (#self.Notifications * 70))
    
    local corner = Instance.new("UICorner", notif)
    corner.CornerRadius = UDim.new(0, 10)
    
    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = colors[type]
    stroke.Thickness = 2
    stroke.Transparency = 0.6
    
    local glow = Instance.new("Frame", notif)
    glow.Size = UDim2.new(0, 4, 1, 0)
    glow.BackgroundColor3 = colors[type]
    glow.BorderSizePixel = 0
    glow.ZIndex = 1000
    
    local iconLabel = Instance.new("TextLabel", notif)
    iconLabel.Size = UDim2.new(0, 40, 1, 0)
    iconLabel.Position = UDim2.new(0, 10, 0, 0)
    iconLabel.Text = icon[type]
    iconLabel.TextSize = 24
    iconLabel.BackgroundTransparency = 1
    iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    local textLabel = Instance.new("TextLabel", notif)
    textLabel.Size = UDim2.new(1, -50, 1, 0)
    textLabel.Position = UDim2.new(0, 50, 0, 0)
    textLabel.Text = message
    textLabel.TextColor3 = Color3.fromRGB(240, 240, 255)
    textLabel.Font = Enum.Font.GothamMedium
    textLabel.TextSize = 14
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextWrapped = true
    textLabel.BackgroundTransparency = 1
    
    local closeBtn = Instance.new("TextButton", notif)
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 15)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.fromRGB(150, 150, 180)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 14
    closeBtn.BackgroundTransparency = 1
    closeBtn.ZIndex = 1001
    
    closeBtn.MouseButton1Click:Connect(function()
        self:Remove(notif)
    end)
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "HysagenNotifications"
    screenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    notif.Parent = screenGui
    
    -- Анимация входа
    TweenService:Create(notif, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, 10, 1, -70 - (#self.Notifications * 70))
    }):Play()
    
    -- Автоудаление
    if duration > 0 then
        task.delay(duration + 0.5, function()
            if notif.Parent then
                self:Remove(notif)
            end
        end)
    end
    
    table.insert(self.Notifications, notif)
    
    -- Обновление позиций
    self:UpdatePositions()
end

function NotificationSystem:Remove(notif)
    if not notif.Parent then return end
    
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        Position = UDim2.new(1, 10 + 400, 1, notif.Position.Y.Offset)
    }):Play()
    
    task.delay(0.3, function()
        notif:Destroy()
        for i, n in ipairs(self.Notifications) do
            if n == notif then
                table.remove(self.Notifications, i)
                break
            end
        end
        self:UpdatePositions()
    end)
end

function NotificationSystem:UpdatePositions()
    for i, notif in ipairs(self.Notifications) do
        if notif.Parent then
            TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, 10, 1, -70 - (i - 1) * 70)
            }):Play()
        end
    end
end

-- Глобальная функция уведомлений
function _G.Notify(message, type, duration)
    NotificationSystem:Create(message, type, duration)
end

-- ========== СИСТЕМА СОХРАНЕНИЯ ==========
local function loadData(file)
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(file))
    end
    )
    if success and result then return result end
    return nil
end

local function saveData(file, data)
    pcall(function()
        writefile(file, HttpService:JSONEncode(data))
    end)
end

-- ========== ОСНОВНАЯ UI СИСТЕМА ==========
local function MakeDraggable(gui)
    local dragging = false
    local dragStart, startPos
    local connections = {}
    
    local function update(input)
        if not dragging or not dragStart or not startPos then return end
        local delta = input.Position - dragStart
        gui.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
    
    connections[1] = gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not _G.IsDraggingSlider then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
        end
    end)
    
    connections[2] = gui.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    connections[3] = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging and not _G.IsDraggingSlider then
            update(input)
        end
    end)
    
    return connections
end

