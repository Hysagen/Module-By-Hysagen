            end
        end
    end

    local function SwitchTab(tabName)
        ClearLeftPanel()
        for _, t in ipairs(tabs) do
            if t.Name == tabName then
                currentTab = t
                -- Копируем элементы из tab в leftPanel
                for _, child in ipairs(t._elements) do
                    local clone = child:Clone()
                    clone.Parent = leftPanel
                end
                break
            end
        end
    end

