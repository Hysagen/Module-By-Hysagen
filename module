-- ============ Settings Storage ============
local defaultSettings = {
    Theme = "Dark",
    ToggleKey = "RightControl",
    SizeRatio = "3:4",
}

local function loadSettings()
    if _G.__UI_Settings then
        return _G.__UI_Settings
    else
        _G.__UI_Settings = table.clone(defaultSettings)
        return _G.__UI_Settings
    end
end

local function saveSettings(settings)
    _G.__UI_Settings = settings
end

-- ============ Utility ============
local function parseRatio(str)
    local parts = {}
    for part in str:gmatch("[^:]+") do
        table.insert(parts, tonumber(part))
    end
    if #parts == 2 then
        return parts[1] / parts[2]
    end
    return 3/4
end

local function getKeyEnum(keyName)
    if type(keyName) == "string" then
        local upper = keyName:upper()
        return Enum.KeyCode[upper] or Enum.KeyCode[upper:gsub(" ", "")]
    end
    return nil
end

-- ============ UIModule ============
function UIModule.new(config)
    config = config or {}
    local settings = loadSettings()
    if config.Settings then
        for k, v in pairs(config.Settings) do
            settings[k] = v
        end
        saveSettings(settings)
    end

    local self = setmetatable({}, UIModule)
    self.config = config
    self.settings = settings
    self.tabs = {}          -- name -> {elements = {}}
    self.tabButtons = {}    -- name -> TextButton
    self.tabPanels = {}     -- name -> ScrollingFrame
    self.elements = {}      -- name -> list of element objects
    self.currentTab = nil
    self.visible = true
    self.toggleConnection = nil
    self.theme = settings.Theme
    self.isMobile = UserInputService.TouchEnabled

    -- Create GUI
    self:createGUI()

    -- Add tabs from config
    if config.Tabs then
        for _, tabData in ipairs(config.Tabs) do
            self:addTab(tabData.Name, tabData.Elements)
        end
    end

    -- Add Settings tab if not exists
    if not self.tabs["Settings"] then
        self:addSettingsTab()
    end

    -- Select first tab
    local firstTab = next(self.tabs)
    if firstTab then
        self:selectTab(firstTab)
    end

    -- Setup toggle key
    self:setupToggleKey()

    -- Apply theme
    self:applyTheme(self.theme)

    -- Make sure it's visible
    self:setVisible(true)

    -- Cleanup on player leaving
    self.gui.AncestryChanged:Connect(function()
        if not self.gui.Parent then
            self:destroy()
        end
    end)

    return self
end

