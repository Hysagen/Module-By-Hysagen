        -- Добавляем методы для добавления элементов
        function tab:AddToggle(label, cfg)
            cfg = cfg or {}
            local default = cfg.Default or false
            local bind = cfg.Bind -- строка, например "F"
            local bindKey = bind and GetKeyCodeFromString(bind)

            -- Создаем фрейм для элемента
            local elem = Instance.new("Frame")
            elem.Size = UDim2.new(1, -10, 0, 40)
            elem.BackgroundColor3 = Themes[CurrentTheme].Frame
            elem.BackgroundTransparency = 0.3
            elem.BorderSizePixel = 0
