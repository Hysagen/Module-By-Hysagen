    -- === 3) ПОЛЗУНОК ===
    function UIFramework:CreateSlider(page, label, min, max, default)
        local container = createElementContainer(page)
        container.Size = UDim2.new(1, 0, 0, 54)
        
        local sliderFrame = Instance.new("Frame")
        sliderFrame.Size = UDim2.new(1, -16, 0, 46)
        sliderFrame.Position = UDim2.new(0, 8, 0, 4)
        sliderFrame.BackgroundColor3 = COLORS.TabInactive
        sliderFrame.BackgroundTransparency = 0
        sliderFrame.BorderSizePixel = 0
        sliderFrame.Parent = container
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = sliderFrame
        
        local labelText = Instance.new("TextLabel")
        labelText.Size = UDim2.new(0.5, 0, 0, 20)
        labelText.Position = UDim2.new(0, 8, 0, 2)
        labelText.BackgroundTransparency = 1
        labelText.Text = label
        labelText.TextColor3 = COLORS.Text
        labelText.TextSize = 13
        labelText.TextXAlignment = Enum.TextXAlignment.Left
        labelText.Font = Enum.Font.GothamSemibold
        labelText.Parent = sliderFrame
        
        local valueLabel = Instance.new("TextLabel")
        valueLabel.Size = UDim2.new(0.3, 0, 0, 20)
        valueLabel.Position = UDim2.new(0.7, 0, 0, 2)
        valueLabel.BackgroundTransparency = 1
        valueLabel.Text = tostring(default or min)
        valueLabel.TextColor3 = COLORS.Accent
        valueLabel.TextSize = 13
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.Font = Enum.Font.GothamBold
        valueLabel.Parent = sliderFrame
        
        -- Полоса
        local slider = Instance.new("Frame")
        slider.Size = UDim2.new(0.9, 0, 0, 4)
        slider.Position = UDim2.new(0.05, 0, 1, -10)
        slider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        slider.BackgroundTransparency = 0
        slider.BorderSizePixel = 0
        slider.Parent = sliderFrame
        
        local sliderCorner = Instance.new("UICorner")
        sliderCorner.CornerRadius = UDim.new(0, 2)
        sliderCorner.Parent = slider
        
        -- Заполнение
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0.5, 0, 1, 0)
        fill.BackgroundColor3 = COLORS.Accent
        fill.BackgroundTransparency = 0
        fill.BorderSizePixel = 0
        fill.Parent = slider
        
        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 2)
        fillCorner.Parent = fill
        
        -- Ручка
        local handle = Instance.new("Frame")
        handle.Size = UDim2.new(0, 16, 0, 16)
        handle.Position = UDim2.new(0.5, -8, 0.5, -8)
        handle.BackgroundColor3 = COLORS.Accent
        handle.BackgroundTransparency = 0
        handle.BorderSizePixel = 0
        handle.Parent = fill
        
        local handleCorner = Instance.new("UICorner")
        handleCorner.CornerRadius = UDim.new(1, 0)
        handleCorner.Parent = handle
        
        local handleBorder = Instance.new("Frame")
        handleBorder.Size = UDim2.new(1, 0, 1, 0)
        handleBorder.BackgroundColor3 = COLORS.Text
        handleBorder.BackgroundTransparency = 0
        handleBorder.BorderSizePixel = 0
        handleBorder.Parent = handle
        
        local handleBorderCorner = Instance.new("UICorner")
        handleBorderCorner.CornerRadius = UDim.new(1, 0)
        handleBorderCorner.Parent = handleBorder
        
        if type(default) == "table" then
            default = min
        end
        default = default or min
        
        local value = math.round(default)
        local function updateSlider(newValue)
            if type(newValue) == "table" then
                newValue = min
            end
            value = math.round(math.clamp(newValue, min, max))
            local percentage = (value - min) / (max - min)
            fill.Size = UDim2.new(percentage, 0, 1, 0)
            valueLabel.Text = tostring(value)
        end
        
        updateSlider(value)
        
        local dragging = false
        local function startDrag(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                local mousePos = input.Position.X
                local sliderPos = slider.AbsolutePosition.X
                local sliderWidth = slider.AbsoluteSize.X
                local percentage = math.clamp((mousePos - sliderPos) / sliderWidth, 0, 1)
                local newValue = min + (max - min) * percentage
                updateSlider(newValue)
            end
        end
        
        local function moveDrag(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local mousePos = input.Position.X
                local sliderPos = slider.AbsolutePosition.X
                local sliderWidth = slider.AbsoluteSize.X
                local percentage = math.clamp((mousePos - sliderPos) / sliderWidth, 0, 1)
                local newValue = min + (max - min) * percentage
                updateSlider(newValue)
            end
        end
        
        local function endDrag(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end
        
        slider.InputBegan:Connect(startDrag)
        slider.InputEnded:Connect(endDrag)
        handle.InputBegan:Connect(startDrag)
        handle.InputEnded:Connect(endDrag)
        handleBorder.InputBegan:Connect(startDrag)
        handleBorder.InputEnded:Connect(endDrag)
        
        local inputService = game:GetService("UserInputService")
        inputService.InputChanged:Connect(moveDrag)
        inputService.InputEnded:Connect(endDrag)
        
        task.wait(0.05)
        updatePagesCanvas()
        
        return {
            SetValue = updateSlider,
            GetValue = function() return value end
        }
    end
    
    -- === 4) КНОПКА-СПИСОК ===
    function UIFramework:CreateDropdown(page, label, options, defaultOption, multiSelect)
        multiSelect = multiSelect or false
        
        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, 0, 0, 44)
        container.BackgroundTransparency = 1
        container.Parent = page
        
        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, -16, 0, 36)
        mainBtn.Position = UDim2.new(0, 8, 0, 4)
        mainBtn.BackgroundColor3 = COLORS.TabInactive
        mainBtn.BackgroundTransparency = 0
        mainBtn.BorderSizePixel = 0
        mainBtn.Text = label .. ": " .. tostring(defaultOption or "Выберите...")
        mainBtn.TextColor3 = COLORS.Text
        mainBtn.TextSize = 13
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.Font = Enum.Font.GothamSemibold
        mainBtn.Parent = container
        mainBtn.ZIndex = 2
        
        local mainCorner = Instance.new("UICorner")
        mainCorner.CornerRadius = UDim.new(0, 4)
        mainCorner.Parent = mainBtn
        
        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 30, 0, 36)
        arrow.Position = UDim2.new(1, -36, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▼"
        arrow.TextColor3 = COLORS.TextDim
        arrow.TextSize = 14
        arrow.TextXAlignment = Enum.TextXAlignment.Center
        arrow.Font = Enum.Font.GothamBold
        arrow.Parent = mainBtn
        arrow.ZIndex = 2
        
        local listFrame = Instance.new("Frame")
        listFrame.Size = UDim2.new(1, -16, 0, 0)
        listFrame.Position = UDim2.new(0, 8, 0, 40)
        listFrame.BackgroundColor3 = COLORS.TabInactive
        listFrame.BackgroundTransparency = 0
        listFrame.BorderSizePixel = 0
        listFrame.Visible = false
        listFrame.Parent = container
        listFrame.ZIndex = 10
        listFrame.ClipsDescendants = true
        
        local listCorner = Instance.new("UICorner")
        listCorner.CornerRadius = UDim.new(0, 4)
        listCorner.Parent = listFrame
        
        local listShadow = Instance.new("Frame")
        listShadow.Size = UDim2.new(1, 0, 1, 0)
        listShadow.Position = UDim2.new(0, 4, 0, 4)
        listShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        listShadow.BackgroundTransparency = 0.5
        listShadow.BorderSizePixel = 0
        listShadow.ZIndex = 9
        listShadow.Parent = listFrame
        
        local listShadowCorner = Instance.new("UICorner")
        listShadowCorner.CornerRadius = UDim.new(0, 4)
        listShadowCorner.Parent = listShadow
        
        local listScrolling = Instance.new("ScrollingFrame")
        listScrolling.Size = UDim2.new(1, 0, 1, 0)
        listScrolling.BackgroundTransparency = 1
        listScrolling.BorderSizePixel = 0
        listScrolling.ScrollBarThickness = 4
        listScrolling.ScrollBarImageColor3 = COLORS.Accent
        listScrolling.CanvasSize = UDim2.new(0, 0, 0, 0)
        listScrolling.Parent = listFrame
        listScrolling.ZIndex = 10
        
        local listLayout = Instance.new("UIListLayout")
        listLayout.Padding = UDim.new(0, 2)
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Parent = listScrolling
        
        local selected = defaultOption
        local isOpen = false
        local buttons = {}
        
        local function updateMainText()
            if multiSelect then
                local count = 0
                if type(selected) == "table" then
                    for _, v in pairs(selected) do
                        if v then count = count + 1 end
                    end
                end
                mainBtn.Text = label .. ": " .. (count > 0 and ("Выбрано " .. count) or "Ничего не выбрано")
            else
                if type(selected) == "table" then
                    mainBtn.Text = label .. ": Выберите..."
                else
                    mainBtn.Text = label .. ": " .. tostring(selected or "Выберите...")
                end
            end
        end
        
        local function updateListSize()
            local count = 0
            for _ in pairs(buttons) do
                count = count + 1
            end
            local maxHeight = math.min(count * 30 + 4, 150)
            listScrolling.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 4)
            listFrame.Size = UDim2.new(1, -16, 0, maxHeight)
            container.Size = UDim2.new(1, 0, 0, 44 + (isOpen and maxHeight or 0))
            task.wait(0.05)
            updatePagesCanvas()
        end
        
        for _, option in ipairs(options) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -8, 0, 28)
            btn.Position = UDim2.new(0, 4, 0, 0)
            btn.BackgroundColor3 = COLORS.TabInactive
            btn.BackgroundTransparency = 0
            btn.BorderSizePixel = 0
            btn.Text = option
            btn.TextColor3 = COLORS.Text
            btn.TextSize = 13
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.GothamSemibold
            btn.Parent = listScrolling
            btn.ZIndex = 10
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 3)
            btnCorner.Parent = btn
            
            local check = Instance.new("TextLabel")
            check.Size = UDim2.new(0, 20, 1, 0)
            check.Position = UDim2.new(1, -24, 0, 0)
            check.BackgroundTransparency = 1
            check.Text = "✓"
            check.TextColor3 = COLORS.Accent
            check.TextSize = 14
            check.TextXAlignment = Enum.TextXAlignment.Center
            check.Font = Enum.Font.GothamBold
            check.Visible = false
            check.Parent = btn
            check.ZIndex = 10
            
            buttons[option] = {
                Button = btn,
                Check = check
            }
            
            btn.MouseButton1Click:Connect(function()
                if multiSelect then
                    if type(selected) ~= "table" then
                        selected = {}
                    end
                    selected[option] = not selected[option]
                    check.Visible = selected[option]
                    updateMainText()
                else
                    selected = option
                    for opt, data in pairs(buttons) do
                        data.Button.BackgroundColor3 = COLORS.TabInactive
                        data.Button.TextColor3 = COLORS.Text
                        data.Check.Visible = false
                    end
                    btn.BackgroundColor3 = COLORS.Accent
                    btn.TextColor3 = COLORS.Text
                    check.Visible = true
                    updateMainText()
                    isOpen = false
                    listFrame.Visible = false
                    arrow.Text = "▼"
                    updateListSize()
                end
            end)
        end
        
        if not multiSelect then
            for opt, data in pairs(buttons) do
                if opt == defaultOption then
                    data.Button.BackgroundColor3 = COLORS.Accent
                    data.Button.TextColor3 = COLORS.Text
                    data.Check.Visible = true
                end
            end
        elseif type(defaultOption) == "table" then
            for opt, data in pairs(buttons) do
                if defaultOption[opt] then
                    data.Check.Visible = true
                end
            end
        end
        
        mainBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            listFrame.Visible = isOpen
            arrow.Text = isOpen and "▲" or "▼"
            updateListSize()
        end)
        
        updateMainText()
        updateListSize()
        task.wait(0.05)
        updatePagesCanvas()
        
        return {
            GetSelected = function()
                if multiSelect then
                    local result = {}
                    if type(selected) == "table" then
                        for opt, val in pairs(selected) do
                            if val then table.insert(result, opt) end
                        end
                    end
                    return result
                else
                    return selected
                end
            end,
            SetSelected = function(newValue)
                if multiSelect then
                    selected = {}
                    if type(newValue) == "table" then
                        for _, opt in ipairs(newValue) do
                            selected[opt] = true
                        end
                    end
                    for opt, data in pairs(buttons) do
                        data.Check.Visible = selected[opt] or false
                    end
                    updateMainText()
                else
                    if type(newValue) == "table" then
                        newValue = nil
                    end
                    selected = newValue
                    for opt, data in pairs(buttons) do
                        data.Button.BackgroundColor3 = COLORS.TabInactive
                        data.Button.TextColor3 = COLORS.Text
                        data.Check.Visible = false
                    end
                    if buttons[newValue] then
                        buttons[newValue].Button.BackgroundColor3 = COLORS.Accent
                        buttons[newValue].Button.TextColor3 = COLORS.Text
                        buttons[newValue].Check.Visible = true
                    end
                    updateMainText()
                end
            end
        }
    end
    
    -- === СТРАНИЦЫ ===
    function UIFramework:CreatePage(name)
        local pageFrame = Instance.new("Frame")
        pageFrame.Name = "PageFrame"
        pageFrame.Size = UDim2.new(1, 0, 0, 0)
        pageFrame.BackgroundTransparency = 1
        pageFrame.Visible = false
        pageFrame.Parent = currentScale.tabsLeft and pagesContainer or bottomContainer
        
        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 4)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = pageFrame
        
        local function updatePageSize()
            local totalHeight = 16
            for _, child in ipairs(pageFrame:GetChildren()) do
                if child:IsA("Frame") then
                    totalHeight = totalHeight + child.Size.Y.Offset + 4
                end
            end
            pageFrame.Size = UDim2.new(1, 0, 0, totalHeight)
            updatePagesCanvas()
        end
        
        pageFrame.ChildAdded:Connect(function()
            task.wait(0.05)
            updatePageSize()
        end)
        
        -- Кнопка вкладки
        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = name .. "Tab"
        tabBtn.Size = UDim2.new(0, 140, 0, 36)
        tabBtn.BackgroundColor3 = COLORS.TabInactive
        tabBtn.BackgroundTransparency = 0
        tabBtn.BorderSizePixel = 0
        tabBtn.Text = name
        tabBtn.TextColor3 = COLORS.TextDim
        tabBtn.TextSize = 14
        tabBtn.TextXAlignment = Enum.TextXAlignment.Center
        tabBtn.TextYAlignment = Enum.TextYAlignment.Center
        tabBtn.TextTruncate = Enum.TextTruncate.AtEnd
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.Parent = currentScale.tabsLeft and leftScrolling or topTabsScrolling
        
        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 4)
        tabCorner.Parent = tabBtn
        
        -- Обновляем CanvasSize
        if currentScale.tabsLeft then
            leftScrolling.CanvasSize = UDim2.new(0, 0, 0, leftScrolling.CanvasSize.Y.Offset + 40)
        else
            topTabsScrolling.CanvasSize = UDim2.new(0, 0, 0, topTabsScrolling.CanvasSize.Y.Offset + 40)
        end
        
        tabBtn.MouseButton1Click:Connect(function()
            UIFramework:SwitchPage(name)
        end)
        
        pages[name] = {
            Frame = pageFrame,
            Button = tabBtn,
            Layout = pageLayout,
            UpdateSize = updatePageSize
        }
        
        if not activePage then
            activePage = name
            pageFrame.Visible = true
            tabBtn.BackgroundColor3 = COLORS.TabActive
            tabBtn.TextColor3 = COLORS.Text
        end
        
        task.wait(0.1)
        updatePageSize()
        
        return pageFrame, pageLayout
    end
    
    function UIFramework:SwitchPage(name)
        if not pages[name] then return end
        
        for _, data in pairs(pages) do
            if data and data.Frame then
                data.Frame.Visible = false
            end
            if data and data.Button then
                data.Button.BackgroundColor3 = COLORS.TabInactive
                data.Button.TextColor3 = COLORS.TextDim
            end
        end
        
        if pages[name] and pages[name].Frame then
            pages[name].Frame.Visible = true
        end
        if pages[name] and pages[name].Button then
            pages[name].Button.BackgroundColor3 = COLORS.TabActive
            pages[name].Button.TextColor3 = COLORS.Text
        end
        activePage = name
        
        task.wait(0.05)
        if pages[name] and pages[name].UpdateSize then
            pages[name]:UpdateSize()
        end
        updatePagesCanvas()
    end
    
    -- === НАСТРОЙКИ ===
    local settingsPage, settingsLayout = UIFramework:CreatePage("Настройки")
    
    -- Выбор масштаба
    local scaleDropdown = UIFramework:CreateDropdown(settingsPage, "Масштаб", {"3:4", "1:1", "1:2"}, currentScale.name, false)
    
    -- Функция смены масштаба
    local function changeScale(newScaleName)
        if newScaleName == currentScale.name then return end
        
        -- Находим новый масштаб
        local newScale = nil
        for _, s in ipairs(SCALES) do
            if s.name == newScaleName then
                newScale = s
                break
            end
        end
        if not newScale then return end
        
        -- Меняем текущий масштаб
        currentScale = newScale
        
        -- Меняем размер окна
        mainFrame.Size = UDim2.new(0, newScale.width, 0, newScale.height)
        mainFrame.Position = UDim2.new(0.5, -newScale.width/2, 0.5, -newScale.height/2)
        
        -- Перестраиваем интерфейс
        buildInterface()
        
        -- Пересоздаём страницу настроек с новыми значениями
        -- Просто обновляем дропдаун
        for _, data in pairs(pages) do
            if data and data.Frame and data.Frame.Parent then
                -- Обновляем все страницы
            end
        end
        
        -- Сохраняем
        saveSettings({scale = newScaleName, toggleKey = toggleKey})
    end
    
    -- Отслеживаем изменение масштаба
    local oldSetSelected = scaleDropdown.SetSelected
    scaleDropdown.SetSelected = function(self, newValue)
        oldSetSelected(self, newValue)
        local newScale = scaleDropdown:GetSelected()
        if newScale ~= currentScale.name then
            changeScale(newScale)
        end
    end
    
    -- Клавиша для открытия/закрытия
    local keyOptions = {"RightControl", "LeftControl", "RightShift", "LeftShift", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"}
    local keyDropdown = UIFramework:CreateDropdown(settingsPage, "Клавиша открытия", keyOptions, toggleKey, false)
    
    local oldKeySetSelected = keyDropdown.SetSelected
    keyDropdown.SetSelected = function(self, newValue)
        oldKeySetSelected(self, newValue)
        local newKey = keyDropdown:GetSelected()
        if newKey and newKey ~= toggleKey then
            toggleKey = newKey
            saveSettings({scale = currentScale.name, toggleKey = toggleKey})
        end
    end
    
    -- Бинд на клавишу для открытия/закрытия
    local function onToggleKey(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode[toggleKey] then
            mainFrame.Visible = not mainFrame.Visible
        end
    end
    
    game:GetService("UserInputService").InputBegan:Connect(onToggleKey)
    
    -- Перетаскивание
    local dragging = false
    local dragStart, startPos
    
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    
    topBar.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    topBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    uiRef = {
        MainFrame = mainFrame,
        TopBar = topBar,
        Container = container,
        CreatePage = UIFramework.CreatePage,
        SwitchPage = UIFramework.SwitchPage,
        Pages = pages,
        ScreenGui = screenGui,
        CreateToggleWithBind = UIFramework.CreateToggleWithBind,
        CreateToggle = UIFramework.CreateToggle,
        CreateSlider = UIFramework.CreateSlider,
        CreateDropdown = UIFramework.CreateDropdown,
        UpdatePagesCanvas = updatePagesCanvas,
        GetScale = function()
            return currentScale.name
        end,
        GetScales = function()
            return SCALES
        end,
        GetToggleKey = function()
            return toggleKey
        end,
        SetToggleKey = function(newKey)
            toggleKey = newKey
            saveSettings({scale = currentScale.name, toggleKey = toggleKey})
        end
    }
    
    return uiRef
end

function UIFramework.New(title)
    return createMainFrame(title or "UI Framework")
end

return UIFramework
